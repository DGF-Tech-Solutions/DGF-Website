---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import ContactForm from "@/components/ContactForm.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";
import { SERVICES } from "@/data/services";
import illustration from "@/assets/illustrazioni/scena-contatti.png";

const SERVICE_ICONS = ["globe", "bag", "phone", "dashboard", "sparkles"] as const;

const STEPS = [
  "Leggiamo la richiesta e ti rispondiamo entro un giorno lavorativo.",
  "Se serve, facciamo una chiamata di venti minuti per chiarire il contesto.",
  "Ti mandiamo una proposta scritta con ambito, tempi e costo. Senza impegno.",
];

const schema = {
  "@type": "ContactPage",
  name: `Contatti — ${SITE.name}`,
  url: `${SITE.url}/contatti`,
  mainEntity: { "@id": `${SITE.url}/#organization` },
};
---

<Base
  title="Contatti"
  description="Scrivi a DGF Tech Solutions: raccontaci il progetto e ti rispondiamo entro un giorno lavorativo, con una stima chiara e senza impegno."
  canonical="/contatti"
  schema={schema}
>
  <PageHeader
    eyebrow="Contatti"
    title='Raccontaci <span class="t-dim">cosa ti serve.</span>'
    lead="Non serve un capitolato: bastano l'obiettivo e qualche vincolo. Rispondiamo entro un giorno lavorativo."
    crumbs={[{ label: "Contatti" }]}
    illustration={illustration}
    illustrationAlt="Illustrazione: assistenza e contatto"
  />

  <section class="section">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
        <!-- Form -->
        <div class="card p-6 sm:p-8">
          <ContactForm />
        </div>

        <!-- Contatti diretti e aspettative -->
        <aside class="space-y-5">
          <div class="card p-6">
            <span class="icon-tile"><Icon name="mail" size={20} /></span>
            <h2 class="t-h3 mt-4">Scrivici direttamente</h2>
            <a href={`mailto:${SITE.email}`} class="link-arrow mt-3 !text-[0.875rem] break-all">
              {SITE.email}
            </a>
          </div>

          <div class="card p-6">
            <span class="icon-tile"><Icon name="pin" size={20} /></span>
            <h2 class="t-h3 mt-4">Dove siamo</h2>
            <address class="t-body mt-3 not-italic text-[0.875rem]">
              {SITE.city} ({SITE.region}), {SITE.countryName}<br />
              Lavoriamo con clienti in tutta Italia, da remoto.
            </address>
          </div>

          <div class="card bg-[var(--color-soft)] p-6">
            <h2 class="t-h3">Cosa succede dopo</h2>
            <ol class="mt-4 space-y-4">
              {
                STEPS.map((s, i) => (
                  <li class="flex gap-3">
                    <span class="icon-tile icon-tile-sm bg-white !text-[0.8125rem] font-bold">
                      {i + 1}
                    </span>
                    <span class="t-body pt-1 text-[0.875rem]">{s}</span>
                  </li>
                ))
              }
            </ol>
          </div>

          <p class="t-small">
            Trattiamo i tuoi dati solo per rispondere a questa richiesta. Nessuna
            newsletter, nessuna cessione a terzi. Dettagli nella
            <a href="/privacy" class="font-semibold text-[var(--color-navy)] underline underline-offset-2">
              privacy policy</a>.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Rimando ai servizi -->
  <section class="band-soft section-sm">
    <div class="wrap">
      <h2 class="t-eyebrow text-center">Non sai da dove partire?</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {
          SERVICES.map((s, i) => (
            <a href={`/servizi/${s.slug}`} class="card group flex items-center gap-3 p-4">
              <span class="icon-tile icon-tile-sm">
                <Icon name={SERVICE_ICONS[i]} size={17} />
              </span>
              <span class="text-[0.875rem] font-semibold text-[var(--color-ink)]">
                {s.title}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

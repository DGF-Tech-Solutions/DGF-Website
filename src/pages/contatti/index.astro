---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import ContactForm from "@/components/ContactForm.astro";
import { SITE } from "@/data/site";
import { SERVICES } from "@/data/services";

const schema = {
  "@type": "ContactPage",
  name: `Contatti — ${SITE.name}`,
  url: `${SITE.url}/contatti`,
  mainEntity: { "@id": `${SITE.url}/#organization` },
};
---

<Base
  title="Contatti"
  description="Scrivi a DGF Tech Solutions: raccontaci il progetto e ti rispondiamo entro un giorno lavorativo, con una stima chiara e senza impegno."
  canonical="/contatti"
  schema={schema}
>
  <PageHeader
    index="005"
    label="Contatti"
    title="Raccontaci cosa ti serve"
    lead="Non serve un capitolato: bastano l'obiettivo e qualche vincolo. Rispondiamo entro un giorno lavorativo."
    crumbs={[{ label: "Contatti" }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Form -->
        <div class="lg:col-span-7">
          <div class="flex items-baseline gap-3 pb-6">
            <span class="t-index">A</span>
            <span class="t-label">Modulo</span>
          </div>
          <ContactForm />
        </div>

        <!-- Contatti diretti e aspettative -->
        <aside class="lg:col-span-5">
          <div class="flex items-baseline gap-3 pb-6">
            <span class="t-index">B</span>
            <span class="t-label">In alternativa</span>
          </div>

          <div class="surface p-7">
            <h2 class="t-h3">Scrivici direttamente</h2>
            <a
              href={`mailto:${SITE.email}`}
              class="link-underline mt-3 inline-block break-all"
            >
              {SITE.email}
            </a>

            <hr class="rule my-7" />

            <h2 class="t-h3">Dove siamo</h2>
            <address class="t-body mt-3 not-italic">
              {SITE.city} ({SITE.region}), {SITE.countryName}<br />
              <span class="t-small">Lavoriamo con clienti in tutta Italia, da remoto.</span>
            </address>

            <hr class="rule my-7" />

            <h2 class="t-h3">Cosa succede dopo</h2>
            <ol class="mt-4 space-y-4">
              <li class="flex gap-4">
                <span class="t-index shrink-0 pt-1">001</span>
                <span class="t-body text-[0.9375rem]">
                  Leggiamo la richiesta e ti rispondiamo entro un giorno lavorativo.
                </span>
              </li>
              <li class="flex gap-4">
                <span class="t-index shrink-0 pt-1">002</span>
                <span class="t-body text-[0.9375rem]">
                  Se serve, facciamo una chiamata di venti minuti per chiarire il
                  contesto.
                </span>
              </li>
              <li class="flex gap-4">
                <span class="t-index shrink-0 pt-1">003</span>
                <span class="t-body text-[0.9375rem]">
                  Ti mandiamo una proposta scritta con ambito, tempi e costo. Senza
                  impegno.
                </span>
              </li>
            </ol>
          </div>

          <p class="t-small mt-6">
            Trattiamo i tuoi dati solo per rispondere a questa richiesta. Nessuna
            newsletter, nessuna cessione a terzi. Dettagli nella
            <a href="/privacy" class="link-underline">privacy policy</a>.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Rimando ai servizi -->
  <section class="section-sm border-t border-[var(--color-hairline)] bg-[var(--color-paper-2)]">
    <div class="wrap">
      <h2 class="t-label">Non sai da dove partire?</h2>
      <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
        {
          SERVICES.map((s) => (
            <li>
              <a href={`/servizi/${s.slug}`} class="link-underline text-[0.9375rem]">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

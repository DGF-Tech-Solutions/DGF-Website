---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import EmailLink from "@/components/EmailLink.astro";

/*
 * Pagina di conferma. La raggiunge solo chi invia il modulo SENZA JavaScript
 * (Web3Forms reindirizza qui). Con JS attivo la conferma appare in linea e
 * questa pagina non si vede mai — ma deve esistere, altrimenti chi ha JS
 * disattivato finirebbe su una pagina di Web3Forms.
 */
---

<Base
  title="Richiesta inviata"
  description="La tua richiesta è stata inviata a DGF Tech Solutions."
  canonical="/contatti/inviato"
  noindex
>
  <section class="glow-bg under-nav section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="icon-tile mx-auto !h-14 !w-14 !bg-[var(--color-navy)] !text-white">
          <Icon name="check" size={26} />
        </span>

        <h1 class="t-h1 mt-6">
          Richiesta <span class="t-dim">inviata.</span>
        </h1>

        <p class="t-lead mt-5">
          Grazie: l'abbiamo ricevuta. Ti rispondiamo entro un giorno lavorativo
          all'indirizzo che ci hai lasciato. Se non vedi nulla, controlla anche la
          cartella spam.
        </p>

        <p class="t-body mt-5">
          Nel frattempo, se vuoi aggiungere qualcosa puoi scriverci direttamente a
          <EmailLink class="font-semibold text-[var(--color-navy)] underline underline-offset-2" />.
        </p>

        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn btn-primary btn-lg">
            Torna alla home
            <Icon name="arrow-right" size={17} />
          </a>
          <a href="/portfolio" class="btn btn-ghost btn-lg">Guarda i progetti</a>
        </div>
      </div>
    </div>
  </section>
</Base>

---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import ServiziSchede from "@/components/ServiziSchede.astro";
import Globe from "@/components/Globe.astro";
import VideoLoop from "@/components/VideoLoop.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Consulenza from "@/components/Consulenza.astro";
import { SITE } from "@/data/site";
import { SERVICES } from "@/data/services";
import AiCredit from "@/components/AiCredit.astro";
import fase1 from "@/assets/foto/fase-1-ascolto.webp";
import fase2 from "@/assets/foto/fase-2-proposta.webp";
import fase3 from "@/assets/foto/fase-3-costruzione.webp";
import fase4 from "@/assets/foto/fase-4-consegna.webp";

const articles = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

/*
 * Dati strutturati della home.
 *
 * Era l'UNICA rotta indicizzabile senza: emetteva solo il grafo globale
 * Organization + WebSite di Base.astro, quindi la pagina più importante del
 * sito era anche l'unica a non dire ai motori che cosa contiene.
 *
 * `WebPage` dichiara la pagina, `ItemList` i cinque servizi che mostra — la
 * stessa lista che /servizi già pubblica, costruita dalla stessa sorgente
 * (`SERVICES`) perché non possano scostarsi.
 */
const schema = [
  {
    "@type": "WebPage",
    "@id": `${SITE.url}/#webpage`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: SITE.description,
    inLanguage: "it-IT",
    isPartOf: { "@id": `${SITE.url}/#website` },
    about: { "@id": `${SITE.url}/#organization` },
  },
  {
    "@type": "ItemList",
    name: "Servizi di DGF Tech Solutions",
    itemListElement: SERVICES.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.title,
      description: s.summary,
      url: `${SITE.url}/servizi/${s.slug}`,
    })),
  },
];

/*
 * Cos'è un SaaS, in tre righe.
 *
 * La sigla la usiamo noi tutti i giorni, ma il visitatore tipo di questo sito
 * non la conosce: senza una spiegazione il video qui sotto mostra delle
 * schermate e basta, e nessuno capisce che cosa sta guardando né perché
 * dovrebbe volerne uno.
 */
const SAAS = [
  {
    title: "Vive sul web",
    text: "Si apre dal browser, senza installare niente. Lo stesso account funziona dall'ufficio, da casa e dal telefono.",
  },
  {
    title: "Si aggiorna da solo",
    text: "Le correzioni e le funzioni nuove arrivano a tutti insieme. Nessuno resta indietro con una versione di tre anni fa.",
  },
  {
    title: "Si paga a canone",
    text: "Nessuna licenza da comprare in blocco all'inizio. Il costo segue l'uso, e si può smettere quando serve.",
  },
] as const;

/** Le tre frasi sotto le CTA: rassicurano prima ancora che si scorra. */
const TRUST = [
  "Preventivo scritto prima di iniziare",
  "Codice e dominio restano tuoi",
  "Parli sempre con chi sviluppa",
];

const PHASES = [
  {
    icon: "message",
    title: "Ascolto",
    text: "Capiamo il problema prima di parlare di soluzioni. Spesso quello che serve è diverso da quello che si era immaginato, e dirlo è parte del lavoro.",
    photo: fase1,
    photoAlt: "Due persone sedute a un tavolo davanti a una grande vetrata, in conversazione",
  },
  {
    icon: "file",
    title: "Proposta",
    text: "Ambito, tempi e costo messi per iscritto prima di iniziare. Nessuna voce a sorpresa a metà progetto.",
    photo: fase2,
    photoAlt: "Un taccuino aperto con schemi di interfaccia disegnati a matita, accanto una tazza di caffè",
  },
  {
    icon: "wrench",
    title: "Costruzione",
    text: "Ti mostriamo il lavoro mentre procede, non alla fine. Se qualcosa non convince si corregge quando costa poco.",
    photo: fase3,
    photoAlt: "Due persone al lavoro davanti allo stesso monitor",
  },
  {
    icon: "package",
    title: "Consegna",
    text: "Il progetto è tuo: codice, dominio, accessi. Ti spieghiamo come funziona e restiamo raggiungibili.",
    photo: fase4,
    photoAlt: "Una stretta di mano sopra un tavolo, accanto un portatile e dei documenti",
  },
] as const;

---

<Base
  title={SITE.name}
  description={SITE.description}
  canonical="/"
  schema={schema}
>
  <!-- ══════════════════════════════════════════════════════════════════
       HERO
       Il titolo è l'elemento LCP: si anima solo in `transform`, mai in
       opacità, altrimenti la metrica slitterebbe di tutta l'animazione.

       A destra il pianeta: è SVG dentro l'HTML e sta dopo il titolo nel
       documento, quindi non c'è nessuna immagine da scaricare sopra la piega
       e l'LCP resta il titolo.
       ══════════════════════════════════════════════════════════════════ -->
  <section class="hero glow-bg under-nav">
    <div class="wrap">
      <div class="hero-griglia grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
        <div class="hero-testo">
          <span class="chip anim-fade-rise">
            <Icon name="pin" size={13} />
            Software house · {SITE.city}, {SITE.countryName}
          </span>

          <h1 class="t-display mt-6 anim-rise">
            Dall'idea al lancio, parli sempre con <span class="t-dim">chi scrive il codice.</span>
          </h1>

          <p class="t-lead mt-6 max-w-xl anim-fade-rise delay-2">
            Siti, e-commerce, app e software su misura per aziende italiane.
            Costruiamo il progetto, te lo consegniamo per intero, e restiamo
            raggiungibili dopo il lancio.
          </p>

          <div class="mt-8 flex flex-wrap gap-3 anim-fade-rise delay-3">
            <a href="/contatti" class="btn btn-primary btn-lg">
              Parliamo del tuo progetto
              <Icon name="arrow-right" size={17} />
            </a>
            <a href="/portfolio" class="btn btn-ghost btn-lg">Guarda i progetti</a>
          </div>

          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 anim-fade-rise delay-4">
            {
              TRUST.map((t) => (
                <li class="flex items-center gap-2 text-[0.8125rem] font-medium text-[var(--color-ink-3)]">
                  <Icon name="check" size={15} class="text-[var(--color-navy)]" />
                  {t}
                </li>
              ))
            }
          </ul>
        </div>

        <!--
          Il pianeta, con i cartellini che gli galleggiano davanti.
          La colonna serve solo da ancoraggio: la sfera è larga il doppio ed
          esce dal bordo destro della pagina (vedi `.hero-globo-sfera`), così
          si legge come un pianeta inquadrato di taglio e non come un'icona.
        -->
        {/* `anim-rise` (solo transform) e non una dissolvenza: sopra la piega
            un'opacità che riparte lascia il vuoto al posto della figura. */}
        <div class="hero-globo anim-rise">
          {/* Il globo sta in un contenitore invece di ricevere una classe:
              una classe passata a un componente non porta con sé lo scope CSS
              di questa pagina, e la regola non lo aggancerebbe. L'alone sta
              dentro allo stesso contenitore, così segue la sfera a ogni
              dimensione senza ripetere le regole di posizione. */}
          <div class="hero-globo-sfera">
            <div class="globe-halo" aria-hidden="true"></div>
            <Globe />
          </div>

          <!--
            Tre didascalie appoggiate sul globo.

            Prima erano tre schede bianche: rettangoli opachi incollati sopra
            al pianeta, che coprivano i continenti e sembravano appartenere a
            un'altra pagina. Ora parlano la stessa lingua della mappa — un
            puntino sul posto, un filo, la scritta — come l'etichetta di
            Messina. Niente riquadro da attraversare con lo sguardo.

            Stanno sul terzo sinistro del disco, dove la mappa è già sfumata.
          -->
          <ul class="hero-note">
            <li class="hero-note-1 float">
              <span class="hero-note-punto" aria-hidden="true"></span>
              <span>
                <span class="hero-note-titolo">Siti istantanei</span>
                <span class="hero-note-riga">Ottimizzati fino all'ultimo kB</span>
              </span>
            </li>

            <li class="hero-note-2 float-slow">
              <span class="hero-note-punto" aria-hidden="true"></span>
              <span>
                <span class="hero-note-titolo">Il codice è tuo</span>
                <span class="hero-note-riga">Sorgenti, dominio e accessi</span>
              </span>
            </li>

            <li class="hero-note-3 float-fast">
              <span class="hero-note-punto" aria-hidden="true"></span>
              <span>
                <span class="hero-note-titolo">Risposta in 1 giorno</span>
                <span class="hero-note-riga">Lavorativo, e risponde una persona</span>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       SERVIZI + NEXIA — parallasse a scorrimento

       I servizi restano fermi e Nexia ci scivola sopra, come un pannello che
       sale a coprire lo sfondo. Il riferimento classico lo fa con `position:
       fixed` sullo sfondo e un po' di JavaScript per spostarlo a ogni evento
       di scorrimento; qui basta `position: sticky` sul primo dei due, che
       ottiene la stessa cosa senza una riga di script e senza far ricalcolare
       niente al browser a ogni fotogramma.

       I due elementi devono stare nello STESSO contenitore: `sticky` si
       muove solo dentro il proprio genitore, e senza questo involucro i
       servizi resterebbero incollati per tutto il resto della pagina.
       ══════════════════════════════════════════════════════════════════ -->
  <div class="pila-parallasse">
  <section class="section band-soft servizi-fondo">
    {/*
      Il contenuto arretra mentre la sezione esce dallo schermo: rimpicciolisce
      di poco e si spegne, così il foglio bianco di Nexia sembra passargli
      SOPRA invece di seguirlo in fila.

      L'animazione sta sul contenuto e non sulla sezione, ed è una differenza
      che si vede: rimpicciolendo la sezione si rimpicciolirebbe anche la sua
      fascia grigia, scoprendo due strisce bianche ai lati.
    */}
    <div class="wrap servizi-uscita">
      <!-- Testata su due colonne invece che centrata: dà alla sezione un asse
           verticale a sinistra, lo stesso del resto della pagina, e lascia al
           blocco sotto tutta la larghezza. Una testata centrata sopra una
           griglia larga fa sembrare le due cose scollegate. -->
      <div class="servizi-testata">
        <div>
          <span class="t-eyebrow">I servizi</span>
          <h2 class="t-h2 mt-3">
            Cinque cose, <span class="t-dim">fatte bene.</span>
          </h2>
        </div>
        <p class="t-lead">
          Costruiamo software su misura, qualunque sia il problema da
          risolvere. Questi cinque sono quelli che ci chiedono più spesso: se
          il tuo caso non è nell'elenco, raccontacelo lo stesso.
        </p>
      </div>

      <ServiziSchede />
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       IL PRODOTTO IN MOVIMENTO
       Registrazione vera di Nexia Home, non un video d'archivio.
       ══════════════════════════════════════════════════════════════════ -->
  <VideoLoop
    eyebrow="In produzione, adesso"
    title='Il software che vedi <span class="t-dim">sta girando davvero.</span>'
    lead="Nexia Home importa una fattura elettronica e la associa da sola al fornitore giusto. L'abbiamo progettata, scritta e messa online noi, e la manteniamo tutti i giorni."
    caption="Schermo registrato dall'applicazione in funzione. Nessun montaggio, nessuna accelerazione."
    href="/portfolio/nexia-home"
    hrefLabel="Come l'abbiamo costruita"
    pointsTitle="Il nostro più grande prodotto interno"
    points={SAAS}
  />
  </div>

  <!-- ══════════════════════════════════════════════════════════════════
       COME LAVORIAMO
       ══════════════════════════════════════════════════════════════════ -->
  {/* Bianco, non più grigio: dopo la fascia blu la pagina "riparte" dal
      bianco, come dopo la CTA. L'onda dei fondi della home è
      bianco → azzurro → blu, ripetuta due volte: ogni blu è preparato
      dall'azzurro e seguito dal bianco. */}
  <section class="metodo section">
    {/* Due aloni che scorrono più lenti della pagina: danno profondità al
        fondo senza una sola immagine da scaricare. */}
    <span class="metodo-alone metodo-alone-1 parallax-slow" aria-hidden="true"></span>
    <span class="metodo-alone metodo-alone-2 parallax-fast" aria-hidden="true"></span>

    <div class="wrap">
      <div class="metodo-intro">
        <span class="t-eyebrow">Il metodo</span>
        <h2 class="t-h2 mt-3">
          Quattro passaggi, <span class="t-dim">nessuna sorpresa.</span>
        </h2>
        <p class="t-lead mt-4">
          Lo stesso percorso su ogni progetto, dal sito vetrina al gestionale.
          Sapere cosa succede dopo è metà della tranquillità.
        </p>
      </div>

      <!--
        I quattro passaggi si sostituiscono mentre si scorre: ogni pannello si
        aggancia sotto la barra e il successivo gli sale sopra, lasciando
        vedere il bordo di quelli già passati. È un effetto di sola
        impaginazione — `position: sticky` e quattro `top` diversi — quindi
        nessuno script, nessun calcolo a ogni fotogramma.
      -->
      <ol class="metodo-pila">
        {
          PHASES.map((p, i) => (
            <li class="passo" style={`--i:${i}`}>
              <div class="passo-corpo">
                <div class="passo-testo">
                  <span class="passo-testa">
                    <span class="icon-tile"><Icon name={p.icon} size={20} /></span>
                    <span class="passo-num tabular">{`Fase 0${i + 1} di 04`}</span>
                  </span>
                  <h3 class="passo-titolo">{p.title}</h3>
                  <p class="passo-riga">{p.text}</p>
                </div>

                {/* Una foto per fase, dentro un riquadro con lo stesso raggio
                    della scheda. Sono inquadrature strette — mani e un oggetto
                    solo — perché a 320 px una stanza intera diventa poltiglia.
                    I quattro gesti (scrivere, sfogliare, digitare, passare)
                    raccontano il percorso anche senza leggere i titoli. */}
                <figure class="passo-scena">
                  <Image
                    src={p.photo}
                    alt={p.photoAlt}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 320px, 40vw"
                    loading="lazy"
                  />
                </figure>

                <span class="passo-tacche" aria-hidden="true">
                  {PHASES.map((_, k) => (
                    <i class:list={[k <= i && "acceso"]} />
                  ))}
                </span>
              </div>
            </li>
          ))
        }
      </ol>

      {/* Una dichiarazione per la sezione e non quattro sotto ogni scheda:
          le foto si vedono qui, la riga sta qui, e il lettore non se la
          ritrova ripetuta a ogni pannello. */}
      <AiCredit
        label="Le fotografie di questa sezione sono generate con IA."
        class="metodo-credito"
      />
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       DAL BLOG
       ══════════════════════════════════════════════════════════════════ -->
  {
    articles.length > 0 && (
      <section class="band-soft section">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
              <span class="t-eyebrow">Dal blog</span>
              <h2 class="t-h2 mt-3">
                Quello che spieghiamo <span class="t-dim">ai clienti.</span>
              </h2>
            </div>
            <a href="/blog" class="link-arrow shrink-0 pb-1">
              Tutti gli articoli
              <Icon name="arrow-right" size={16} />
            </a>
          </div>

          <div class="mt-10 grid gap-5 sm:grid-cols-2">
            {articles.map((entry) => (
              <ArticleCard entry={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ══════════════════════════════════════════════════════════════════
       CONSULENZA — chiude la home al posto della fascia di chiusura

       QUI NON C'È `CtaBand`, ed è voluto. È l'unica pagina del sito senza.

       Le due chiedevano la stessa cosa a seicento pixel di distanza:
       «Parliamo del tuo progetto» compariva tre volte in pagina, due delle
       quali di fila. Ne resta una, e con un campo da compilare invece di due
       bottoni — che è una chiusura più forte, perché la conversazione
       comincia qui invece di rimandare.

       La consulenza ha quindi ereditato il fondo blu del marchio e la
       discesa nel navy del footer, che erano compiti di `CtaBand`. Quella
       resta su tutte le altre pagine.

       Effetto sull'onda dei fondi: bianco → azzurro → blu, due volte piene.
       Con la consulenza bianca in mezzo la seconda si spezzava.
       ══════════════════════════════════════════════════════════════════ -->
  <Consulenza />
</Base>

<style>
  /*
   * Uscita di scena dei servizi. Il movimento è tutto nell'ultimo tratto,
   * quando la sezione sta già lasciando lo schermo: mentre la si legge non
   * succede niente, ed è la condizione perché un effetto del genere non
   * dia fastidio.
   */
  /*
   * Il parallasse a scorrimento.
   *
   * `bottom: 0` e non `top`: la sezione dei servizi è più alta di uno
   * schermo, e agganciandola in ALTO se ne vedrebbe solo la testa mentre il
   * resto sparisce fuori. Agganciata in BASSO resta ferma con il piede
   * appoggiato al bordo della finestra, e Nexia le sale davanti coprendola —
   * che è esattamente il movimento del riferimento.
   *
   * Lo `z-index` esplicito serve: senza, i due elementi si impilano
   * nell'ordine del documento e il pannello che sale finirebbe dietro.
   */
  /* Lo stesso azzurro della sezione servizi: è il gradino che prepara il
     blu della CTA subito sotto, come i servizi preparano la fascia Nexia.
     Prima era il grigio di `band-soft`, fuori dalla famiglia azzurra, e
     per giunta uguale alla sezione precedente. */
  /* Fondo e riga di confine arrivano da `.band-soft` (global.css), la stessa
     dei servizi: erano due copie dello stesso colore scritte a mano, e una
     delle due aveva già cominciato a scostarsi. */

  .pila-parallasse { position: relative; }
  .pila-parallasse > .servizi-fondo {
    position: sticky;
    bottom: 0;
    z-index: 0;
  }

  /*
   * Fondo e riga di confine arrivano da `.band-soft` (global.css), condivisa
   * con la fascia del blog: là c'è scritta anche la regola dei confini.
   *
   * Da non rifare: qui il colore era entrato in dissolvenza sui primi 14rem,
   * perché nella parte trasparente si vedesse il globo che usciva dalla hero.
   * Dietro a quella trasparenza però non c'è la hero — che finisce più su —
   * ma il bianco della pagina, e ne veniva un cuneo biancastro largo mezzo
   * schermo, ritagliato a destra dal bordo del pianeta. Nemmeno aggiustabile
   * abbassando l'opacità: o si vede il globo sotto e allora si vede anche il
   * bianco, o non si vede nessuno dei due. Il globo si spegne da solo dentro
   * la hero (vedi `--gb-fondo-*`), e qui il colore parte pieno.
   */
  .servizi-fondo {
    padding-bottom: clamp(8rem, 5rem + 11vw, 15rem);
  }

  .servizi-uscita { transform-origin: 50% 100%; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .servizi-uscita {
        --tl: view();
        animation: servizi-arretra linear both;
        animation-timeline: var(--tl);
        animation-range: exit 15% exit 100%;
        will-change: transform, opacity;
      }
    }
  }
  /* È QUESTO il parallasse d'arrivo della fascia blu, non lo sticky.
     Misurato alla mano: `bottom: 0` sul primo figlio del contenitore non ha
     spazio in cui agganciarsi (il suo bordo alto È il bordo del contenitore),
     quindi non è mai scattato — l'aggancio documentato più su è di fatto
     inerte, e restava solo il rimpicciolimento.

     Qui il contenuto SCENDE (translateY positivo) mentre la pagina sale:
     rispetto alla finestra si muove più lento della fascia che arriva, e
     affonda spegnendosi nell'azzurro. Gli 88px restano dentro i ~240px di
     respiro basso della sezione: il contenuto non raggiunge mai il cambio
     di colore. */
  @keyframes servizi-arretra {
    from { transform: scale(1) translate3d(0, 0, 0); opacity: 1; }
    to { transform: scale(0.94) translate3d(0, 88px, 0); opacity: 0.45; }
  }

  /* ═══════════════════════════════════════════════════════════════════════
     IL METODO — quattro pannelli che si sostituiscono scorrendo
     ═══════════════════════════════════════════════════════════════════════ */

  /*
   * `clip` e non `hidden`, ed è la differenza fra la sezione che funziona e
   * la sezione che non funziona: `overflow: hidden` rende l'elemento un
   * contenitore di scorrimento, e `position: sticky` sui pannelli qui dentro
   * smette di agganciarsi — la pila torna un elenco normale. `clip` ritaglia
   * gli aloni senza creare quel contenitore.
   */
  .metodo { position: relative; overflow: clip; isolation: isolate; }

  /* Aloni di fondo che scorrono più lenti della pagina. Cerchi sfocati, non
     immagini: costano zero byte e si muovono sul compositore, quindi la
     parallasse non tocca mai il thread principale. */
  .metodo-alone {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
  }
  .metodo-alone-1 {
    top: -8rem;
    right: -12rem;
    width: 36rem;
    height: 36rem;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-cyan) 22%, transparent) 0%,
      transparent 66%
    );
  }
  .metodo-alone-2 {
    bottom: -14rem;
    left: -14rem;
    width: 32rem;
    height: 32rem;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-navy) 12%, transparent) 0%,
      transparent 68%
    );
  }

  .metodo-intro { max-width: 38rem; }

  /*
   * La pila.
   *
   * Ogni pannello si aggancia in alto (`sticky`) e ci resta finché il
   * successivo non gli sale sopra. I `top` crescono di mezzo centimetro a
   * pannello, così di quelli già passati resta visibile il bordo superiore:
   * è quel dettaglio che fa leggere il blocco come un mazzo di carte invece
   * che come un salto brusco fra una schermata e l'altra.
   *
   * Il margine negativo fra un elemento e l'altro è ciò che li fa
   * sovrapporre; senza, la pila diventa un elenco normale.
   */
  .metodo-pila {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }

  .passo { position: sticky; top: calc(var(--nav-h) + 1.5rem + var(--i) * 0.75rem); }
  .passo + .passo { margin-top: 2.5rem; }

  .passo-corpo {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
    min-height: 20rem;
    overflow: hidden;
    padding: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    background: var(--color-paper);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 1024px) {
    /* Da qui in su la scheda è a due colonne: il testo tiene la sua misura di
       lettura e la foto occupa la colonna fissa a destra, dove prima c'era
       solo il vuoto riempito dal numero. */
    .passo-corpo { min-height: 24rem; grid-template-columns: 1fr 20rem; }
  }

  .passo-testo { position: relative; z-index: 1; max-width: 34rem; }

  .passo-testa { display: flex; align-items: center; gap: 0.875rem; }
  .passo-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .passo-titolo {
    margin-top: 1.25rem;
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }
  .passo-riga {
    margin-top: 0.875rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-3);
  }

  /*
   * Il riquadro della foto. `aspect-ratio` fisso e `object-fit: cover`: i
   * render sono 1152x896 (1,29) contro il 4:3 del riquadro (1,33), quindi il
   * ritaglio vale il 4% ai lati e nessuna inquadratura ne soffre.
   */
  .passo-scena {
    display: none;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-paper-2);
  }
  .passo-scena :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  /* Sotto i 1024px la scheda resta di solo testo: quattro foto in colonna
     allungherebbero la pila al punto da perdere il ritmo dello scorrimento. */
  @media (min-width: 1024px) {
    .passo-scena { display: block; }
  }

  /* Quattro tacche in alto a destra: dicono a che punto del percorso si è
     senza dover contare i pannelli. */
  .passo-tacche {
    position: absolute;
    top: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
    right: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
    display: flex;
    gap: 0.3125rem;
  }
  .passo-tacche i {
    width: 1.5rem;
    height: 3px;
    border-radius: 3px;
    background: var(--color-line);
  }
  .passo-tacche i.acceso { background: var(--color-navy); }

  /* Chi ha chiesto meno movimento non si trova i pannelli che si accavallano:
     diventano quattro schede una sotto l'altra, che è la stessa informazione
     senza l'effetto. */
  @media (prefers-reduced-motion: reduce) {
    .passo { position: static; }
    .passo-corpo { min-height: 0; }
  }


  /* Alone dietro al globo: dà profondità al reticolo, che altrimenti
     resterebbe sospeso sul bianco senza appoggio. */
  /* ── La hero ────────────────────────────────────────────────────────────
   *
   * Prende una schermata intera: sotto non deve avanzare una striscia della
   * sezione successiva, che spezzerebbe l'inquadratura del pianeta. `svh` e
   * non `vh` perché su mobile `vh` conta anche la barra del browser, che
   * all'inizio c'è: la hero risulterebbe più alta dello schermo.
   *
   * L'altezza della barra di navigazione è misurata, non stimata: 57 px sotto
   * i 1024, 65 sopra (cambia il padding del logo).
   */
  /* Il respiro sopra e sotto si adatta all'altezza della finestra: con un
     padding fisso, su un portatile basso il blocco di testo non ci stava e la
     lista di rassicurazioni finiva sotto la piega. */
  .hero-griglia {
    padding-block: clamp(1.75rem, 4.5vh, 5rem);
  }

  /*
   * Alta quanto la finestra, non una riga di meno.
   *
   * Qui c'era `calc(100svh - altezza della barra)`, e sotto la testata
   * restava scoperta una striscia della sezione successiva. Il motivo:
   * `.under-nav` tira su la sezione di tutta l'altezza della barra e gliela
   * restituisce come spaziatura interna, quindi il riquadro parte già dal
   * bordo alto della finestra. Sottrarre di nuovo la barra la toglieva due
   * volte, e quello che avanzava in fondo era proprio alto come la barra.
   *
   * `svh` e non `vh`: sul telefono `vh` conta la finestra con la barra degli
   * indirizzi ritirata, e la testata sborderebbe da subito.
   */
  .hero {
    /*
     * Una schermata esatta, non una riga di più.
     *
     * Avevo provato ad allungarla con una seconda riga vuota, per far
     * chiudere il globo dentro la sezione: funzionava, ma la hero diventava
     * una schermata e mezza e sotto al testo restava mezza pagina di bianco.
     * E un pianeta che si chiude tutto non si legge più come un pianeta
     * enorme inquadrato di taglio: sembra un'icona rotonda.
     */
    min-height: 100svh;
    display: grid;
    align-items: center;

    /*
     * Taglia su tutti e quattro i bordi. Serve ai lati — la sfera esce di
     * 6rem oltre il bordo della finestra, e senza il taglio la pagina
     * scorrerebbe in orizzontale — e sotto non fa danni, perché il pianeta si
     * spegne da solo un po' prima (vedi `--gb-fondo-*`) e al bordo non ci
     * arriva più.
     *
     * Avevo provato ad aprirlo sotto con `overflow-x: clip; overflow-y:
     * visible`, per far proseguire il globo nella sezione successiva. Torna
     * qui perché quella strada portava alla macchia bianca: per vedere il
     * globo là sotto, quello che gli sta sopra dev'essere trasparente, e
     * dietro alla trasparenza c'è il bianco della pagina. Da segnare, se mai
     * dovesse servire di nuovo: `clip` accanto a `visible` è l'unico modo di
     * tagliare su un asse solo (accanto a `hidden` l'altro asse diventa
     * `auto`, cioè una barra di scorrimento), e `clip-path` NON è un
     * sostituto perché nasconde senza togliere l'ingombro.
     */
    overflow: hidden;
  }

  /*
   * Il globo non sta dentro la colonna: la colonna gli fa solo da ancoraggio.
   * La sfera è larga quasi il doppio ed esce dal bordo destro della pagina,
   * così si legge come un pianeta enorme inquadrato di taglio e non come
   * un'icona rotonda. Il taglio lo fa `overflow-hidden` della sezione.
   *
   * IL PUNTO CHIAVE È `translate: 0 -19.09%`.
   *
   * Messina sta al 19,09% dell'altezza del disco: è la sua latitudine
   * proiettata sulla sfera ((1 − sin 38,19°) / 2), non un numero scelto a
   * occhio. Posizionando il disco con `top: 44%` e poi tirandolo su di quel
   * 19,09%, è la RIGA DI MESSINA a finire al 44% dell'altezza — non il centro
   * della sfera. Senza questa correzione Messina resta appesa in alto a
   * destra, perché il centro del disco è l'equatore.
   */
  .hero-globo {
    position: relative;
    width: 100%;
  }

  /* Il testo passa sempre sopra al pianeta. Nella griglia il globo viene dopo
     nel documento, quindi senza questo si dipingeva sopra al titolo e sopra
     al bottone: il bordo del disco si vedeva attraversarli. */
  .hero-testo {
    position: relative;
    z-index: 1;
  }

  .hero-globo-sfera {
    position: absolute;
  }

  /* Sotto i 1024 px il globo passa DIETRO al testo invece di stare sotto.
     Prima finiva quasi tutto sotto la piega — su un telefono si vedeva solo
     una mezzaluna in fondo alla schermata — e la hero era lunga il doppio
     dello schermo. Così invece il pianeta fa da fondale, come nel disegno
     originale, e la hero sta in una schermata. */
  @media (max-width: 1023px) {
    .hero-griglia {
      position: relative;
    }

    .hero-globo {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .hero-globo-sfera {
      top: 44%;
      left: 50%;
      width: 34rem;
      max-width: 165%;
      translate: -50% -19.09%;
      /* Dietro al testo va tenuto basso: qui il contrasto conta più
         dell'effetto. */
      opacity: 0.62;
      /* NESSUNA dissolvenza in fondo, di proposito. Qui c'era una coppia
         `--gb-fondo-*` che non ha mai avuto effetto (vedi Globe.astro): a
         questa larghezza il disco sta tutto dentro la sezione — misurato, dal
         109% al 210% della sua altezza a seconda del telefono — quindi non
         c'è nessun taglio da nascondere, e spegnere il fondo di una sfera
         intera la farebbe solo sembrare storta. */
    }
  }

  @media (min-width: 1024px) {
    .hero-globo {
      height: 33rem;
    }

    /*
     * Ancorata al BORDO DELLO SCHERMO, non alla colonna.
     *
     * La colonna finisce dove finisce il contenitore centrato (75rem), quindi
     * su un monitor largo restava una fascia bianca a destra della sfera e il
     * taglio non c'era più. Con questo calcolo il disco sborda sempre di 6rem
     * oltre il bordo della finestra, a qualunque larghezza — ed è anche ciò
     * che porta Messina più al centro: la Sicilia passa dal centro del disco,
     * e il centro del disco è mezza sfera più a sinistra del suo bordo.
     */
    .hero-globo-sfera {
      top: 42%;
      left: auto;
      right: calc(-1 * max(0px, (100vw - var(--measure-page)) / 2) - 6rem);
      width: 62rem;
      translate: 0 -19.09%;

      /*
       * Il pianeta si spegne prima del bordo della sezione — MISURATO IN
       * PIXEL DAL BORDO, non in percentuale del disco.
       *
       * È la differenza fra funzionare e sembrare di funzionare. Qui c'era
       * una percentuale (`50%`, `65%`), e una percentuale del disco non può
       * essere giusta: il disco è largo una misura fissa mentre la sezione è
       * alta 100svh, quindi il bordo cade ogni volta a una frazione diversa —
       * misurato, dal 54% su una finestra bassa e larga all'80% su una alta.
       * Dove il numero sbagliava restava un residuo di opacità tagliato di
       * netto, cioè una riga in mezzo alla pagina.
       *
       * Il conto qui sotto è misurato sulla pagina vera, non dedotto:
       *
       *   il fondo della hero cade a max(604px, 50svh + 200px) sotto il bordo
       *   alto del disco.
       *
       * Il `max()` non è prudenza: sotto gli 880px di finestra la hero non si
       * accorcia più — ci sta dentro il blocco di testo e quello fa da
       * pavimento — quindi la distanza smette di seguire l'altezza e si ferma
       * a 604. Con il solo `50svh + 200px` la dissolvenza finirebbe troppo in
       * basso proprio sulle finestre più basse, che sono il caso peggiore.
       *
       * Da lì tolgo 1,5rem di margine e faccio durare la dissolvenza 12rem.
       */
      --gb-fondo-a: calc(max(604px, 50svh + 200px) - 1.5rem);
      --gb-fondo-da: calc(max(604px, 50svh + 200px) - 13.5rem);
    }
  }

  @media (min-width: 1600px) {
    .hero-globo-sfera {
      width: 70rem;
      /* Disco più grande: il suo bordo alto parte 24px più su, quindi il
         fondo della hero gli cade 24px più sotto. Stessa misura, +24. */
      --gb-fondo-a: calc(max(628px, 50svh + 224px) - 1.5rem);
      --gb-fondo-da: calc(max(628px, 50svh + 224px) - 13.5rem);
    }
  }

  /* ── Le didascalie sul globo ───────────────────────────────────────────
   *
   * Puntino, filo, testo. Nessuna superficie: quello che si vede è la scritta
   * appoggiata sulla mappa, non una scheda che ci sta sopra. Per farla
   * reggere sul disegno il puntino ha un alone bianco (stacca dalle coste) e
   * il titolo è in navy pieno.
   *
   * Nessuno stato di hover: non sono cliccabili, e fingere che lo siano è
   * peggio che non averli.
   */
  .hero-note li {
    position: absolute;
    z-index: 1;
    display: none;
    align-items: center;
    gap: 0.6rem;
    width: max-content;
    max-width: 15rem;
  }

  /* Solo nel layout a due colonne: sotto i 1024 px il globo passa dietro al
     testo e le didascalie gli finirebbero addosso. */
  @media (min-width: 1024px) {
    .hero-note li {
      display: flex;
    }
  }

  /* Il puntino segna il posto; il filo lo collega alla scritta. Sono un
     elemento solo: il pallino è il bordo, il filo è lo pseudo-elemento. */
  .hero-note-punto {
    position: relative;
    flex-shrink: 0;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-navy);
    box-shadow: 0 0 0 0.25rem rgb(255 255 255 / 0.72);
  }

  .hero-note-punto::after {
    content: "";
    position: absolute;
    left: 100%;
    top: 50%;
    width: 1.375rem;
    border-top: 1px solid color-mix(in srgb, var(--color-navy) 38%, transparent);
  }

  /*
   * Il testo su una superficie bianca.
   *
   * Senza, la scritta si mescolava alle coste e alla rete: leggibile a fatica
   * e con l'aria di essere finita lì per sbaglio. Con il riquadro torna a
   * essere una cosa sola — puntino, filo, targhetta — e resta comunque una
   * didascalia della mappa, non una scheda: bordo capello, ombra bassissima,
   * niente riquadro icona.
   */
  .hero-note li > span:last-child {
    margin-left: 1.375rem;
    padding: 0.5rem 0.8125rem 0.5625rem;
    border-radius: var(--radius-md);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }

  .hero-note-titolo {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .hero-note-riga {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--color-ink-3);
  }

  .hero-note-1 { top: 15%; left: -3rem; }
  .hero-note-2 { top: 45%; left: 1.5rem; }
  .hero-note-3 { top: 74%; left: -1.5rem; }

  /* L'alone azzurro dietro alla sfera: sta dentro al suo contenitore, quindi
     la seghe automaticamente, e sfuma prima del bordo così non disegna un
     secondo cerchio attorno al primo. */
  .globe-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 122%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 42% 34%,
      color-mix(in srgb, var(--color-cyan) 13%, transparent),
      color-mix(in srgb, var(--color-soft) 42%, transparent) 50%,
      transparent 68%
    );
  }

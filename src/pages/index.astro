---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Globe from "@/components/Globe.astro";
import Marquee from "@/components/Marquee.astro";
import VideoLoop from "@/components/VideoLoop.astro";
import CaseCard from "@/components/CaseCard.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import { SITE } from "@/data/site";
import { SERVICES } from "@/data/services";
import processoIllustration from "@/assets/illustrazioni/scena-processo.png";

const projects = (await getCollection("portfolio"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const articles = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const SERVICE_ICONS = ["globe", "bag", "phone", "dashboard", "sparkles"] as const;

/** Le tre frasi sotto le CTA: rassicurano prima ancora che si scorra. */
const TRUST = [
  "Preventivo scritto prima di iniziare",
  "Codice e dominio restano tuoi",
  "Parli sempre con chi sviluppa",
];

/* I due nastri scorrono in versi opposti: il contrasto di direzione rende
   evidente che si muovono, senza che nessuno dei due debba correre. */
const COSA_COSTRUIAMO = [
  "Siti web",
  "E-commerce",
  "App mobile",
  "Gestionali su misura",
  "Portali clienti",
  "Integrazioni con API",
  "Automazioni",
  "Manutenzione continua",
];

const TECNOLOGIE = [
  "Next.js",
  "Astro",
  "React",
  "TypeScript",
  "Django",
  "PostgreSQL",
  "Stripe",
  "Docker",
  "Tailwind CSS",
  "Celery",
];

const PHASES = [
  {
    icon: "message",
    title: "Ascolto",
    text: "Capiamo il problema prima di parlare di soluzioni. Spesso quello che serve è diverso da quello che si era immaginato, e dirlo è parte del lavoro.",
  },
  {
    icon: "file",
    title: "Proposta",
    text: "Ambito, tempi e costo messi per iscritto prima di iniziare. Nessuna voce a sorpresa a metà progetto.",
  },
  {
    icon: "wrench",
    title: "Costruzione",
    text: "Ti mostriamo il lavoro mentre procede, non alla fine. Se qualcosa non convince si corregge quando costa poco.",
  },
  {
    icon: "package",
    title: "Consegna",
    text: "Il progetto è tuo: codice, dominio, accessi. Ti spieghiamo come funziona e restiamo raggiungibili.",
  },
] as const;

const COMMITMENTS = [
  {
    icon: "users",
    title: "Parli con chi scrive il codice",
    text: "Nessun passaggio di consegne fra commerciale e tecnico. Chi ti risponde è chi il lavoro lo fa.",
  },
  {
    icon: "shield",
    title: "Il progetto è tuo, per intero",
    text: "Codice sorgente, dominio e accessi restano di tua proprietà. Nessun vincolo che ti obblighi a restare.",
  },
  {
    icon: "file",
    title: "Preventivo scritto prima",
    text: "Ambito e costo definiti in partenza. Se serve una modifica fuori perimetro, la quantifichiamo prima di farla.",
  },
  {
    icon: "check",
    title: "Ti diciamo anche di no",
    text: "Se pensiamo che ti serva qualcosa di più semplice, o niente affatto, te lo diciamo, anche quando significa fatturare meno.",
  },
] as const;
---

<Base title={SITE.name} description={SITE.description} canonical="/">
  <!-- ══════════════════════════════════════════════════════════════════
       HERO
       Il titolo è l'elemento LCP: si anima solo in `transform`, mai in
       opacità, altrimenti la metrica slitterebbe di tutta l'animazione.

       A destra il globo: è disegnato in CSS, quindi non c'è nessuna
       immagine da scaricare sopra la piega e l'LCP resta il titolo.
       ══════════════════════════════════════════════════════════════════ -->
  <section class="glow-bg overflow-hidden">
    <div class="wrap">
      <div class="grid items-center gap-10 pt-12 pb-14 sm:pt-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:pt-20 lg:pb-24">
        <div>
          <span class="chip anim-fade-rise">
            <Icon name="pin" size={13} />
            Software house · {SITE.city}, {SITE.countryName}
          </span>

          <h1 class="t-display mt-6 anim-rise">
            Dall'idea al lancio, parli sempre con <span class="t-dim">chi scrive il codice.</span>
          </h1>

          <p class="t-lead mt-6 max-w-xl anim-fade-rise delay-2">
            Siti, e-commerce, app e software su misura per aziende italiane.
            Costruiamo il progetto, te lo consegniamo per intero, e restiamo
            raggiungibili dopo il lancio.
          </p>

          <div class="mt-8 flex flex-wrap gap-3 anim-fade-rise delay-3">
            <a href="/contatti" class="btn btn-primary btn-lg">
              Parliamo del tuo progetto
              <Icon name="arrow-right" size={17} />
            </a>
            <a href="/portfolio" class="btn btn-ghost btn-lg">Guarda i progetti</a>
          </div>

          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 anim-fade-rise delay-4">
            {
              TRUST.map((t) => (
                <li class="flex items-center gap-2 text-[0.8125rem] font-medium text-[var(--color-ink-3)]">
                  <Icon name="check" size={15} class="text-[var(--color-navy)]" />
                  {t}
                </li>
              ))
            }
          </ul>
        </div>

        <!--
          Globo con i cartellini che galleggiano attorno.
          Il contenitore è largo quanto il globo: così i cartellini si
          posizionano rispetto ALLA SFERA e non alla colonna, e sporgono di
          poco senza uscire dalla pagina.
        -->
        {/* `anim-rise` (solo transform) e non una dissolvenza: sopra la piega
            un'opacità che riparte lascia il vuoto al posto della figura. */}
        <div class="anim-rise relative mx-auto w-full max-w-[22rem] sm:max-w-[26rem] lg:max-w-[32rem]">
          <div class="globe-halo" aria-hidden="true"></div>
          <Globe class="relative" />

          <div class="float absolute -left-4 top-[14%] hidden w-[13.5rem] sm:block lg:-left-10">
            <div class="card flex items-center gap-3 px-3.5 py-2.5">
              <span class="icon-tile icon-tile-sm"><Icon name="zap" size={16} /></span>
              <span>
                <span class="block text-[0.8125rem] font-bold text-[var(--color-ink)]">Siti istantanei</span>
                <span class="block text-[0.6875rem] leading-tight text-[var(--color-ink-3)]">Ottimizzati fino all'ultimo kB</span>
              </span>
            </div>
          </div>

          <div class="float-slow absolute -right-4 top-[45%] hidden w-[12rem] sm:block lg:-right-8">
            <div class="card flex items-center gap-3 px-3.5 py-2.5">
              <span class="icon-tile icon-tile-sm"><Icon name="shield" size={16} /></span>
              <span>
                <span class="block text-[0.8125rem] font-bold text-[var(--color-ink)]">Nessun vincolo</span>
                <span class="block text-[0.6875rem] leading-tight text-[var(--color-ink-3)]">Il codice è tuo</span>
              </span>
            </div>
          </div>

          <div class="float-fast absolute bottom-[8%] -left-2 hidden w-[13rem] lg:block lg:-left-6">
            <div class="card flex items-center gap-3 px-3.5 py-2.5">
              <span class="icon-tile icon-tile-sm"><Icon name="headset" size={16} /></span>
              <span>
                <span class="block text-[0.8125rem] font-bold text-[var(--color-ink)]">Risposta in 1 giorno</span>
                <span class="block text-[0.6875rem] leading-tight text-[var(--color-ink-3)]">Lavorativo</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       NASTRI — cosa costruiamo e con cosa
       Occupano tutta la larghezza, senza `wrap`: il taglio ai bordi dello
       schermo è ciò che li fa leggere come un flusso continuo.
       ══════════════════════════════════════════════════════════════════ -->
  <section class="border-y border-[var(--color-line)] bg-[var(--color-paper)] py-10 sm:py-12">
    <p class="t-eyebrow wrap mb-6 text-center">Cosa costruiamo, e con cosa</p>
    <div class="space-y-3">
      {/* La riga delle tecnologie ha voci più corte, quindi serve una copia
          in più per coprire gli schermi larghi. */}
      <Marquee items={COSA_COSTRUIAMO} duration={46} repeats={4} />
      <Marquee items={TECNOLOGIE} duration={54} repeats={6} reverse />
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       SERVIZI
       ══════════════════════════════════════════════════════════════════ -->
  <section class="band-soft section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="t-eyebrow">I servizi</span>
        <h2 class="t-h2 mt-3">
          Cinque cose, <span class="t-dim">fatte bene.</span>
        </h2>
        <p class="t-lead mt-4">
          Non facciamo tutto. Per ognuno di questi sappiamo dirti anche quando
          non ti serve, e succede più spesso di quanto immagini.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          SERVICES.map((s, i) => (
            <a href={`/servizi/${s.slug}`} class="card group relative flex flex-col p-6 reveal">
              <Icon
                name="arrow-up-right"
                size={16}
                class="absolute right-5 top-5 text-[var(--color-line)] transition-colors group-hover:text-[var(--color-navy)]"
              />
              <span class="icon-tile">
                <Icon name={SERVICE_ICONS[i]} size={22} />
              </span>
              <h3 class="t-h3 mt-4">{s.title}</h3>
              <p class="t-body mt-2 flex-1 text-[0.875rem]">{s.summary}</p>
              <span class="mt-5 flex items-center gap-2 text-[0.75rem] font-semibold text-[var(--color-ink-3)]">
                <Icon name="clock" size={14} />
                {s.timeline}
              </span>
            </a>
          ))
        }

        <!-- Cella finale: chiude la griglia e porta al contatto -->
        <div class="card flex flex-col justify-center bg-[var(--color-soft)] p-6">
          <h3 class="t-h3">Non sai quale ti serve?</h3>
          <p class="t-body mt-2 text-[0.875rem]">
            È la situazione più comune. Raccontaci il problema e ti diciamo noi
            da dove conviene partire.
          </p>
          <a href="/contatti" class="link-arrow mt-5">
            Scrivici
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       IL PRODOTTO IN MOVIMENTO
       Registrazione vera di Nexia Home, non un video d'archivio.
       ══════════════════════════════════════════════════════════════════ -->
  <VideoLoop
    eyebrow="Software in funzione"
    title='Non un mockup: <span class="t-dim">il prodotto vero.</span>'
    lead="Questa è Nexia Home mentre importa una fattura e la associa da sola al fornitore giusto. L'abbiamo costruita noi, e la manteniamo tutti i giorni."
    caption="Registrazione dell'applicazione reale, senza montaggio."
  />

  <!-- ══════════════════════════════════════════════════════════════════
       COME LAVORIAMO
       ══════════════════════════════════════════════════════════════════ -->
  <section class="band-soft section">
    <div class="wrap">
      <div class="grid items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div class="order-2 lg:order-1">
          <Image
            src={processoIllustration}
            alt="Illustrazione: pianificazione del progetto"
            widths={[280, 400, 560]}
            sizes="(min-width: 1024px) 360px, 55vw"
            loading="lazy"
            class="mx-auto w-full max-w-[18rem] lg:max-w-none"
          />
        </div>

        <div class="order-1 lg:order-2">
          <span class="t-eyebrow">Il metodo</span>
          <h2 class="t-h2 mt-3">
            Quattro passaggi, <span class="t-dim">nessuna sorpresa.</span>
          </h2>
          <p class="t-lead mt-4 max-w-xl">
            Lo stesso percorso su ogni progetto, dal sito vetrina al gestionale.
            Sapere cosa succede dopo è metà della tranquillità.
          </p>

          <ol class="mt-10 space-y-6">
            {
              PHASES.map((p, i) => (
                <li class="group flex gap-4 reveal">
                  <span class="icon-tile"><Icon name={p.icon} size={20} /></span>
                  <span class="pt-0.5">
                    <span class="flex items-baseline gap-2">
                      <span class="t-h3">{p.title}</span>
                      <span class="phase-num">0{i + 1}</span>
                    </span>
                    <span class="t-body mt-1 block">{p.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       PROGETTI
       ══════════════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <span class="t-eyebrow">I progetti</span>
          <h2 class="t-h2 mt-3">
            Cosa sappiamo <span class="t-dim">costruire.</span>
          </h2>
          <p class="t-lead mt-4">
            Nexia Home è il gestionale per amministratori di condominio che
            abbiamo costruito e che manteniamo: contabilità, adempimenti
            fiscali, assemblee e portale per i condòmini. La scheda racconta le
            scelte tecniche, non solo il risultato.
          </p>
        </div>
        <a href="/portfolio" class="link-arrow shrink-0 pb-1">
          Tutti i progetti
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((entry, i) => (
            <div class="reveal" style={`--i:${i}`}>
              <CaseCard entry={entry} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       IMPEGNI — unica fascia scura della pagina
       ══════════════════════════════════════════════════════════════════ -->
  <section class="on-dark section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="t-eyebrow">Gli impegni</span>
        <h2 class="t-h2 mt-3">
          Quattro cose che mettiamo <span class="t-dim">per iscritto.</span>
        </h2>
        <p class="t-lead mt-4">
          Non sono slogan: sono condizioni che trovi nel preventivo e che puoi
          contestarci se non le rispettiamo.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          COMMITMENTS.map((c) => (
            <div class="card group flex gap-4 p-6 reveal">
              <span class="icon-tile"><Icon name={c.icon} size={20} /></span>
              <span>
                <span class="t-h3 block">{c.title}</span>
                <span class="t-body mt-2 block">{c.text}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       DAL BLOG
       ══════════════════════════════════════════════════════════════════ -->
  {
    articles.length > 0 && (
      <section class="band-soft section">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
              <span class="t-eyebrow">Dal blog</span>
              <h2 class="t-h2 mt-3">
                Quello che spieghiamo <span class="t-dim">ai clienti.</span>
              </h2>
            </div>
            <a href="/blog" class="link-arrow shrink-0 pb-1">
              Tutti gli articoli
              <Icon name="arrow-right" size={16} />
            </a>
          </div>

          <div class="mt-10 grid gap-5 sm:grid-cols-2">
            {articles.map((entry) => (
              <ArticleCard entry={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</Base>

<style>
  /* Numero d'ordine della fase. Decorativo, ma resta testo: il colore deve
     comunque reggere il contrasto sul fondo chiaro della sezione, quindi si
     usa il grigio di sistema già verificato e non un grigio più tenue. */
  .phase-num {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-3);
  }

  /* Alone dietro al globo: dà profondità al reticolo, che altrimenti
     resterebbe sospeso sul bianco senza appoggio. */
  .globe-halo {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 42% 34%,
      color-mix(in srgb, var(--color-cyan) 16%, transparent),
      color-mix(in srgb, var(--color-soft) 55%, transparent) 58%,
      transparent 72%
    );
  }
</style>

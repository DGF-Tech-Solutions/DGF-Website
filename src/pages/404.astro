---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import { NAV } from "@/data/site";
import { SERVICES } from "@/data/services";

const SERVICE_ICONS = ["globe", "bag", "phone", "dashboard", "sparkles"] as const;
---

<Base
  title="Pagina non trovata"
  description="La pagina che cercavi non esiste o è stata spostata."
  canonical="/404"
  noindex
>
  <section class="glow-bg section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="chip"><Icon name="search" size={14} /> Errore 404</span>
        <h1 class="t-h1 mt-5">
          Questa pagina <span class="t-dim">non c'è.</span>
        </h1>
        <p class="t-lead mt-5">
          L'indirizzo è sbagliato, oppure la pagina è stata spostata. Qui sotto
          trovi le sezioni principali del sito.
        </p>
        <a href="/" class="btn btn-primary btn-lg mt-8">
          Torna alla home
          <Icon name="arrow-right" size={17} />
        </a>
      </div>

      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          SERVICES.map((s, i) => (
            <a href={`/servizi/${s.slug}`} class="card group flex items-center gap-3 p-5">
              <span class="icon-tile icon-tile-sm">
                <Icon name={SERVICE_ICONS[i]} size={17} />
              </span>
              <span class="text-[0.9375rem] font-semibold text-[var(--color-ink)]">
                {s.title}
              </span>
            </a>
          ))
        }
        {
          [...NAV.filter((l) => l.href !== "/servizi"), { label: "Contatti", href: "/contatti" }].map((l) => (
            <a href={l.href} class="card group flex items-center gap-3 p-5">
              <span class="icon-tile icon-tile-sm">
                <Icon name="arrow-right" size={17} />
              </span>
              <span class="text-[0.9375rem] font-semibold text-[var(--color-ink)]">
                {l.label}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";
import { formatDate, isoDate, readingMinutes } from "@/lib/format";
import coverDefault from "@/assets/foto/blog.webp";

export async function getStaticPaths() {
  const articles = await getCollection("blog", ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// Se il frontmatter non dichiara i minuti, li stimiamo dal testo.
const minutes = d.readingTime ?? readingMinutes(entry.body ?? "");

/*
 * Fotografia della testata. Se l'articolo non ne dichiara una, prende quella
 * generica del blog: la fascia blu con la foto tagliata a destra dev'essere
 * la stessa su ogni pezzo, non un privilegio di chi ha ricordato il campo.
 */
const cover = d.cover ?? coverDefault;
const coverAlt = d.cover ? d.coverAlt : "";

const others = (await getCollection("blog", ({ data }) => !data.draft))
  .filter((a) => a.id !== entry.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const schema = {
  "@type": "BlogPosting",
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  inLanguage: "it-IT",
  url: `${SITE.url}/blog/${entry.id}`,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE.url}/blog/${entry.id}` },
  author: { "@type": "Organization", name: d.author, "@id": `${SITE.url}/#organization` },
  publisher: { "@id": `${SITE.url}/#organization` },
  /* Il campo che Google usa per l'anteprima con immagine dei risultati
     articolo. Senza, i pezzi del blog partono penalizzati pur avendo una
     copertina in frontmatter. `cover.src` e' il percorso processato da Astro,
     reso assoluto perche' i dati strutturati non ammettono percorsi relativi. */
  image: cover ? new URL(cover.src, SITE.url).href : undefined,
  articleSection: d.category,
  wordCount: (entry.body ?? "").trim().split(/\s+/).length,
};
---

<Base
  title={d.title}
  description={d.excerpt}
  canonical={`/blog/${entry.id}`}
  ogType="article"
  schema={schema}
>
  {/* Barra di avanzamento della lettura: si riempie con lo scroll del
      documento tramite `animation-timeline: scroll()`. Zero JavaScript. */}
  <div class="read-progress" aria-hidden="true"></div>

  <article>
    {/* Stessa testata delle altre pagine interne (/chi-siamo, /servizi):
        fascia blu piena e fotografia tagliata sul bordo destro. Prima qui
        c'era una testata chiara senza immagine, ed era l'unica pagina del
        sito a presentarsi in un modo tutto suo. */}
    <PageHeader
      eyebrow={d.category}
      title={d.title}
      titleScale="long"
      lead={d.excerpt}
      crumbs={[{ label: "Blog", href: "/blog" }, { label: d.title }]}
      illustration={cover}
      illustrationAlt={coverAlt}
      illustrationAi={d.cover ? d.coverAi : true}
    >
      {/* Data e durata sotto il sommario, non sopra il titolo: la prima cosa
          che si legge dev'essere di cosa si parla, non quando è stato
          scritto. Stessa scelta della pagina di progetto. */}
      <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2">
        <time datetime={isoDate(d.date)} class="t-small">{formatDate(d.date)}</time>
        <span class="t-small" aria-hidden="true">·</span>
        <span class="t-small inline-flex items-center gap-1.5">
          <Icon name="clock" size={14} />
          {minutes} min di lettura
        </span>
      </div>
    </PageHeader>

    <div class="wrap section">
      {/* Il testo arriva ai bordi del contenitore, gli stessi di ogni altra
          sezione del sito. Prima era una colonna da 42rem centrata, che
          lasciava due fasce vuote ai lati larghe un quarto di schermo
          ciascuna. */}
      <div class="article-body">
        <div class="prose !max-w-none">
          <Content />
        </div>

        <!-- Firma -->
        <div class="card mt-14 flex flex-col gap-4 bg-[var(--color-soft)] p-6 sm:flex-row sm:items-center">
          <span class="icon-tile bg-white shrink-0"><Icon name="message" size={20} /></span>
          <p class="t-body flex-1 !text-[0.9375rem]">
            Scritto da <strong class="font-semibold text-[var(--color-ink)]">{d.author}</strong>.
            Hai una domanda su questo argomento?
          </p>
          <a href="/contatti" class="btn btn-primary shrink-0 !py-2.5 !text-[0.875rem]">
            Scrivici
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="band-soft section">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 class="t-h2">
              Continua <span class="t-dim">a leggere.</span>
            </h2>
            <a href="/blog" class="link-arrow pb-1">
              Tutti gli articoli
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((a) => (
              <ArticleCard entry={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    badge="Parliamone"
    title='Ti serve una mano <span class="t-dim">su questo?</span>'
    lead="Se l'argomento dell'articolo riguarda un problema che hai adesso, scrivici: ti diciamo cosa faremmo noi, anche se la risposta è che non ti serve niente."
  />
</Base>

<style>
  /* L'ancora dell'indice non deve finire sotto la barra in alto. */
  .article-body :global(h2) { scroll-margin-top: 6rem; }
</style>

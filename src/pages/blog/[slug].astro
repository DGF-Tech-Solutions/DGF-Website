---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";
import { formatDate, isoDate, readingMinutes } from "@/lib/format";

export async function getStaticPaths() {
  const articles = await getCollection("blog", ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// Se il frontmatter non dichiara i minuti, li stimiamo dal testo.
const minutes = d.readingTime ?? readingMinutes(entry.body ?? "");

const others = (await getCollection("blog", ({ data }) => !data.draft))
  .filter((a) => a.id !== entry.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const schema = {
  "@type": "BlogPosting",
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  inLanguage: "it-IT",
  url: `${SITE.url}/blog/${entry.id}`,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE.url}/blog/${entry.id}` },
  author: { "@type": "Organization", name: d.author, "@id": `${SITE.url}/#organization` },
  publisher: { "@id": `${SITE.url}/#organization` },
  articleSection: d.category,
  wordCount: (entry.body ?? "").trim().split(/\s+/).length,
};
---

<Base
  title={d.title}
  description={d.excerpt}
  canonical={`/blog/${entry.id}`}
  ogType="article"
  schema={schema}
>
  {/* Barra di avanzamento della lettura: si riempie con lo scroll del
      documento tramite `animation-timeline: scroll()`. Zero JavaScript. */}
  <div class="read-progress" aria-hidden="true"></div>

  <article>
    <header class="glow-bg overflow-hidden border-b border-[var(--color-line)]">
      <div class="wrap pt-6 pb-12 sm:pt-8 sm:pb-14">
        <Breadcrumbs
          items={[{ label: "Blog", href: "/blog" }, { label: d.title }]}
          class="mb-8"
        />

        <div class="flex flex-wrap items-center gap-3">
          <span class="chip">{d.category}</span>
          <time datetime={isoDate(d.date)} class="t-small">{formatDate(d.date)}</time>
          <span class="t-small" aria-hidden="true">·</span>
          <span class="t-small">{minutes} min di lettura</span>
        </div>

        <h1 class="t-h1 mt-5 max-w-4xl anim-rise">{d.title}</h1>
        <p class="t-lead mt-5 max-w-2xl anim-fade-rise delay-2">{d.excerpt}</p>
      </div>
    </header>

    <div class="wrap section">
      <div class="prose">
        <Content />
      </div>

      <!-- Firma -->
      <div class="prose-measure card mt-14 flex flex-col gap-4 bg-[var(--color-soft)] p-6 sm:flex-row sm:items-center">
        <span class="icon-tile bg-white shrink-0"><Icon name="message" size={20} /></span>
        <p class="t-body flex-1 !text-[0.9375rem]">
          Scritto da <strong class="font-semibold text-[var(--color-ink)]">{d.author}</strong>.
          Hai una domanda su questo argomento?
        </p>
        <a href="/contatti" class="btn btn-primary shrink-0 !py-2.5 !text-[0.875rem]">
          Scrivici
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="band-soft section">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 class="t-h2">
              Continua <span class="t-dim">a leggere.</span>
            </h2>
            <a href="/blog" class="link-arrow pb-1">
              Tutti gli articoli
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((a) => (
              <ArticleCard entry={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    badge="Parliamone"
    title='Ti serve una mano <span class="t-dim">su questo?</span>'
    lead="Se l'argomento dell'articolo riguarda un problema che hai adesso, scrivici: ti diciamo cosa faremmo noi, anche se la risposta è che non ti serve niente."
  />
</Base>

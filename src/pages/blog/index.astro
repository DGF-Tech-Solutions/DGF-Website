---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { SITE } from "@/data/site";

const articles = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const schema = {
  "@type": "Blog",
  name: `Blog — ${SITE.name}`,
  url: `${SITE.url}/blog`,
  publisher: { "@id": `${SITE.url}/#organization` },
  blogPost: articles.map((a) => ({
    "@type": "BlogPosting",
    headline: a.data.title,
    description: a.data.excerpt,
    datePublished: a.data.date.toISOString(),
    url: `${SITE.url}/blog/${a.id}`,
  })),
};
---

<Base
  title="Blog"
  description="Guide e ragionamenti su siti web, e-commerce, software e intelligenza artificiale. Le domande che ci fanno più spesso, con la risposta lunga."
  canonical="/blog"
  schema={schema}
>
  <PageHeader
    index="003"
    label="Scritti"
    title="Quello che spieghiamo ai clienti"
    lead="Le domande che ci arrivano più spesso, con la risposta estesa che durante una chiamata non c'è tempo di dare."
    crumbs={[{ label: "Blog" }]}
  />

  <section class="section">
    <div class="wrap">
      {
        articles.length > 0 ? (
          <div>
            {/* as="h2": sopra c'è solo l'h1 della testata. */}
            {articles.map((entry, i) => (
              <ArticleCard entry={entry} index={i} as="h2" />
            ))}
          </div>
        ) : (
          <p class="t-lead">Non ci sono ancora articoli pubblicati.</p>
        )
      }

      <div class="mt-16 border-t border-[var(--color-hairline)] pt-10">
        <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
          <div>
            <h2 class="t-h3">Hai una domanda che qui non trovi?</h2>
            <p class="t-body mt-2 max-w-xl">
              Scrivicela. Se è utile anche ad altri, probabilmente diventerà il
              prossimo articolo.
            </p>
          </div>
          <a href="/contatti" class="btn btn-ghost shrink-0">Fai la tua domanda</a>
        </div>
      </div>
    </div>
  </section>
</Base>

---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Explorer from "@/components/Explorer.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";
import illustration from "@/assets/illustrazioni/scena-blog.png";

const articles = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/* Categorie con il conteggio, ordinate per frequenza: i chip li costruiamo
   dai contenuti reali, non da un elenco scritto a mano che poi diverge. */
const counts = new Map<string, number>();
for (const a of articles) {
  counts.set(a.data.category, (counts.get(a.data.category) ?? 0) + 1);
}
const categories = [...counts.entries()]
  .map(([label, count]) => ({ label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const schema = {
  "@type": "Blog",
  name: `Blog — ${SITE.name}`,
  url: `${SITE.url}/blog`,
  publisher: { "@id": `${SITE.url}/#organization` },
  blogPost: articles.map((a) => ({
    "@type": "BlogPosting",
    headline: a.data.title,
    description: a.data.excerpt,
    datePublished: a.data.date.toISOString(),
    url: `${SITE.url}/blog/${a.id}`,
  })),
};
---

<Base
  title="Blog"
  description="Guide e ragionamenti su siti web, e-commerce, software e intelligenza artificiale. Le domande che ci fanno più spesso, con la risposta lunga."
  canonical="/blog"
  schema={schema}
>
  <PageHeader
    eyebrow="Dal blog"
    title='Quello che spieghiamo <span class="t-dim">ai clienti.</span>'
    lead="Le domande che ci arrivano più spesso, con la risposta estesa che durante una chiamata non c'è tempo di dare."
    crumbs={[{ label: "Blog" }]}
    illustration={illustration}
    illustrationAlt="Illustrazione: scrivania con laptop, appunti e caffè"
  />

  <section class="section">
    <div class="wrap">
      {
        articles.length > 0 ? (
          <Explorer
            placeholder="Cerca fra gli articoli…"
            label="Cerca fra gli articoli"
            categories={categories}
            noun="articolo"
          >
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {articles.map((entry) => (
                <ArticleCard entry={entry} as="h2" />
              ))}
            </div>
          </Explorer>
        ) : (
          <p class="t-lead text-center">Non ci sono ancora articoli pubblicati.</p>
        )
      }

      <div class="card mt-16 flex flex-col items-center gap-5 bg-[var(--color-soft)] px-6 py-10 text-center">
        <span class="icon-tile bg-white"><Icon name="message" size={22} /></span>
        <h2 class="t-h2 max-w-xl !text-[1.75rem]">
          Hai una domanda <span class="t-dim">che qui non trovi?</span>
        </h2>
        <p class="t-body max-w-xl">
          Scrivicela. Se è utile anche ad altri, probabilmente diventerà il
          prossimo articolo.
        </p>
        <a href="/contatti" class="btn btn-primary">
          Fai la tua domanda
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</Base>

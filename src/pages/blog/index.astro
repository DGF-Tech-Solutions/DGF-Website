---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import HeroBand from "@/components/HeroBand.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Explorer from "@/components/Explorer.astro";
import CtaBand from "@/components/CtaBand.astro";
import { SITE } from "@/data/site";
import illustration from "@/assets/foto/blog.webp";

const articles = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/* Categorie con il conteggio, ordinate per frequenza: i chip li costruiamo
   dai contenuti reali, non da un elenco scritto a mano che poi diverge. */
const counts = new Map<string, number>();
for (const a of articles) {
  counts.set(a.data.category, (counts.get(a.data.category) ?? 0) + 1);
}
const categories = [...counts.entries()]
  .map(([label, count]) => ({ label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const totalLabel = `${articles.length} ${articles.length === 1 ? "articolo" : "articoli"}`;

const schema = {
  "@type": "Blog",
  name: `Blog | ${SITE.name}`,
  url: `${SITE.url}/blog`,
  publisher: { "@id": `${SITE.url}/#organization` },
  blogPost: articles.map((a) => ({
    "@type": "BlogPosting",
    headline: a.data.title,
    description: a.data.excerpt,
    datePublished: a.data.date.toISOString(),
    url: `${SITE.url}/blog/${a.id}`,
  })),
};
---

<Base
  title="Blog"
  description="Guide e ragionamenti su siti web, e-commerce, software e intelligenza artificiale. Le domande che ci fanno più spesso, con la risposta lunga."
  canonical="/blog"
  schema={schema}
  navSolid
>
  <HeroBand
    badge="Blog"
    badgeIcon="message"
    title='Quello che spieghiamo <span class="t-dim">ai clienti.</span>'
    lead="Le domande che ci arrivano più spesso, con la risposta estesa che in una chiamata non c'è tempo di dare."
    crumbs={[{ label: "Blog" }]}
    illustration={illustration}
    illustrationAlt="Una mano scrive su un taccuino accanto a un portatile e una tazza"
    illustrationAi
    cta={{ label: "Parliamo del tuo progetto", href: "/contatti" }}
  />

  <section class="section">
    <div class="wrap">
      {
        articles.length > 0 ? (
          <Explorer
            placeholder="Cerca fra gli articoli…"
            label="Cerca fra gli articoli"
            categories={categories}
            noun="articolo"
          >
            {/* Il conteggio sta dentro lo slot dell'Explorer, sopra la griglia:
                è la stessa riga di riepilogo di Nexia. Resta statico (mostra il
                totale) perché il filtro ha già il suo messaggio di elenco vuoto. */}
            <p class="t-small mb-5">{totalLabel}</p>

            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {articles.map((entry) => (
                <ArticleCard entry={entry} as="h2" />
              ))}
            </div>
          </Explorer>
        ) : (
          <p class="t-lead text-center">Non ci sono ancora articoli pubblicati.</p>
        )
      }
    </div>
  </section>

  <CtaBand
    badge="Domande"
    title='Hai una domanda <span class="t-dim">che qui non trovi?</span>'
    lead="Scrivicela. Se possiamo risponderti lo facciamo, e se è utile anche ad altri probabilmente diventerà il prossimo articolo."
  />
</Base>

---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CaseCard from "@/components/CaseCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const related = (await getCollection("portfolio"))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const isDemo = d.kind === "dimostrativo";

/*
 * Le "metriche" di un progetto dimostrativo non sono risultati misurati ma
 * obiettivi progettuali: il titolo della sezione cambia di conseguenza,
 * perché chiamarli "risultati" sarebbe falso.
 */
const metricsTitle = isDemo ? "Obiettivi di progetto" : "Risultati";

const schema = {
  "@type": "CreativeWork",
  name: d.title,
  abstract: d.summary,
  url: `${SITE.url}/portfolio/${entry.id}`,
  creator: { "@id": `${SITE.url}/#organization` },
  dateCreated: d.year,
  genre: d.category,
  keywords: [...d.services, ...d.stack].join(", "),
};
---

<Base
  title={d.title}
  description={d.summary}
  canonical={`/portfolio/${entry.id}`}
  schema={schema}
>
  <!-- Testata -->
  <section class="glow-bg overflow-hidden border-b border-[var(--color-line)]">
    <div class="wrap pt-6 pb-12 sm:pt-8 sm:pb-14">
      <Breadcrumbs
        items={[{ label: "Progetti", href: "/portfolio" }, { label: d.client }]}
        class="mb-8"
      />

      <div class="flex flex-wrap items-center gap-3">
        <span class="chip">{d.category}</span>
        <span class="t-small tabular">{d.year}</span>
      </div>

      <h1 class="t-h1 mt-4 max-w-4xl anim-rise">{d.title}</h1>
      <p class="t-lead mt-5 max-w-2xl anim-fade-rise delay-2">{d.summary}</p>

      {
        isDemo && (
          <p class="notice mt-7">
            <Icon name="shield" size={17} class="mt-0.5 shrink-0 text-[var(--color-navy)]" />
            <span>
              <strong class="font-semibold text-[var(--color-ink)]">Progetto dimostrativo.</strong>{" "}
              Studio realizzato internamente per mostrare metodo e capacità
              tecniche. Il committente è di fantasia e i dati riportati sono
              obiettivi progettuali, non risultati commerciali misurati.
            </span>
          </p>
        )
      }

      <!-- Scheda tecnica -->
      <dl class="mt-9 grid gap-4 sm:grid-cols-3">
        <div class="card p-5">
          <dt class="t-eyebrow">Committente</dt>
          <dd class="t-h3 mt-2">{d.client}</dd>
        </div>
        <div class="card p-5">
          <dt class="t-eyebrow">Servizi</dt>
          <dd class="t-body mt-2 text-[0.875rem]">{d.services.join(", ")}</dd>
        </div>
        <div class="card p-5">
          <dt class="t-eyebrow">Tecnologie</dt>
          <dd class="mt-2 flex flex-wrap gap-1.5">
            {d.stack.map((t) => <span class="chip chip-line !text-[0.6875rem]">{t}</span>)}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Immagine principale -->
  <section class="band-soft">
    <div class="wrap py-10 sm:py-14">
      {/*
        Caricamento pigro: su mobile la testata riempie tutto il primo
        schermo, quindi questa immagine è sotto la piega. Marcarla prioritaria
        le farebbe rubare banda al testo che l'utente sta leggendo.
      */}
      <div class="overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-line)] shadow-[var(--shadow-lg)]">
        <Image
          src={d.coverFull ?? d.cover}
          alt={`Interfaccia del progetto ${d.client}`}
          widths={[420, 640, 840, 1100, 1400]}
          sizes="(min-width: 1280px) 1160px, 94vw"
          loading="lazy"
          class="w-full"
        />
      </div>
    </div>
  </section>

  <!-- Problema / approccio / soluzione -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div>
          <span class="t-eyebrow">Il problema</span>
          <p class="t-lead mt-3 !text-[var(--color-ink)]">{d.challenge}</p>

          <div class="mt-12">
            <span class="t-eyebrow">L'approccio</span>
            <ol class="mt-5 space-y-3">
              {
                d.approach.map((step, i) => (
                  <li class="card group flex items-start gap-4 p-5 reveal">
                    <span class="icon-tile icon-tile-sm !text-[0.8125rem] font-bold">
                      {i + 1}
                    </span>
                    <span class="t-body pt-1">{step}</span>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="mt-12">
            <span class="t-eyebrow">La soluzione</span>
            <p class="t-lead mt-3 !text-[var(--color-ink)]">{d.solution}</p>
          </div>
        </div>

        {
          d.metrics.length > 0 && (
            <aside>
              <div class="card bg-[var(--color-soft)] p-7 lg:sticky lg:top-24">
                <h2 class="t-eyebrow">{metricsTitle}</h2>
                <dl class="mt-6 space-y-5">
                  {d.metrics.map((m) => (
                    <div class="border-t border-[color-mix(in_srgb,var(--color-navy)_15%,transparent)] pt-4 first:border-0 first:pt-0">
                      <dt class="t-h2 tabular !text-[1.75rem]">{m.value}</dt>
                      <dd class="t-small mt-1">{m.label}</dd>
                    </div>
                  ))}
                </dl>
                {isDemo && (
                  <p class="t-small mt-6 border-t border-[color-mix(in_srgb,var(--color-navy)_15%,transparent)] pt-4">
                    Obiettivi definiti in fase di progetto, non misurazioni su
                    traffico reale.
                  </p>
                )}
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </section>

  <!-- Approfondimento -->
  <section class="band-soft section">
    <div class="wrap">
      <span class="t-eyebrow">In dettaglio</span>
      <div class="prose mt-6">
        <Content />
      </div>
    </div>
  </section>

  <!-- Correlati -->
  {
    related.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 class="t-h2">
              Altri <span class="t-dim">progetti.</span>
            </h2>
            <a href="/portfolio" class="link-arrow pb-1">
              Tutti i progetti
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <CaseCard entry={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    badge="Un progetto simile"
    title='Hai in mente <span class="t-dim">qualcosa di simile?</span>'
    lead="Raccontaci il tuo caso: ti diciamo se e come lo faremmo, con tempi e costi messi per iscritto prima di iniziare."
  />
</Base>

<style>
  .notice {
    display: flex;
    gap: 0.75rem;
    max-width: 44rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-soft);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-3);
  }
</style>

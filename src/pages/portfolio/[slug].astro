---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CaseCard from "@/components/CaseCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Faq from "@/components/Faq.astro";
import Icon from "@/components/Icon.astro";
import Toc from "@/components/Toc.astro";
import { SITE } from "@/data/site";
import { readingMinutes } from "@/lib/format";
import { kindLabel } from "@/lib/project";
import { stripInlineLinks } from "@/lib/inline-links";

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

const related = (await getCollection("portfolio"))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const isDemo = d.kind === "dimostrativo";

/*
 * Le "metriche" di un progetto dimostrativo non sono risultati misurati ma
 * obiettivi progettuali: il titolo della sezione cambia di conseguenza,
 * perché chiamarli "risultati" sarebbe falso.
 */
const metricsTitle = isDemo ? "Obiettivi di progetto" : "Il progetto in numeri";

const minutes = readingMinutes(
  `${d.challenge} ${d.approach.join(" ")} ${d.solution} ${entry.body ?? ""}`,
);

/*
 * Indice: le tre sezioni fisse più i titoli del markdown, più le domande se
 * ci sono. Gli `id` dei titoli del markdown li assegna Astro da sé; quelli
 * delle sezioni fisse sono scritti qui sotto e devono restare uguali.
 */
const tocItems = [
  { slug: "problema", text: "Il problema" },
  { slug: "approccio", text: "L'approccio" },
  { slug: "soluzione", text: "La soluzione" },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  ...(d.faq.length > 0 ? [{ slug: "domande", text: "Domande frequenti" }] : []),
];

/*
 * Lo schema FAQ va costruito QUI e non dentro il componente `Faq`.
 *
 * `Faq.astro` aveva una prop `schema` che nessuno dei due chiamanti passava:
 * il JSON-LD che il componente sa costruire non è mai uscito, e questa pagina
 * — l'unica con domande frequenti oltre alle schede servizio — non ne
 * pubblicava nessuno. Stessa forma del difetto per cui la dichiarazione AI
 * Act non usciva su /blog e /portfolio: una funzionalità che esiste e che
 * nessuno accende.
 *
 * Il posto giusto è il grafo di `Base`, dove sta già tutto il resto: un
 * secondo blocco JSON-LD emesso in mezzo al corpo, con un `@context` suo,
 * sarebbe una seconda sorgente per la stessa informazione.
 */
const schema = [
  {
    "@type": "CreativeWork",
    name: d.title,
    abstract: d.summary,
    url: `${SITE.url}/portfolio/${entry.id}`,
    creator: { "@id": `${SITE.url}/#organization` },
    dateCreated: d.year,
    genre: d.category,
    keywords: [...d.services, ...d.stack].join(", "),
  },
  ...(d.faq.length > 0
    ? [
        {
          "@type": "FAQPage",
          mainEntity: d.faq.map((f) => ({
            "@type": "Question",
            name: f.q,
            // Senza markup: nei dati strutturati deve arrivare la frase e basta.
            acceptedAnswer: { "@type": "Answer", text: stripInlineLinks(f.a) },
          })),
        },
      ]
    : []),
];
---

<Base
  title={d.title}
  description={d.summary}
  canonical={`/portfolio/${entry.id}`}
  schema={schema}
>
  <!-- ══════════════════════════════════════════════════════════════════
       TESTATA
       ══════════════════════════════════════════════════════════════════ -->
  <section class="band-brand under-nav">
    <div class="wrap relative z-10 pt-6 pb-12 sm:pt-8 sm:pb-16">
      <Breadcrumbs
        items={[{ label: "Progetti", href: "/portfolio" }, { label: d.client }]}
        class="mb-8"
      />

      {/* Al testo va la colonna più larga: il titolo di un caso è una frase
          intera, e in una colonna stretta si spezza su quattro righe che da
          sole riempiono il primo schermo. */}
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
        <div>
          <span class="badge-brand">{d.category}</span>

          {/* Titolo più contenuto del `.t-h1` di sistema: i titoli dei casi
              sono frasi lunghe, e a 56px andrebbero su tre righe occupando da
              soli il primo schermo. A 44px stanno su due, come sulle guide. */}
          <h1 class="case-title mt-5 anim-rise">{d.title}</h1>
          <p class="t-lead mt-5 anim-fade-rise delay-2">{d.summary}</p>

          <!-- Metadati sotto il sommario, non sopra il titolo: la prima cosa
               che si legge dev'essere di cosa si parla, non quanto è lungo. -->
          <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="t-small inline-flex items-center gap-1.5">
              <Icon name="clock" size={14} />
              {minutes} min di lettura
            </span>
            <span class="t-small" aria-hidden="true">·</span>
            <span class="t-small tabular">{d.year}</span>
            <span class="t-small" aria-hidden="true">·</span>
            <span class="t-small">{kindLabel(d.kind, d.client)}</span>
          </div>

          {/* Il progetto è online: il pulsante ci porta. Su un caso di studio
              è la prova più forte che esista, più di qualunque schermata.
              `rel="noopener"` perché apre una scheda nuova. */}
          {
            d.liveUrl && (
              <a
                href={d.liveUrl}
                target="_blank"
                rel="noopener"
                class="btn btn-on-dark mt-8"
              >
                {d.liveLabel ?? "Vedi il progetto online"}
                <Icon name="arrow-up-right" size={16} />
              </a>
            )
          }

          {
            isDemo && (
              <p class="notice mt-7">
                <Icon name="shield" size={17} class="mt-0.5 shrink-0 text-[var(--color-cyan)]" />
                <span>
                  <strong class="font-semibold text-[var(--color-ink)]">Progetto dimostrativo.</strong>{" "}
                  Studio realizzato internamente per mostrare metodo e capacità
                  tecniche. Il committente è di fantasia e i dati riportati sono
                  obiettivi progettuali, non risultati commerciali misurati.
                </span>
              </p>
            )
          }

        </div>

        <!--
          La schermata del prodotto accanto al titolo, non relegata sotto:
          su un caso di studio è l'unica prova che il software esista, e
          messa qui la si vede senza scorrere.

          Sta sopra la piega, quindi si carica subito ed è l'elemento che
          Chrome misura come LCP. Per la stessa ragione il contenitore si
          anima solo in `transform`: una dissolvenza lascerebbe il posto
          vuoto proprio mentre la metrica viene rilevata.
        -->
        <figure class="case-shot anim-rise">
          <Image
            src={d.coverFull ?? d.cover}
            alt={`Interfaccia del progetto ${d.client}`}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1280px) 620px, (min-width: 1024px) 48vw, 92vw"
            loading="eager"
            fetchpriority="high"
            class="w-full"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       I NUMERI
       ══════════════════════════════════════════════════════════════════ -->
  {
    d.metrics.length > 0 && (
      <section class="band-soft">
        <div class="wrap py-12 sm:py-16">
          <h2 class="t-eyebrow text-center">{metricsTitle}</h2>
          {/* Niente `reveal` qui: con la testata più corta questa fascia
              arriva a ridosso della piega, e una dissolvenza in corso viene
              misurata come testo a basso contrasto. È la stessa regola
              annotata in global.css: le animazioni di comparsa solo sotto la
              piega, senza eccezioni da ricordare a memoria. */}
          <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {d.metrics.map((m) => (
              <div class="card p-6 text-center">
                <dt class="t-h2 tabular !text-[2rem]">{m.value}</dt>
                <dd class="t-small mt-2">{m.label}</dd>
              </div>
            ))}
          </dl>
          {isDemo && (
            <p class="t-small mt-5 text-center">
              Obiettivi definiti in fase di progetto, non misurazioni su
              traffico reale.
            </p>
          )}
        </div>
      </section>
    )
  }

  <!-- ══════════════════════════════════════════════════════════════════
       CORPO — colonna unica, larga quanto il resto della pagina
       ══════════════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="case-body">
        <Toc items={tocItems} />

        <div class="prose !max-w-none">
          <h2 id="problema">Il problema</h2>
          <p>{d.challenge}</p>

          <h2 id="approccio">L'approccio</h2>
          {/* Elenco numerato: lo stile a schede con il tondo numerato arriva
              da `.prose ol`, lo stesso che ottiene chi scrive "1." nel corpo
              del testo dal pannello. Una regola sola, due usi. */}
          <ol>
            {d.approach.map((step) => <li>{step}</li>)}
          </ol>

          <h2 id="soluzione">La soluzione</h2>
          <p>{d.solution}</p>

          <Content />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       DOMANDE FREQUENTI
       ══════════════════════════════════════════════════════════════════ -->
  {
    d.faq.length > 0 && (
      <section id="domande" class="band-soft section">
        <div class="wrap">
          <div class="mx-auto max-w-2xl text-center">
            <span class="t-eyebrow">Domande frequenti</span>
            <h2 class="t-h2 mt-3">
              Tutto quello che <span class="t-dim">vuoi sapere.</span>
            </h2>
          </div>
          <div class="mx-auto mt-12 max-w-3xl">
            <Faq items={d.faq} />
          </div>
          <p class="t-small mx-auto mt-8 max-w-md text-center">
            Non trovi la risposta? Ti rispondiamo di persona, di solito entro un
            giorno lavorativo.
          </p>
        </div>
      </section>
    )
  }

  <!-- ══════════════════════════════════════════════════════════════════
       CORRELATI

       La fascia azzurra qui NON è decorativa, è la regola dell'alternanza
       (global.css, `.band-soft`: mai due fondi uguali di fila).

       Questa sezione è preceduta da un'altra sezione bianca, e in mezzo c'è
       solo il blocco delle domande — che è condizionale. Una scheda progetto
       senza `faq` ma con progetti fratelli avrebbe prodotto due bianchi
       attaccati: nessun filetto, nessun cambio di colore e due padding
       impilati, fino a 14rem di vuoto. Non si vedeva perché oggi in
       `src/content/portfolio/` c'è una scheda sola, che ha le faq e non ha
       fratelli — quindi questa sezione non viene proprio renderizzata.
       ══════════════════════════════════════════════════════════════════ -->
  {
    related.length > 0 && (
      <section class="band-soft section">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 class="t-h2">
              Altri <span class="t-dim">progetti.</span>
            </h2>
            <a href="/portfolio" class="link-arrow pb-1">
              Tutti i progetti
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <CaseCard entry={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    badge="Un progetto simile"
    title='Hai in mente <span class="t-dim">qualcosa di simile?</span>'
    lead="Raccontaci il tuo caso: ti diciamo se e come lo faremmo, con tempi e costi messi per iscritto prima di iniziare."
  />
</Base>

<style>
  /* Sta dentro la fascia blu: il fondo azzurro chiaro del resto del sito qui
     sparirebbe, quindi è un velo di bianco sul blu. */
  .notice {
    display: flex;
    gap: 0.75rem;
    max-width: 44rem;
    margin-top: 1.75rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.1);
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.78);
  }

  /*
   * Titolo del caso. Più contenuto del `.t-h1` di sistema, che arriva a 56px:
   * i titoli dei progetti sono frasi intere e a quella misura riempiono da
   * soli il primo schermo, lasciando fuori il sommario che spiega di cosa si
   * tratta.
   */
  .case-title {
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.028em;
    font-weight: 800;
    color: var(--color-ink);
  }

  /* Cornice della schermata del prodotto. */
  .case-shot {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    background: var(--color-paper);
    box-shadow: var(--shadow-lg);
  }

  /* Nessun limite di larghezza: indice e testo arrivano ai bordi del
     contenitore, gli stessi delle schede dei numeri qui sopra. Prima erano
     una colonna da 42rem centrata, che lasciava due fasce vuote ai lati e non
     allineava i propri bordi con nessun altro elemento della pagina. */
  .case-body > :global(.prose) { margin-top: 3rem; }

  /* L'ancora dell'indice non deve finire sotto la barra in alto. */
  .case-body :global(h2) { scroll-margin-top: 6rem; }
</style>

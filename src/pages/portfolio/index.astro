---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import CaseCard from "@/components/CaseCard.astro";
import Banner from "@/components/Banner.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";
import illustration from "@/assets/illustrazioni/scena-progetti.png";

const projects = (await getCollection("portfolio")).sort(
  (a, b) => a.data.order - b.data.order,
);

/* Quanti sono lavori realmente commissionati. Oggi: zero — e il sito lo dice
   invece di lasciarlo intuire. Il giorno che ce ne sarà uno, basta mettere
   `kind: cliente` nel suo file e il banner cambia da solo. */
const clientProjects = projects.filter((p) => p.data.kind === "cliente").length;
const onlyDemos = clientProjects === 0;

const schema = {
  "@type": "CollectionPage",
  name: "Progetti — DGF Tech Solutions",
  url: `${SITE.url}/portfolio`,
  hasPart: projects.map((p) => ({
    "@type": "CreativeWork",
    name: p.data.title,
    abstract: p.data.summary,
    url: `${SITE.url}/portfolio/${p.id}`,
  })),
};
---

<Base
  title="Progetti"
  description="Studi di progetto realizzati da DGF Tech Solutions: e-commerce, gestionali, portali e siti. Problema, approccio e soluzione di ciascuno."
  canonical="/portfolio"
  schema={schema}
>
  <PageHeader
    eyebrow="I progetti"
    title='Cosa sappiamo <span class="t-dim">costruire.</span>'
    lead="Ogni scheda racconta un problema reale, le scelte fatte per risolverlo e come si è tradotto in software."
    crumbs={[{ label: "Progetti" }]}
    illustration={illustration}
    illustrationAlt="Illustrazione: un monitor con il layout di un sito"
  />

  <section class="section">
    <div class="wrap">
      {
        onlyDemos && (
          <Banner
            icon="shield"
            title="Siamo agli inizi, e preferiamo dirlo."
            class="mx-auto max-w-4xl reveal"
          >
            <p>
              <strong>
                Non abbiamo ancora progetti consegnati a clienti da mostrare.
              </strong>{" "}
              Quelli qui sotto sono <strong>studi che abbiamo realizzato noi</strong>,
              per intero, per far vedere come lavoriamo: come affrontiamo un
              problema, che scelte tecniche facciamo, che cosa consegneremmo.
            </p>
            <p class="mt-2.5">
              I committenti sono nomi di fantasia e i numeri indicati sono
              obiettivi di progetto, non risultati commerciali misurati. Il
              giorno che avremo lavori veri da mostrare, li troverai qui —
              etichettati come tali. Nel frattempo,
              <a href="/contatti">chiedici pure di parlarne a voce</a>.
            </p>
          </Banner>
        )
      }

      {/*
        La PRIMA scheda carica in `eager`: su mobile entra nel primo schermo
        e la sua immagine è l'elemento LCP. Le altre restano pigre.
      */}
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((entry, i) => (
            <div class="reveal" style={`--i:${i}`}>
              <CaseCard entry={entry} as="h2" eager={i === 0} />
            </div>
          ))
        }
      </div>

      <div class="card mt-16 flex flex-col items-center gap-5 bg-[var(--color-soft)] px-6 py-12 text-center">
        <span class="icon-tile bg-white"><Icon name="message" size={22} /></span>
        <h2 class="t-h2 max-w-xl !text-[1.75rem]">
          Vuoi vedere qualcosa <span class="t-dim">simile al tuo caso?</span>
        </h2>
        <p class="t-body max-w-xl">
          Scrivici il settore e il problema: ti mostriamo come lo affronteremmo,
          senza impegno e senza raccontarti storie.
        </p>
        <a href="/contatti" class="btn btn-primary btn-lg">
          Scrivici
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
    </div>
  </section>
</Base>

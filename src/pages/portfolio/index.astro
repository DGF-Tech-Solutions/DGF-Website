---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import HeroBand from "@/components/HeroBand.astro";
import CaseCard from "@/components/CaseCard.astro";
import Explorer from "@/components/Explorer.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";
import illustration from "@/assets/illustrazioni/scena-progetti.png";

const projects = (await getCollection("portfolio")).sort(
  (a, b) => a.data.order - b.data.order,
);

/* Categorie con il conteggio, ordinate per frequenza: i chip li costruiamo
   dai contenuti reali, non da un elenco scritto a mano che poi diverge. */
const counts = new Map<string, number>();
for (const p of projects) {
  counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
}
const categories = [...counts.entries()]
  .map(([label, count]) => ({ label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const totalLabel = `${projects.length} ${projects.length === 1 ? "progetto" : "progetti"}`;

const schema = {
  "@type": "CollectionPage",
  name: "Progetti — DGF Tech Solutions",
  url: `${SITE.url}/portfolio`,
  hasPart: projects.map((p) => ({
    "@type": "CreativeWork",
    name: p.data.title,
    abstract: p.data.summary,
    url: `${SITE.url}/portfolio/${p.id}`,
  })),
};
---

<Base
  title="Progetti"
  description="I progetti di DGF Tech Solutions, a partire da Nexia Home, il gestionale per amministratori di condominio che sviluppiamo e manteniamo. Problema, approccio e soluzione di ciascuno."
  canonical="/portfolio"
  schema={schema}
>
  <HeroBand
    badge="Progetti"
    badgeIcon="layers"
    title='Cosa sappiamo <span class="t-dim">costruire.</span>'
    lead="Ogni scheda racconta un problema reale, le scelte fatte per risolverlo e come si è tradotto in software."
    crumbs={[{ label: "Progetti" }]}
    illustration={illustration}
    illustrationAlt="Illustrazione: un monitor con il layout di un sito"
    cta={{ label: "Parliamo del tuo progetto", href: "/contatti" }}
  />

  <section class="section">
    <div class="wrap">
      {
        projects.length > 0 ? (
          <Explorer
            placeholder="Cerca un progetto, un settore o una tecnologia…"
            label="Cerca fra i progetti"
            categories={categories}
            noun="progetto"
          >
            {/* Il conteggio sta dentro lo slot dell'Explorer, sopra la griglia:
                è la stessa riga di riepilogo di Nexia. Resta statico (mostra il
                totale) perché il filtro ha già il suo messaggio di elenco vuoto. */}
            <p class="t-small mb-5">{totalLabel}</p>

            {/* Nessuna immagine in `eager`: su mobile la testata riempie il
                primo schermo e le schede restano sotto la piega. L'unica
                immagine prioritaria della pagina è quella della testata — due
                immagini prioritarie si contenderebbero la banda. */}
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {projects.map((entry) => (
                <CaseCard entry={entry} as="h2" />
              ))}
            </div>
          </Explorer>
        ) : (
          <p class="t-lead text-center">Non ci sono ancora progetti pubblicati.</p>
        )
      }

      <div class="card mt-16 flex flex-col items-center gap-5 bg-[var(--color-soft)] px-6 py-12 text-center">
        <span class="icon-tile bg-white"><Icon name="message" size={22} /></span>
        <h2 class="t-h2 max-w-xl !text-[1.75rem]">
          Vuoi vedere qualcosa <span class="t-dim">simile al tuo caso?</span>
        </h2>
        <p class="t-body max-w-xl">
          Scrivici il settore e il problema: ti mostriamo come lo affronteremmo,
          senza impegno e senza raccontarti storie.
        </p>
        <a href="/contatti" class="btn btn-primary btn-lg">
          Scrivici
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
    </div>
  </section>
</Base>

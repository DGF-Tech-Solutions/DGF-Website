---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import CaseCard from "@/components/CaseCard.astro";
import { SITE } from "@/data/site";

const projects = (await getCollection("portfolio")).sort(
  (a, b) => a.data.order - b.data.order,
);

const hasDemo = projects.some((p) => p.data.kind === "dimostrativo");

const schema = {
  "@type": "CollectionPage",
  name: "Progetti — DGF Tech Solutions",
  url: `${SITE.url}/portfolio`,
  hasPart: projects.map((p) => ({
    "@type": "CreativeWork",
    name: p.data.title,
    abstract: p.data.summary,
    url: `${SITE.url}/portfolio/${p.id}`,
  })),
};
---

<Base
  title="Progetti"
  description="Progetti dimostrativi di DGF Tech Solutions: e-commerce, gestionali, portali e siti. Problema, approccio e soluzione di ciascuno."
  canonical="/portfolio"
  schema={schema}
>
  <PageHeader
    index="002"
    label="Progetti"
    title="Cosa sappiamo costruire"
    lead="Ogni scheda racconta un problema reale, le scelte fatte per risolverlo e come si è tradotto in software."
    crumbs={[{ label: "Progetti" }]}
  />

  {
    hasDemo && (
      <section class="border-b border-[var(--color-hairline)] bg-[var(--color-paper-2)]">
        <div class="wrap py-6">
          {/*
            Nota di trasparenza. Presentare un concept come lavoro su commessa
            è una scorciatoia che si paga al primo cliente che chiede referenze:
            meglio dirlo in chiaro, in cima alla pagina.
          */}
          <p class="t-small max-w-3xl">
            <strong class="text-[var(--color-ink)]">Nota.</strong> I progetti
            contrassegnati come <em>dimostrativi</em> sono studi che abbiamo
            realizzato per mostrare metodo e capacità tecniche. Non sono lavori
            su commessa e i nomi dei committenti sono di fantasia. Le schede
            descrivono scelte progettuali reali, non risultati commerciali
            ottenuti.
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {/*
          `as="h2"`: sopra le schede c'è solo l'h1 della testata, quindi
          partire da h3 salterebbe un livello.

          La PRIMA scheda carica in `eager`: a differenza della home, qui la
          testata è corta e su mobile (viewport 823px) la scheda entra nel
          primo schermo. La sua immagine diventa quindi l'elemento LCP, e
          lasciarla pigra la faceva partire tardi. Le altre restano pigre.
        */}
        {projects.map((entry, i) => <CaseCard entry={entry} as="h2" eager={i === 0} />)}
      </div>

      <div class="mt-16 border-t border-[var(--color-hairline)] pt-10">
        <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
          <div>
            <h2 class="t-h3">Vuoi vedere qualcosa di simile al tuo caso?</h2>
            <p class="t-body mt-2 max-w-xl">
              Scrivici il settore e il problema: ti mostriamo come lo affronteremmo,
              senza impegno.
            </p>
          </div>
          <a href="/contatti" class="btn btn-primary shrink-0">
            Scrivici
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

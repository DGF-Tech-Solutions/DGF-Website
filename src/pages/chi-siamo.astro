---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Banner from "@/components/Banner.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";
import illustration from "@/assets/foto/chi-siamo.webp";
import scenaProcesso from "@/assets/foto/processo.webp";

/*
 * Chi siamo, riscritta.
 *
 * La versione precedente era una sequenza di elenchi: principi, team, dati.
 * Corretta ma piatta, e soprattutto non rispondeva alla domanda che si fa
 * davvero chi arriva qui — "posso fidarmi di voi?".
 *
 * Adesso la pagina è costruita su quella domanda: prima cosa siamo (e cosa
 * NON siamo, detto in chiaro), poi come lavoriamo, poi chi siamo di persona,
 * infine i dati verificabili. L'onestà sul fatto che siamo agli inizi non è
 * nascosta in fondo: è il secondo blocco.
 */

/* Senza nomi e cognomi: chi arriva qui deve capire con quante persone parlerà
   e di cosa si occupano, non archiviare i nostri dati anagrafici. I nomi
   restano dove servono davvero, cioè nei documenti e nella conversazione. */
const TEAM = [
  {
    role: "Co-fondatore",
    focus: "AI e automazione",
    icon: "sparkles",
  },
  {
    role: "Co-fondatore",
    focus: "Sviluppo e architettura",
    icon: "dashboard",
  },
  {
    role: "Co-fondatore",
    focus: "Prodotto e design",
    icon: "layers",
  },
] as const;

/* Quello che siamo, accanto a quello che non siamo. Le due colonne insieme
   dicono più di qualsiasi elenco di valori. */
const SIAMO = [
  "Tre persone che scrivono codice ogni giorno, non un'agenzia che smista lavori",
  "Un interlocutore solo: chi ti risponde al primo messaggio è chi scriverà il tuo codice",
  "Cifra, tempi e cosa è incluso: nero su bianco prima di iniziare, non a metà progetto",
  "Capaci di dirti «non ti serve»: se una scheda Google basta, non ti vendiamo un gestionale",
];
const NON_SIAMO = [
  "Non siamo la software house con cento loghi in home: quello che mostriamo l'abbiamo costruito davvero",
  "Non rivendiamo un tema comprato a sessanta euro chiamandolo «design su misura»",
  "Non ti leghiamo: codice, dominio e accessi sono tuoi, e puoi andartene quando vuoi",
  "Non accettiamo progetti che non sapremmo portare in fondo, nemmeno quando i soldi farebbero comodo",
];

const PRINCIPLES = [
  {
    icon: "users",
    title: "Parli con chi scrive il codice",
    text: "Nessuna catena di intermediari. Dal primo confronto al lancio segui sempre le stesse persone: quelle che progettano e sviluppano davvero il prodotto.",
  },
  {
    icon: "file",
    title: "Trasparenza prima di tutto",
    text: "Tempi, costi e scelte tecniche messi per iscritto prima di iniziare. Nessuna voce a sorpresa in corso d'opera, nessun preventivo generato da un modulo.",
  },
  {
    icon: "shield",
    title: "Codice che dura",
    text: "Scriviamo software manutenibile, veloce e sicuro. Quello che costruiamo deve reggere fra tre anni, non solo il giorno della consegna.",
  },
  {
    icon: "package",
    title: "Dall'idea al lancio",
    text: "Strategia, design, sviluppo e messa online: un unico interlocutore per tutto il percorso, e reperibilità anche dopo la consegna.",
  },
] as const;

const schema = {
  "@type": "AboutPage",
  name: `Chi siamo | ${SITE.name}`,
  url: `${SITE.url}/chi-siamo`,
  mainEntity: { "@id": `${SITE.url}/#organization` },
};
---

<Base
  title="Chi siamo"
  description="DGF Tech Solutions è una software house a Messina, attiva in tutta Italia. Tre persone, nessun intermediario: dall'idea al lancio lavori con chi scrive il codice."
  canonical="/chi-siamo"
  schema={schema}
>
  <PageHeader
    eyebrow="Chi siamo"
    title='Tre persone, <span class="t-dim">nessun intermediario.</span>'
    lead="Siamo una software house con base a Messina, al lavoro con clienti in tutta Italia. Piccoli abbastanza da rispondere noi al telefono, strutturati abbastanza da portare a casa un progetto."
    crumbs={[{ label: "Chi siamo" }]}
    illustration={illustration}
    illustrationAlt="Un tavolo con due sedie e un portatile davanti a una vetrata"
    illustrationAi
  />

  <!-- ══════════════════════════════════════════════════════════════════
       COSA SIAMO / COSA NON SIAMO
       ══════════════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-5 lg:grid-cols-2">
        <div class="card p-7 lg:p-9 reveal-left">
          <span class="icon-tile"><Icon name="check" size={22} /></span>
          <h2 class="t-h2 mt-5 !text-[1.625rem]">Quello che siamo</h2>
          <ul class="mt-6 space-y-3.5">
            {
              SIAMO.map((s) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size={17} class="mt-1 shrink-0 text-[var(--color-navy)]" />
                  <span class="text-[0.9375rem] leading-relaxed text-[var(--color-ink-2)]">{s}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card bg-[var(--color-paper-2)] p-7 lg:p-9 reveal-right">
          <span class="icon-tile !bg-white"><Icon name="search" size={22} /></span>
          <h2 class="t-h2 mt-5 !text-[1.625rem]">Quello che non siamo</h2>
          <ul class="mt-6 space-y-3.5">
            {
              NON_SIAMO.map((s) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-px w-3.5 shrink-0 bg-[var(--color-ink-3)]" aria-hidden="true" />
                  <span class="text-[0.9375rem] leading-relaxed text-[var(--color-ink-3)]">{s}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <Banner
        icon="message"
        title="Siamo all'inizio, e non lo nascondiamo."
        class="mx-auto mt-8 max-w-4xl reveal"
      >
        <p>
          L'azienda è giovane e il portfolio è corto: è un fatto, non un
          segreto. Quello che c'è, però, è vero: <a href="/portfolio/nexia-home">Nexia Home</a>,
          il gestionale per amministratori di condominio che abbiamo progettato,
          scritto e che teniamo in produzione ogni giorno — un sistema completo,
          non una demo. Se cerchi vent'anni di referenze, non siamo noi. Se
          cerchi tre persone che sul tuo progetto si giocano tutta la
          reputazione che devono ancora costruirsi, parliamone.
        </p>
      </Banner>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       STORIA + METODO
       ══════════════════════════════════════════════════════════════════ -->
  <section class="band-soft section">
    <div class="wrap">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <span class="t-eyebrow">L'origine</span>
          <h2 class="t-h2 mt-3">
            Nati per fare le cose <span class="t-dim">sul serio.</span>
          </h2>
          <div class="prose mt-6 !max-w-none">
            <p>
              DGF nasce da un'osservazione fatta da vicino: le piccole imprese
              italiane il software lo pagano due volte. La prima quando lo
              comprano, la seconda quando scoprono che nessuno risponde più.
              Siti lenti, gestionali improvvisati, fornitori spariti — non è
              sfortuna: è il modello di chi vende e passa al cliente successivo.
            </p>
            <p>
              Noi siamo costruiti al contrario: pochi progetti alla volta,
              seguiti dalla prima riga di codice al lancio, e reperibili dopo.
              Quando scrivi ti risponde una delle tre persone che il tuo
              prodotto lo sta costruendo — non un commerciale che «gira la
              richiesta al tecnico».
            </p>
            <p>
              E una regola sola: ogni scelta tecnica deve avere una ragione
              spiegabile in italiano corrente. Se non sappiamo spiegartela, è
              la scelta sbagliata.
            </p>
          </div>
        </div>

        {/* `<Image>` e non `<img>`: così Astro la converte e la ridimensiona.
            Con il tag grezzo veniva servito il PNG originale da mezzo mega,
            ed era il motivo per cui questa pagina pesava il quadruplo delle
            altre. */}
        <div class="parallax-slow mx-auto w-full max-w-[22rem] lg:max-w-none">
          <Image
            src={scenaProcesso}
            alt="Due persone davanti a una lavagna con foglietti adesivi e frecce"
            widths={[320, 460, 620]}
            sizes="(min-width: 1024px) 420px, 300px"
            loading="lazy"
            class="w-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       PRINCIPI
       ══════════════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="t-eyebrow">Il metodo</span>
        <h2 class="t-h2 mt-3">
          Quattro principi, <span class="t-dim">zero compromessi.</span>
        </h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          PRINCIPLES.map((p, i) => (
            <div class="card group flex gap-4 p-6 reveal" style={`--i:${i}`}>
              <span class="icon-tile"><Icon name={p.icon} size={20} /></span>
              <span>
                <span class="t-h3 block">{p.title}</span>
                <span class="t-body mt-2 block text-[0.875rem]">{p.text}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       TEAM
       ══════════════════════════════════════════════════════════════════ -->
  <section class="band-soft section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="t-eyebrow">Il team</span>
        <h2 class="t-h2 mt-3">
          Le persone con cui <span class="t-dim">parlerai.</span>
        </h2>
        <p class="t-lead mt-4">
          Siamo in tre, e il nome dell'azienda sono le nostre iniziali. Significa
          che non c'è nessuno a cui passare la palla.
        </p>
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-3">
        {
          TEAM.map((member, i) => (
            <li class="card group flex flex-col items-center p-7 text-center reveal" style={`--i:${i}`}>
              {/* Al posto del monogramma c'è l'icona dell'area: senza nomi le
                  iniziali non direbbero più niente. */}
              <span class="monogram" aria-hidden="true">
                <Icon name={member.icon} size={30} />
              </span>
              <h3 class="t-h3 mt-5">{member.focus}</h3>
              <p class="t-small mt-1">{member.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════
       DATI VERIFICABILI
       ══════════════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="t-eyebrow">I dati</span>
        <h2 class="t-h2 mt-3">
          Dati <span class="t-dim">verificabili.</span>
        </h2>
        <p class="t-lead mt-4">
          Partita IVA, ragione sociale e sede: puoi controllarci prima ancora di
          scriverci.
        </p>
      </div>

      {/* Colonne A MISURA DI CONTENUTO (`auto`), non quinti uguali: con le
          frazioni fisse "DGF Tech Solutions S.r.l." finiva su due righe e le
          quattro schede avevano tutte un a-capo diverso. Così ogni scheda è
          larga quanto il suo dato, l'ultima assorbe lo spazio che avanza, e
          `whitespace-nowrap` garantisce la riga unica. */}
      <dl class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-[auto_auto_auto_1fr]">
        <div class="card p-5">
          <dt class="t-eyebrow">Ragione sociale</dt>
          <dd class="mt-2 whitespace-nowrap text-[0.9375rem] font-semibold text-[var(--color-ink)]">{SITE.legalName}</dd>
        </div>
        <div class="card p-5">
          <dt class="t-eyebrow">Partita IVA</dt>
          <dd class="mt-2 tabular whitespace-nowrap text-[0.9375rem] font-semibold text-[var(--color-ink)]">{SITE.vatId}</dd>
        </div>
        <div class="card p-5">
          <dt class="t-eyebrow">Sede</dt>
          <dd class="mt-2 whitespace-nowrap text-[0.9375rem] font-semibold text-[var(--color-ink)]">
            {SITE.city} ({SITE.region}), {SITE.countryName}
          </dd>
        </div>
        <div class="card p-5">
          <dt class="t-eyebrow">Contatto</dt>
          <dd class="mt-2 whitespace-nowrap">
            <a href={`mailto:${SITE.email}`} class="link-arrow !text-[0.875rem]">
              {SITE.email}
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <CtaBand
    badge="Lavoriamo insieme"
    title='Adesso che sai <span class="t-dim">chi siamo.</span>'
    lead="Raccontaci il problema. Rispondiamo noi, le stesse persone che hai appena letto qui sopra, e la prima risposta arriva entro un giorno lavorativo."
  />
</Base>

<style>
  /* Monogramma: niente foto stock né ritratti generati. Le iniziali sono
     anche il nome dell'azienda, quindi il segno ha un senso suo. */
  .monogram {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-navy), var(--color-blue));
    color: #fff;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-md);
    transition: transform var(--dur) var(--ease-out-quart);
  }
  @media (hover: hover) {
    .card:hover .monogram { transform: scale(1.06); }
  }
</style>

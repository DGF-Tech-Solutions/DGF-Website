---
import type { ImageMetadata } from "astro";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Faq from "@/components/Faq.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { SERVICES } from "@/data/services";
import { SITE } from "@/data/site";

import imgSiti from "@/assets/illustrazioni/scena-siti-web.png";
import imgEcom from "@/assets/illustrazioni/scena-ecommerce.png";
import imgApp from "@/assets/illustrazioni/scena-app.png";
import imgSoft from "@/assets/illustrazioni/scena-software.png";
import imgAi from "@/assets/illustrazioni/scena-ai.png";

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

/* Gli import sono statici per forza (Astro li risolve a build time):
   qui li associamo allo slug con una mappa esplicita. */
const ILLUSTRATIONS: Record<string, ImageMetadata> = {
  "siti-web": imgSiti,
  ecommerce: imgEcom,
  app: imgApp,
  "software-su-misura": imgSoft,
  "intelligenza-artificiale": imgAi,
};
const ICONS: Record<string, "globe" | "bag" | "phone" | "dashboard" | "sparkles"> = {
  "siti-web": "globe",
  ecommerce: "bag",
  app: "phone",
  "software-su-misura": "dashboard",
  "intelligenza-artificiale": "sparkles",
};

const others = SERVICES.filter((s) => s.slug !== service.slug);

const schema = [
  {
    "@type": "Service",
    name: service.title,
    description: service.summary,
    url: `${SITE.url}/servizi/${service.slug}`,
    provider: { "@id": `${SITE.url}/#organization` },
    areaServed: { "@type": "Country", name: SITE.countryName },
    serviceType: service.title,
  },
  {
    "@type": "FAQPage",
    mainEntity: service.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base
  title={service.title}
  description={service.summary}
  canonical={`/servizi/${service.slug}`}
  schema={schema}
>
  <PageHeader
    eyebrow={service.title}
    title={service.headline}
    lead={service.intro}
    crumbs={[{ label: "Servizi", href: "/servizi" }, { label: service.title }]}
    illustration={ILLUSTRATIONS[service.slug]}
    illustrationAlt={`Illustrazione: ${service.title.toLowerCase()}`}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/contatti" class="btn btn-primary">
        Parliamo del tuo progetto
        <Icon name="arrow-right" size={16} />
      </a>
      <span class="btn btn-ghost !cursor-default">
        <Icon name="clock" size={16} />
        {service.timeline}
      </span>
    </div>
  </PageHeader>

  <!-- A chi serve -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <span class="t-eyebrow">Quando ha senso</span>
          <h2 class="t-h2 mt-3">A chi serve <span class="t-dim">davvero.</span></h2>
          <p class="t-lead mt-4">
            Se non ti riconosci in nessuno di questi casi, probabilmente ti serve
            altro. Scrivici lo stesso: ti indirizziamo.
          </p>
        </div>

        <ul class="space-y-3">
          {
            service.bestFor.map((item) => (
              <li class="card group flex items-start gap-4 p-5 reveal">
                <span class="icon-tile icon-tile-sm">
                  <Icon name="check" size={18} />
                </span>
                <span class="pt-1 text-[0.9375rem] leading-relaxed text-[var(--color-ink)]">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Quando NON serve -->
  <section class="on-dark section">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <span class="t-eyebrow">Onestà</span>
          <h2 class="t-h2 mt-3">
            Quando <span class="t-dim">non ti serve.</span>
          </h2>
          <p class="t-lead mt-4">
            Nessun sito di software house scrive questa sezione. Noi sì, perché
            un progetto sbagliato è un problema per entrambi — e perderci un
            preventivo costa meno che perderci la reputazione.
          </p>
        </div>

        <ul class="space-y-4">
          {
            service.notFor.map((n, i) => (
              <li class="card p-6 reveal" style={`--i:${i}`}>
                <p class="flex items-start gap-3 text-[0.9375rem] font-semibold text-white">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-cyan)]" aria-hidden="true" />
                  {n.case}
                </p>
                <p class="t-body mt-2.5 pl-[1.125rem] text-[0.875rem]">{n.instead}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Cosa comprende -->
  <section class="band-soft section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="t-eyebrow">Il contenuto</span>
        <h2 class="t-h2 mt-3">Cosa <span class="t-dim">comprende.</span></h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          service.includes.map((item) => (
            <div class="card group flex gap-4 p-6 reveal">
              <span class="icon-tile"><Icon name={ICONS[service.slug]} size={20} /></span>
              <span>
                <span class="t-h3 block">{item.title}</span>
                <span class="t-body mt-2 block text-[0.875rem]">{item.text}</span>
              </span>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
        <span class="t-small mr-2">Tecnologie:</span>
        {service.stack.map((t) => <span class="chip chip-line">{t}</span>)}
      </div>
    </div>
  </section>

  <!-- Domande -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <span class="t-eyebrow">Le domande</span>
          <h2 class="t-h2 mt-3">Quello che <span class="t-dim">ci chiedono.</span></h2>
        </div>
        <Faq items={service.faq} />
      </div>
    </div>
  </section>

  <!-- Gli altri servizi.
       Sta su fondo chiaro apposta: fa da stacco fra la fascia scura "Quando
       non ti serve" (più su) e la fascia di chiusura, che è anch'essa scura. -->
  <section class="band-soft section-sm">
    <div class="wrap">
      <h2 class="t-eyebrow">Gli altri servizi</h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.map((s) => (
            <a href={`/servizi/${s.slug}`} class="card group flex items-center gap-3 p-4">
              <span class="icon-tile icon-tile-sm">
                <Icon name={ICONS[s.slug]} size={17} />
              </span>
              <span class="text-[0.9375rem] font-semibold text-[var(--color-ink)]">
                {s.title}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    badge={service.title}
    title='Parliamo del <span class="t-dim">tuo caso.</span>'
    lead="Raccontaci cosa ti serve. Ti diamo una stima chiara, e se pensiamo che ti convenga qualcos'altro te lo diciamo."
  />
</Base>

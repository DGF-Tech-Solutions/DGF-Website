---
import type { ImageMetadata } from "astro";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Faq from "@/components/Faq.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { SERVICES } from "@/data/services";
import { SITE } from "@/data/site";
import { stripInlineLinks } from "@/lib/inline-links";

import imgSiti from "@/assets/foto/siti-web.webp";
import imgEcom from "@/assets/foto/ecommerce.webp";
import imgApp from "@/assets/foto/app.webp";
import imgSoft from "@/assets/foto/software.webp";
import imgAi from "@/assets/foto/ai.webp";

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

/* Gli import sono statici per forza (Astro li risolve a build time):
   qui li associamo allo slug con una mappa esplicita. */
/* Descrizioni brevi di cosa si vede: mai "il nostro ufficio" o "il nostro
   team", perché non lo sono. Le foto sono generate, e il credito sotto
   all'immagine lo dichiara. */
const ALT: Record<string, string> = {
  "siti-web": "Una persona guarda una pagina web su un portatile",
  ecommerce: "Mani chiudono una scatola su un bancone accanto a un portatile",
  app: "Mani tengono uno smartphone con lo schermo acceso",
  "software-su-misura": "Due persone al lavoro davanti a uno schermo",
  "intelligenza-artificiale": "Mani su un portatile con un grafico sullo schermo",
};

const ILLUSTRATIONS: Record<string, ImageMetadata> = {
  "siti-web": imgSiti,
  ecommerce: imgEcom,
  app: imgApp,
  "software-su-misura": imgSoft,
  "intelligenza-artificiale": imgAi,
};
const ICONS: Record<string, "globe" | "bag" | "phone" | "dashboard" | "sparkles"> = {
  "siti-web": "globe",
  ecommerce: "bag",
  app: "phone",
  "software-su-misura": "dashboard",
  "intelligenza-artificiale": "sparkles",
};

const others = SERVICES.filter((s) => s.slug !== service.slug);

const schema = [
  {
    "@type": "Service",
    name: service.title,
    description: service.summary,
    url: `${SITE.url}/servizi/${service.slug}`,
    provider: { "@id": `${SITE.url}/#organization` },
    areaServed: { "@type": "Country", name: SITE.countryName },
    serviceType: service.title,
  },
  {
    "@type": "FAQPage",
    mainEntity: service.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      // Senza markup: se la risposta contiene un link, nei dati strutturati
      // deve arrivare la frase e basta.
      acceptedAnswer: { "@type": "Answer", text: stripInlineLinks(f.a) },
    })),
  },
];
---

<Base
  title={service.title}
  description={service.summary}
  canonical={`/servizi/${service.slug}`}
  schema={schema}
>
  <PageHeader
    eyebrow={service.title}
    title={service.headline}
    lead={service.intro}
    crumbs={[{ label: "Servizi", href: "/servizi" }, { label: service.title }]}
    illustration={ILLUSTRATIONS[service.slug]}
    illustrationAlt={ALT[service.slug]}
    illustrationAi
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/contatti" class="btn btn-primary">
        Parliamo del tuo progetto
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </PageHeader>

  <!-- A chi serve -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <span class="t-eyebrow">Quando ha senso</span>
          <h2 class="t-h2 mt-3">A chi serve <span class="t-dim">davvero.</span></h2>
          <p class="t-lead mt-4">
            Se non ti riconosci in nessuno di questi casi, probabilmente ti serve
            altro. Scrivici lo stesso: ti indirizziamo.
          </p>
        </div>

        <ul class="space-y-3">
          {
            service.bestFor.map((item) => (
              <li class="card group flex items-start gap-4 p-5 reveal">
                <span class="icon-tile icon-tile-sm">
                  <Icon name="check" size={18} />
                </span>
                <span class="pt-1 text-[0.9375rem] leading-relaxed text-[var(--color-ink)]">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Cosa comprende -->
  <section class="band-soft section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <span class="t-eyebrow">Il contenuto</span>
        <h2 class="t-h2 mt-3">Cosa <span class="t-dim">comprende.</span></h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          service.includes.map((item) => (
            <div class="card group flex gap-4 p-6 reveal">
              <span class="icon-tile"><Icon name={ICONS[service.slug]} size={20} /></span>
              <span>
                <span class="t-h3 block">{item.title}</span>
                <span class="t-body mt-2 block text-[0.875rem]">{item.text}</span>
              </span>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
        <span class="t-small mr-2">Tecnologie:</span>
        {service.stack.map((t) => <span class="chip chip-line">{t}</span>)}
      </div>
    </div>
  </section>

  <!-- Domande -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <span class="t-eyebrow">Le domande</span>
          <h2 class="t-h2 mt-3">Quello che <span class="t-dim">ci chiedono.</span></h2>
        </div>
        <Faq items={service.faq} />
      </div>
    </div>
  </section>

  <!-- Gli altri servizi.
       Su fondo tinto apposta: è la seconda cresta dell'onda
       bianco → azzurro → blu, e prepara la fascia scura di chiusura invece di
       farla arrivare di colpo dal bianco. -->
  <section class="band-soft section-sm">
    <div class="wrap">
      <h2 class="t-eyebrow">Gli altri servizi</h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.map((s) => (
            <a href={`/servizi/${s.slug}`} class="card group flex items-center gap-3 p-4">
              <span class="icon-tile icon-tile-sm">
                <Icon name={ICONS[s.slug]} size={17} />
              </span>
              <span class="text-[0.9375rem] font-semibold text-[var(--color-ink)]">
                {s.title}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    badge={service.title}
    title='Parliamo del <span class="t-dim">tuo caso.</span>'
    lead="Raccontaci cosa ti serve. Ti diamo una stima chiara, e se pensiamo che ti convenga qualcos'altro te lo diciamo."
  />
</Base>

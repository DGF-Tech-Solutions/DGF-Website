---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Explorer from "@/components/Explorer.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { SERVICES } from "@/data/services";
import { SITE } from "@/data/site";
import illustration from "@/assets/foto/servizi.webp";

const SERVICE_ICONS = ["globe", "bag", "phone", "dashboard", "sparkles"] as const;

/** Testo su cui lavora la ricerca: titolo, riassunto, tecnologie e casi d'uso. */
function haystack(i: number): string {
  const s = SERVICES[i];
  return `${s.title} ${s.summary} ${s.intro} ${s.stack.join(" ")} ${s.bestFor.join(" ")}`
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "");
}

const schema = {
  "@type": "ItemList",
  name: "Servizi di DGF Tech Solutions",
  itemListElement: SERVICES.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: s.title,
    description: s.summary,
    url: `${SITE.url}/servizi/${s.slug}`,
  })),
};
---

<Base
  title="Servizi"
  description="Siti web, e-commerce, app, software su misura e intelligenza artificiale. Cinque servizi, con i criteri onesti per capire quale ti serve davvero."
  canonical="/servizi"
  schema={schema}
>
  <PageHeader
    eyebrow="I servizi"
    title='Cinque cose, <span class="t-dim">fatte bene.</span>'
    lead="Non facciamo tutto. Per ognuno di questi sappiamo dirti anche quando non ti serve, e succede più spesso di quanto immagini."
    crumbs={[{ label: "Servizi" }]}
    illustration={illustration}
    illustrationAlt="Un banco di lavoro con portatile, telefono e fogli stampati"
    illustrationAi
  />

  <section class="section">
    <div class="wrap">
      <Explorer
        placeholder="Cerca un servizio o una tecnologia…"
        label="Cerca fra i servizi"
        noun="servizio"
      >
        <div class="grid gap-5 md:grid-cols-2">
          {
            SERVICES.map((s, i) => (
              <a
                href={`/servizi/${s.slug}`}
                class="card group relative flex flex-col p-7 reveal lg:p-8"
                style={`--i:${i}`}
                data-search={haystack(i)}
              >
                <Icon
                  name="arrow-up-right"
                  size={18}
                  class="absolute right-6 top-6 text-[var(--color-line)] transition-colors group-hover:text-[var(--color-navy)]"
                />

                <span class="icon-tile">
                  <Icon name={SERVICE_ICONS[i]} size={22} />
                </span>

                <h2 class="t-h2 mt-5 !text-[1.5rem]">{s.title}</h2>
                <p class="t-body mt-3">{s.summary}</p>

                <ul class="mt-6 space-y-2">
                  {s.bestFor.slice(0, 2).map((b) => (
                    <li class="flex items-start gap-2 text-[0.8125rem] leading-relaxed text-[var(--color-ink-3)]">
                      <Icon name="check" size={15} class="mt-0.5 shrink-0 text-[var(--color-navy)]" />
                      {b}
                    </li>
                  ))}
                </ul>

                <div class="mt-auto pt-6">
                  <ul class="flex flex-wrap gap-1.5">
                    {s.stack.slice(0, 4).map((t) => (
                      <li class="chip chip-line !text-[0.6875rem]">{t}</li>
                    ))}
                  </ul>
                </div>
              </a>
            ))
          }
        </div>
      </Explorer>
    </div>
  </section>

  {/* La scheda "Non sai quale ti serve?" che stava in fondo alla griglia è
      confluita qui: restava visibile anche a filtro attivo (non ha un
      `data-search`), e ripeteva la stessa richiesta della fascia. */}
  <CtaBand
    badge="I servizi"
    title='Non sai <span class="t-dim">quale ti serve?</span>'
    lead="È la situazione più comune. Raccontaci il problema e ti diciamo noi da dove conviene partire, anche se la risposta è «per ora, da niente»."
  />
</Base>

---
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import poster from "@/assets/video/nexia-demo-poster.png";

/*
 * Spezzone in loop di un prodotto vero, non un video stock.
 *
 * Il sito precedente moriva perché caricava quattro video in autoplay più due
 * canvas: qui ce n'è UNO solo, muto, senza audio nel file (traccia rimossa in
 * fase di codifica, non solo silenziata), e con `preload="none"` così finché
 * non si arriva alla sezione il browser non scarica nulla.
 *
 * La riproduzione parte quando la sezione entra nello schermo e si ferma
 * quando esce: un video che gira dietro a tre schermate di distanza consuma
 * batteria per niente. IntersectionObserver, ~500 byte di script.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  caption?: string;
  /**
   * Tre righe che spiegano di che genere di software si tratta.
   *
   * Servono perché "SaaS" non vuol dire niente per la maggior parte di chi
   * legge: senza, il video mostra delle schermate e basta. Con, si capisce
   * che cosa si sta guardando e perché dovrebbe interessare.
   */
  /* `readonly`: questa componente le legge soltanto, e la home le passa da un
     `as const`. Senza, TypeScript rifiutava l'unica chiamata che esiste — era
     l'ultimo errore di `astro check`. Un componente che non modifica non ha
     motivo di chiedere un array modificabile. */
  points?: readonly { readonly title: string; readonly text: string }[];
  pointsTitle?: string;
  /** Rimando alla scheda del progetto, per chi vuole i dettagli tecnici. */
  href?: string;
  hrefLabel?: string;
}

const {
  eyebrow,
  title,
  lead,
  caption,
  points = [],
  pointsTitle,
  href,
  hrefLabel = "Vedi il progetto",
} = Astro.props;
---

<section class="video-sezione on-dark">
  {/*
    IL CINEMA: da schermo largo la sezione si AGGANCIA a schermo pieno e lo
    scroll comanda la scena — il titolo si compone, il video cresce fino
    alla sua misura, i cartellini si posano, il fondale scorre a strati.
    È il `pin + scrub` delle pagine prodotto (Apple docet): il contenitore
    alto è il "tempo" della scena, il palco sticky è l'inquadratura.

    Sotto i 1100px e dove le scroll-driven animations non ci sono, questi
    due div non fanno nulla e la sezione resta quella normale.
  */}
  <div class="cine-alt">
    <div class="cine-stage section">
      {/*
        La scenografia dietro al contenuto: quattro PIANI di profondità
        (quadrettatura in fondo, aloni, anelli davanti — il sistema `fx-*`).
        Con la scena agganciata il parallasse ha finalmente un ancoraggio
        fermo contro cui misurarsi: è quello che gli mancava per leggersi.
      */}
      <div class="fondale" aria-hidden="true">
        <span class="fondale-griglia fx-fondo"></span>
        <span class="fondale-alone fondale-alone-1 fx-lento"></span>
        <span class="fondale-alone fondale-alone-2 fx-lento"></span>
        <span class="fondale-anello fondale-anello-1 fx-veloce"></span>
        <span class="fondale-anello fondale-anello-2 fx-medio"></span>
      </div>

      <div class="wrap">
    {/* Un contenitore solo per titolo, spiegazione e video: prima erano tre
        blocchi appoggiati sulla pagina uno sotto l'altro, e il video sembrava
        capitato lì. Dentro una cornice si legge come una vetrina. */}
    {/* Niente `reveal` qui: la comparsa d'insieme litigava con la parallasse
        delle singole righe più sotto — due animazioni sullo stesso blocco,
        una che lo alza tutto e una che ne muove i pezzi. Il movimento ora è
        quello fine, riga per riga. */}
    <div class="video-box">
      <!-- Titolo sopra, centrato: apre la scena e lascia al video tutta la
           larghezza sotto. -->
      <div class="video-testo">
        {eyebrow && <span class="t-eyebrow">{eyebrow}</span>}
        <h2 class="t-h2 mt-3" set:html={title} />
        {lead && <p class="video-lead">{lead}</p>}
        {pointsTitle && <span class="badge-brand video-etichetta">{pointsTitle}</span>}
      </div>

      <!--
        Il video al centro, con le spiegazioni che gli galleggiano intorno
        invece di stare in una colonna a parte. Sono appoggiate ai bordi e
        oscillano piano: parlano del prodotto stando addosso al prodotto, che
        è il motivo per cui si leggono senza staccare gli occhi dal video.

        Su schermo stretto non c'è margine in cui farle galleggiare, quindi
        tornano un elenco sotto: la stessa informazione, senza sovrapporsi.
      -->
      <div class="video-scena">
        {
          points.length > 0 && (
            <ul class="volanti">
              {points.map((p, i) => (
                <li class:list={["volante", `volante-${i + 1}`]}>
                  <span class="volante-num tabular">{String(i + 1).padStart(2, "0")}</span>
                  <span>
                    <span class="volante-titolo">{p.title}</span>
                    <span class="volante-testo">{p.text}</span>
                  </span>
                </li>
              ))}
            </ul>
          )
        }

    <figure class="video-frame">
      <div class="video-chrome" aria-hidden="true">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="video-url">nexiahome.it</span>
      </div>

      <div class="video-stage">
        {/*
          Il poster è un'immagine gestita da Astro (quindi compressa e servita
          in formato moderno) sovrapposta al video: viene nascosta al primo
          fotogramma riprodotto. Usare l'attributo `poster=""` avrebbe servito
          il PNG originale non ottimizzato.

          `sizes`: sotto i 1100px il poster non viene MAI disegnato alla
          larghezza del riquadro (vedi il foglio di stile), quindi il valore
          qui non è la misura del riquadro. Fra 641 e 1099px è a grandezza
          naturale — `object-fit: none`, un pixel di sorgente per pixel CSS,
          cioè 1280. Sotto i 640 è ritagliato con `cover`, e per coprire un
          riquadro alto 10/9 la sorgente viene disegnata a 0,537 della sua
          misura: su un riquadro da 348px sono ~687px CSS di immagine, cioè
          ~1374 pixel fisici a densità doppia. In tutti e due i casi la
          variante giusta da scaricare è quella da 1280 — che è anche la più
          grande che esista, quindi non c'è modo di chiedere di meglio. Dichiarare 92vw lì farebbe scaricare la versione da 960px
          per poi stamparla 1:1 sui 1280 — un poster impastato accanto a un
          video nitido, con lo scatto a fuoco visibile nell'istante in cui la
          riproduzione parte. Costa 16KB in più del ritaglio da 960 su un
          telefono a densità doppia, ed è l'unica cosa che si vede con
          `prefers-reduced-motion: reduce` o quando `play()` viene rifiutato.

          Il commento sta QUI e non fra gli attributi: un commento in
          posizione di attributo manda in errore `astro check` (il tag non si
          chiude più e il file intero smette di essere type-checkato), anche
          se `astro build` lo scarta in silenzio e sembra funzionare.

          E per la stessa ragione qui dentro non si scrive la sequenza che
          CHIUDE un commento: la prima versione di questa nota la citava per
          spiegarla, chiudeva il blocco a metà frase e mandava in errore la
          build con un «Unexpected token» dodici righe più sotto.
        */}
        <Image
          src={poster}
          alt="Interfaccia di Nexia durante l'importazione di una fattura"
          widths={[640, 960, 1280]}
          sizes="(max-width: 1099px) 1280px, (min-width: 1280px) 1100px, 92vw"
          loading="lazy"
          class="video-poster"
          data-poster
        />
        <video
          class="video-el"
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          tabindex="-1"
          aria-label="Registrazione dell'interfaccia di Nexia"
          data-loop
        >
          <source src="/video/nexia-demo.webm" type="video/webm" />
          <source src="/video/nexia-demo.mp4" type="video/mp4" />
        </video>
      </div>
      </figure>
      </div>

      <div class="video-piede">
        {caption && <p class="video-nota">{caption}</p>}
        {
          href && (
            <a href={href} class="link-arrow shrink-0">
              {hrefLabel}
              <Icon name="arrow-right" size={16} />
            </a>
          )
        }
      </div>
    </div>
      </div>
    </div>

  </div>
</section>

<style>
  /*
   * Nessuna cornice: la sezione è bianca e il video ci sta appoggiato sopra.
   *
   * Prima c'era un riquadro grigio attorno a tutto. Il difetto è che con le
   * schede dei servizi qui sopra e i pannelli del metodo qui sotto — tutti
   * dentro un contorno — la pagina diventava una fila di scatole, e il
   * riquadro grigio faceva sembrare il video una schermata secondaria invece
   * dell'elemento principale della sezione. Senza, l'unica cosa che ha un
   * bordo è il video, ed è lì che va l'occhio.
   */
  /* ═══════════════════════════════════════════════════════════════════════
  /* ═══════════════════════════════════════════════════════════════════════
     La sezione che scivola SOPRA quella precedente
     ═══════════════════════════════════════════════════════════════════════ */

  /*
   * Questa fascia sale e copre i servizi, che restano fermi dietro (il
   * meccanismo sta in `.pila-parallasse`, in index.astro).
   *
   * Qui servono solo tre cose perché l'effetto si legga:
   *  - un fondo OPACO, altrimenti si vedrebbe la sezione sotto in trasparenza;
   *  - `z-index` più alto, per stare davanti;
   *  - un'ombra verso l'ALTO sul bordo superiore, che è ciò che fa capire che
   *    è un pannello appoggiato sopra e non il seguito della pagina. Senza
   *    ombra il movimento c'è ma non si nota.
   *
   * La fascia è scura di suo: una schermata di prodotto su fondo scuro si
   * stacca molto meglio, ed è l'unica sezione scura della pagina.
   */
  .video-sezione {
    position: relative;
    z-index: 1;
    /* `isolate` tiene gli z-index del fondale dentro la sezione; `clip` e non
       `hidden` per lo stesso motivo annotato nella sezione metodo: `hidden`
       creerebbe un contenitore di scorrimento — e qui dentro lo sticky c'è
       davvero (il palco della scena). */
    isolation: isolate;
    overflow: clip;

    /* NESSUN ANGOLO, NESSUNA OMBRA: c'era una versione con angoli
       arrotondati, morso e ombra — a schermo gli angoli si leggevano come un
       ritaglio, non come profondità.

       BORDO NETTO in cima, però. Qui il blu partiva con una dissolvenza di
       12svh dall'azzurro dei servizi, per non "appoggiarsi" sopra la pagina.
       L'effetto era il contrario: sfumata, la fascia sembra incollata al
       fondo invece che sovrapposta, e proprio qui deve leggersi come un
       pannello che SALE A COPRIRE la sezione ferma sotto — è tutta la
       parallasse di questo pezzo. Il bordo netto è anche la regola generale
       dei confini fra colori lontani (vedi `.band-soft` in global.css). */
    background: var(--gradient-brand);

    /* `.on-dark` tara `--color-ink-2` su 0,78, che è giusto sul navy pieno.
       Questa fascia però porta il gradiente, che sotto al sommario corre più
       chiaro: qui il token vale un gradino in più. Si rimappa invece di
       scrivere un letterale nella regola del sommario, così tutto ciò che
       legge "testo corrente" dentro questa fascia si adegua da solo. */
    --color-ink-2: rgb(255 255 255 / 0.85);
  }

  /* ═══════════════════════════════════════════════════════════════════════
     IL FONDALE — la scenografia in parallasse dietro al contenuto

     Tre lingue già usate dal sito, sovrapposte: gli aloni sfumati (come nella
     sezione metodo), gli anelli capello (come su .band-brand) e la
     quadrettatura tecnica (come sotto i disegni dei servizi). Ogni strato ha
     una velocità diversa — lento, veloce, con una deriva che ruota appena —
     ed è lo scarto fra le velocità a dare la profondità, non i singoli pezzi.

     Tutto sta a `z-index: -1` dentro la sezione isolata: sopra il fondo
     sfumato, sotto ogni contenuto. Costa zero byte di immagini e si muove
     sul compositore; su Firefox e con meno movimento resta una scenografia
     ferma, che è comunque corretta.
     ═══════════════════════════════════════════════════════════════════════ */

  .fondale {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* ── I quattro piani di profondità ─────────────────────────────────────
     Il parallasse si legge solo se lo scarto fra i piani è grande: il piano
     in fondo quasi fermo, quello davanti che percorre centinaia di pixel.
     Ogni elemento è legato alla PROPRIA traversata dello schermo (view()),
     solo transform, quindi tutto sul compositore.

     `--tl` dietro una variabile per il solito inciampo del minificatore
     (vedi .read-progress in global.css): dentro la scorciatoia `animation`
     una timeline non è ammessa e la dichiarazione verrebbe scartata. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* La timeline va dichiarata DOPO la scorciatoia `animation`, che
         azzera anche `animation-timeline` e `animation-range` (il range
         di default, l'intera traversata, è proprio quello che serve). */
      .fx-fondo,
      .fx-lento,
      .fx-medio,
      .fx-veloce {
        --tl: view();
        will-change: transform;
      }
      .fx-fondo  { animation: fx-fondo linear both;  animation-timeline: var(--tl); }
      .fx-lento  { animation: fx-lento linear both;  animation-timeline: var(--tl); }
      .fx-medio  { animation: fx-medio linear both;  animation-timeline: var(--tl); }
      .fx-veloce { animation: fx-veloce linear both; animation-timeline: var(--tl); }
    }
  }

  @keyframes fx-fondo {
    from { transform: translate3d(0, 70px, 0); }
    to   { transform: translate3d(0, -70px, 0); }
  }
  @keyframes fx-lento {
    from { transform: translate3d(0, 180px, 0); }
    to   { transform: translate3d(0, -180px, 0); }
  }
  @keyframes fx-medio {
    from { transform: translate3d(0, 280px, 0); }
    to   { transform: translate3d(0, -280px, 0); }
  }
  @keyframes fx-veloce {
    from { transform: translate3d(0, 400px, 0); }
    to   { transform: translate3d(0, -400px, 0); }
  }

  /* Come per le classi globali: su schermo piccolo lo spazio verticale è
     poco e il movimento largo diventa fastidio, non profondità. */
  @media (max-width: 767px) {
    .fx-fondo, .fx-lento, .fx-medio, .fx-veloce {
      animation: none !important;
      transform: none !important;
    }
  }

  /* La quadrettatura: la stessa dei disegni dei servizi, qui in bianco
     tenue e mascherata al centro. Sborda dai lati apposta: con la deriva
     che la muove e la inclina, i bordi non devono mai entrare in scena. */
  .fondale-griglia {
    position: absolute;
    inset: -12% -6%;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.055) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(closest-side ellipse at 50% 42%, #000 25%, transparent 85%);
  }

  .fondale-alone {
    position: absolute;
    border-radius: 50%;
  }

  /* Ciano in alto a sinistra, dove il gradiente è ancora navy scuro e il
     colore si vede; bianco in basso a destra, dove il fondo è già chiaro
     e serve solo un respiro di luce. */
  .fondale-alone-1 {
    top: -14rem;
    left: -12rem;
    width: 42rem;
    height: 42rem;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-cyan) 32%, transparent) 0%,
      transparent 66%
    );
  }

  .fondale-alone-2 {
    bottom: -16rem;
    right: -10rem;
    width: 36rem;
    height: 36rem;
    background: radial-gradient(circle, rgb(255 255 255 / 0.09) 0%, transparent 65%);
  }

  /* Gli anelli capello di .band-brand, ma a velocità diverse: è il pezzo
     che si nota di più mentre si scorre, perché una linea netta che si
     sfila da un alone sfumato misura il movimento meglio di due sfumature. */
  .fondale-anello {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.13);
  }

  .fondale-anello-1 {
    top: -9rem;
    right: -7rem;
    width: 32rem;
    height: 32rem;
  }

  .fondale-anello-2 {
    bottom: 8%;
    left: 3%;
    width: 13rem;
    height: 13rem;
    border-color: rgb(255 255 255 / 0.09);
  }



  /*
   * A sinistra il testo, a destra il video: superato. Ora il titolo sta sopra
   * e centrato, e sotto il video prende tutta la larghezza — era la richiesta,
   * e in effetti un gestionale mostrato in mezza riga non si legge.
   */
  .video-testo {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  /* La regola per `.t-dim` sul gradiente sta in global.css, insieme a quella
     della fascia di chiusura: era la stessa scritta due volte. */

  /* Il ciano dei link su fondo scuro (regola di `.on-dark`) qui non regge:
     in basso a destra il gradiente diventa proprio ciano-blu e il link ci
     spariva sopra. Bianco, come i bottoni della CTA sullo stesso fondo. */
  .video-sezione :global(.link-arrow) {
    color: #fff;
  }
  @media (hover: hover) {
    .video-sezione :global(.link-arrow:hover) {
      color: color-mix(in srgb, var(--color-cyan) 45%, white);
    }
  }

  /* Bianco quasi pieno, non `--color-ink-3` (che dentro `.on-dark` vale
     bianco al 66%): sul gradiente, più chiaro del navy-deep per cui quel
     valore era nato, il sommario si impastava col fondo. Stessa voce del
     sommario della CTA, che sta sullo stesso blu. */
  .video-lead {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  /* L'occhiello di `.on-dark` è ciano, pensato per staccare sul navy-deep
     pieno: qui il fondo È già ciano-blu, e ci si mimetizzava. Bianco spento,
     come l'occhiello di .band-brand sullo stesso gradiente. */
  .video-sezione :global(.t-eyebrow) {
    color: rgb(255 255 255 / 0.8);
  }

  /* Etichetta che introduce i cartellini: senza, "01 Vive sul web" appare
     senza che si capisca di che elenco faccia parte. */
  /* La superficie arriva da `.badge-brand` in global.css — la stessa pillola
     della fascia di chiusura, che è lo stesso gradiente. Qui restano il
     monospazio e la spaziatura stretta, che sono di questa etichetta. */
  .video-etichetta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.3125rem 0.875rem;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     La parallasse dell'introduzione

     Le quattro righe in cima scorrono più LENTE della pagina e si sfilano
     l'una dall'altra: l'occhiello per primo, poi il titolo, il sommario e
     l'etichetta. Salendo si compattano, e il video sembra risalire e passare
     sopra al testo invece che seguirlo in fila.

     Perché lo scarto cresce verso il basso: se fosse l'occhiello a muoversi
     di più, il blocco si aprirebbe man mano e le righe si allontanerebbero
     fino a sembrare scollegate. Facendo ritardare le righe più in basso, il
     movimento le stringe verso il titolo — si legge come una cosa sola che
     rallenta, non come quattro pezzi che si sfaldano.

     `--tl` dietro una variabile è obbligatorio: il minificatore accorpa
     `animation-timeline` dentro la scorciatoia `animation`, che non ammette
     una timeline, e il browser scarterebbe tutta la dichiarazione. È lo
     stesso inciampo già annotato in Nav.astro e in global.css.
     ═══════════════════════════════════════════════════════════════════════ */
  @keyframes intro-parallasse {
    from { transform: translate3d(0, var(--p), 0); }
    to   { transform: translate3d(0, calc(var(--p) * -0.55), 0); }
  }

  /* Solo SOTTO i 1100px: da lì in su comanda la scena agganciata (--cine,
     in fondo al foglio) e queste righe legate a `view()` resterebbero
     congelate a metà corsa dentro il palco sticky, che non si muove. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 1099.98px) {
    @supports (animation-timeline: view()) {
      .video-testo > * {
        --p: 0px;
        --tl: view();
        display: block;
        animation: intro-parallasse linear both;
        animation-timeline: var(--tl);
        animation-range: entry 15% exit 85%;
        will-change: transform;
      }
      /* Scarti raddoppiati rispetto alla prima versione (10/26/44/62):
         insieme ai piani del fondale, sono quello che fa leggere l'arrivo
         come strati a profondità diverse e non come una dissolvenza. */
      .video-testo > .t-eyebrow { --p: 20px; }
      .video-testo > h2 { --p: 48px; }
      .video-testo > .video-lead { --p: 80px; }
      /* L'etichetta resta `inline-block`: da `block` la pillola si stirerebbe
         per tutta la riga invece di stare stretta sul testo. */
      .video-testo > .video-etichetta { --p: 110px; display: inline-block; }
    }
  }

  /* ─── La scena: video al centro, cartellini intorno ───────────────────── */
  .video-scena {
    position: relative;
    margin-top: 2.25rem;
  }

  /*
   * Il riquadro entra leggermente rimpicciolito e si apre alla sua misura
   * mentre sale: è il movimento che fa "arrivare" il video addosso a chi
   * legge, invece di trovarselo già lì. Solo `transform`, quindi gira sul
   * compositore e non costa niente al thread principale.
   *
   * L'animazione si ferma a `cover 45%`: da lì in poi il video resta fermo e
   * alla sua misura piena per tutto il tempo in cui lo si guarda. Se
   * continuasse fino in fondo il fotogramma respirerebbe mentre si prova a
   * leggere la tabella, che è il difetto di metà delle parallassi in giro.
   */
  /* Anche questa vale solo sotto i 1100px, per lo stesso motivo di sopra. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 1099.98px) {
    @supports (animation-timeline: view()) {
      /* Sulla SCENA, non sul solo riquadro: i cartellini sono posizionati
         rispetto a lei, e animando il riquadro da solo resterebbero fermi
         a mezz'aria mentre il video sotto cambia misura. Insieme, arrivano
         come un blocco. */
      .video-scena {
        --tl: view();
        transform-origin: 50% 100%;
        animation: video-arriva linear both;
        animation-timeline: var(--tl);
        animation-range: entry 5% cover 45%;
        will-change: transform;
      }
    }
  }
  /* Più profondo di prima (0.94 / 26px): il video è il piano più vicino
     della scena e deve percorrere più strada di tutti gli altri. */
  @keyframes video-arriva {
    from { transform: scale(0.9) translate3d(0, 90px, 0); }
    to   { transform: scale(1) translate3d(0, 0, 0); }
  }

  .volanti {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  /*
   * Cartellini BIANCHI, come le schede del resto del sito.
   *
   * La versione scura (navy schiarito) era nata per il fondo navy-deep
   * piatto; sul gradiente della fascia, che scende verso il ciano chiaro,
   * diventava un rettangolo fangoso e il testo non si leggeva più. Bianco
   * pieno e opaco: i cartellini stanno appoggiati sopra il video, e sotto
   * non deve trasparire la tabella delle fatture.
   *
   * I colori del testo sono scritti per esteso e non con i token, perché
   * dentro `.on-dark` i token sono rimappati sul bianco: `--color-ink` qui
   * vale #fff, e un titolo bianco su cartellino bianco sparirebbe.
   */
  .volante {
    display: flex;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
    background: #fff;
    /* Bordo capello scuro, non `--color-line` (rimappato su bianco/0.14):
       serve dove il cartellino passa sopra il video, che è chiaro anche lui. */
    border: 1px solid rgb(15 23 42 / 0.08);
    box-shadow: var(--shadow-md);
  }
  .volante .volante-titolo { color: #0f172a; }
  .volante .volante-testo { color: #526074; }
  /* Il blu dei collegamenti: su bianco tiene il contrasto (4,8:1) anche a
     questa misura, e lega i numeri agli accenti del resto della pagina. */
  .volante .volante-num { color: var(--color-blue); }
  .volante-num {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.7;
    color: var(--color-navy);
  }
  .volante-titolo {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .volante-testo {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--color-ink-3);
  }

  /*
   * Da 1100px in su i cartellini si staccano e vanno a galleggiare sui bordi
   * del video. Sotto quella misura non c'è margine laterale in cui metterli
   * senza coprire la tabella — che è la cosa che il video deve far vedere —
   * quindi restano un elenco sopra al riquadro.
   *
   * Il video si restringe apposta (`max-width` sul riquadro) per lasciare
   * loro il posto: sono APPOGGIATI ai bordi, mezzi dentro e mezzi fuori, ed è
   * quella sovrapposizione a dare profondità alla scena.
   */
  @media (min-width: 1100px) {
    /*
     * Lo spazio ai lati è largo QUANTO METÀ cartellino: così ognuno resta per
     * metà fuori e per metà appoggiato al video. Con un margine più stretto
     * finivano quasi tutti sopra l'immagine e coprivano la tabella, che è
     * l'unica cosa che il video deve far vedere.
     */
    .video-scena { padding-inline: 6.5rem; }
    .volanti { display: block; margin: 0; }

    .volante {
      position: absolute;
      z-index: 2;
      width: 13rem;
      padding: 0.75rem 0.875rem;
      box-shadow: var(--shadow-lg);
    }
    /* Agli angoli, dove la schermata è meno densa: in alto a sinistra c'è la
       testata del menu, in basso le ultime righe della tabella. */
    /* Non più in alto di così: sopra c'è la finta barra del browser, e
       coprire l'indirizzo toglie proprio il dettaglio che dice "questa è
       un'applicazione web vera". */
    .volante-1 { top: 14%; left: 0; }
    .volante-2 { top: 38%; right: 0; }
    .volante-3 { bottom: 5%; left: 0; }
  }

  /* L'oscillazione: piccola e lenta, altrimenti distrae da ciò che sta
     spiegando. Le classi arrivano da global.css, qui si sfasano soltanto
     così i tre non si muovono all'unisono come un blocco solo. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 1100px) {
    .volante { animation: float-y 6s var(--ease-out-quart) infinite; }
    .volante-2 { animation-duration: 7.4s; animation-delay: -2.1s; }
    .volante-3 { animation-duration: 5.6s; animation-delay: -3.4s; }
  }

  .video-piede {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 1.25rem;
  }
  .video-nota {
    font-size: 0.8125rem;
    line-height: 1.6;
    /* Come il sommario: sul gradiente il bianco al 66% dei token non basta,
       e questa riga è piccola — le serve più contrasto, non meno. */
    color: rgb(255 255 255 / 0.82);
  }

  .video-frame {
    max-width: 54rem;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    box-shadow: var(--shadow-lg);
  }


  /* Finta barra del browser: chiarisce che si sta guardando un'applicazione
     web e non un video promozionale. */
  .video-chrome {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper-2);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-soft-2);
  }
  .video-url {
    margin-left: 0.625rem;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
  }

  /* Rapporto fisso: lo spazio è già riservato prima che il video arrivi,
     quindi nessuno spostamento di layout (CLS). */
  .video-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-soft);
  }

  /*
   * Da 1100px in su nessun ritocco: il riquadro è largo 800-880px, la
   * registrazione ci sta quasi tutta e la tabella si legge alla sua misura
   * naturale. Sotto quella soglia serve invece un'inquadratura diversa — sta
   * più in basso, subito DOPO queste regole di base, e non è un vezzo di
   * ordinamento: deve riscrivere `object-fit`, e a parità di specificità
   * vince la regola che viene dopo.
   */
  .video-poster,
  .video-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-poster {
    z-index: 1;
    transition: opacity 400ms var(--ease-out-quart);
  }
  .video-poster[hidden] {
    opacity: 0;
    pointer-events: none;
  }

  /*
   * FRA 641 E 1099px LA REGISTRAZIONE VA MOSTRATA 1:1, NON RIMPICCIOLITA.
   *
   * La sorgente è 1280×720 e riprende un gestionale da desktop: i testi
   * dell'interfaccia lì dentro sono alti ~13px. Con `object-fit: cover` il
   * fotogramma viene riscalato per riempire il riquadro, e il riquadro su
   * telefono è largo 348px (100vw meno il padding di .wrap e i bordi della
   * cornice): fattore 0,27, cioè l'intera interfaccia rimpicciolita a poco
   * più di un quarto — trattini grigi al posto di una tabella. Su un tablet,
   * però, il riquadro è largo il doppio: a 768px la finestra 1:1 è larga
   * 710px di sorgente e inquadra più di mezza schermata con i testi alla
   * loro misura vera. Per QUESTA fascia è la soluzione giusta.
   *
   * `object-fit: none` toglie del tutto il riscalamento: un pixel della
   * registrazione = un pixel CSS, quindi i 13px dell'applicazione restano
   * 13px anche sul telefono. Si vede una fetta più stretta, ma quella fetta
   * SI LEGGE. Il prezzo, dichiarato: su uno schermo a densità doppia o tripla
   * la sorgente viene ingrandita 2-3× in pixel dispositivo e i bordi sono più
   * morbidi di prima. Non è aggirabile in CSS con una sorgente da 1280px —
   * la correzione definitiva è ricodificare la registrazione a 2560×1440,
   * e quel giorno queste regole non cambiano di una riga.
   *
   * La fascia dove serve è 641–1099.98px, non tutto ciò che sta sotto i 1100.
   * A 768px la finestra 1:1 è larga 710px di sorgente: le colonne ci stanno
   * tutte. Su un telefono da 348px, invece, inquadra poco più di un QUARTO di
   * fotogramma (348 su 1280) e, con la Y al 40%, apre a y=114 — cioè sotto la
   * riga dei filtri, che finisce a y=112. Misurato sui fotogrammi veri: si
   * vedono il nome del fornitore e il numero del documento, e basta. Niente
   * importi, niente badge DA PAGARE/PAGATA, niente intestazioni. Nitida e
   * muta. Lì comanda il blocco successivo, che ritaglia in scala: ~7px CSS di
   * testo, ma la tabella si legge come tabella. Nitidezza e leggibilità non
   * sono la stessa cosa, e su telefono conta la seconda: un fotogramma che
   * non racconta più il prodotto non guadagna niente a essere nitido.
   *
   * `object-position`: la X è in pixel della sorgente e non in percentuale,
   * perché l'ancoraggio deve restare fermo mentre il riquadro cambia misura —
   * -260px porta al bordo sinistro la colonna FORNITORE e lascia fuori il
   * menu laterale, che su schermo stretto non aggiunge niente. La Y resta in
   * percentuale: si adatta all'altezza del riquadro senza mai sfondare il
   * fotogramma, e apre appena sopra la riga delle intestazioni di colonna.
   */
  @media (max-width: 1099.98px) {
    .video-poster,
    .video-el {
      object-fit: none;
      object-position: -260px 40%;
    }
  }

  /*
   * Su telefono il riquadro diventa più ALTO che largo.
   *
   * Ed è il RAPPORTO a decidere quanto fotogramma entra, non la larghezza
   * dello schermo. Con `object-fit: cover` e un riquadro più stretto del 16/9
   * della sorgente il fattore lo impone l'altezza, quindi la fetta visibile è
   * larga sempre 720 × (rapporto) pixel di sorgente: con 9/10 fanno 648, cioè
   * metà esatta dei 1280, e in altezza entra tutto il fotogramma.
   *
   * Le alternative, misurate sui fotogrammi veri (colonne della sorgente:
   * bordo della scheda a 234, FORNITORE a 273, DOCUMENTO a 545, IMPORTO a
   * 707-750, badge STATO a 790-843, RIPARTIZIONE — testo grigio segnaposto —
   * da 924): con 4/5 la fetta è 576px e i badge di stato restano fuori; con
   * 1/1 è 720px ma il testo scende a 6,3px CSS. 9/10 è l'unico rapporto che
   * tiene dentro le quattro colonne che contano.
   *
   * Nessun rischio di CLS: l'altezza continua a derivare dalla larghezza
   * prima che il video arrivi, esattamente come faceva il 16/9.
   *
   * Niente più `max-height`: serviva perché con `object-fit: none` un riquadro
   * più alto del fotogramma lasciava scoperta una striscia di fondo, e col 4/5
   * il caso si presentava davvero fra i 619 e i 640px di viewport. Con 9/10 il
   * riquadro non arriva mai a 648px di altezza sotto i 640 di viewport, e
   * comunque `cover` riempie sempre, per definizione: quella riga è diventata
   * inerte due volte.
   *
   * IL PREZZO, DICHIARATO. La sorgente viene disegnata a 0,537 della sua
   * misura (687px CSS su un riquadro da 348), quindi i 13px dell'interfaccia
   * diventano ~7px CSS. Non è però una perdita di dettaglio vera: a densità
   * doppia i 648 pixel di sorgente inquadrati finiscono su 696 pixel fisici
   * (i 348 CSS del riquadro, per due), cioè 1,07× — praticamente uno a uno,
   * i bordi restano puliti. La correzione definitiva resta ricodificare a
   * 2560×1440, e quel giorno queste regole non cambiano.
   *
   * COSA RESTA FUORI, e va saputo: la barra laterale del menu (i primi ~213px
   * della sorgente), la colonna RIPARTIZIONE (segnaposto grigio, da 924) e i
   * tasti in alto a destra — quindi anche il menu dell'importazione, che
   * intorno al quinto secondo si apre a x≈937. Il filmato dura 7,5s e per i
   * primi 6,3 sta sull'elenco delle fatture: è quella la parte che racconta il
   * prodotto, ed è quella che si è scelto di inquadrare. Nell'ultimo secondo
   * passa alla pagina «Importa Fatture», e lì nel ritaglio entra per intero il
   * pannello «Come funziona»: cambia scena, non si svuota.
   */
  @media (max-width: 640px) {
    .video-stage {
      /* Rapporto fisso, quindi lo spazio resta riservato prima che il video
         arrivi: CLS invariato, zero. Cambia solo il numero. */
      aspect-ratio: 9 / 10;
    }

    /*
     * Il ritaglio, in PERCENTUALE e non in pixel di sorgente: così
     * l'inquadratura è la stessa su un telefono da 320 e su uno da 430 —
     * cambia la misura, non che cosa si vede. Con `object-position: -260px`
     * la finestra si stringeva a 278px sui telefoni piccoli e la tabella
     * spariva: una composizione non si ancora in pixel quando il riquadro è
     * fluido.
     *
     * 37% porta il bordo sinistro a x≈234 della sorgente e quello destro a
     * x≈882: entrano il bordo della scheda, i filtri (Tutte / Da pagare /
     * Pagate), le intestazioni e le colonne FORNITORE, DOCUMENTO, IMPORTO e
     * STATO coi badge colorati. Il taglio cade nel bianco fra i badge (che
     * finiscono a 843) e la colonna RIPARTIZIONE (che parte a 924), quindi
     * non spezza nessuna parola.
     *
     * La Y è inerte finché il riquadro è più stretto del 16/9 della sorgente
     * (non c'è avanzo verticale da spostare): resta 50%, il valore neutro.
     *
     * Le stesse due righe per poster e video, e non è una ripetizione da
     * accorpare altrove: con `cover` la geometria dipende SOLO dal riquadro —
     * non dalla variante di srcset scaricata, come invece accadeva con
     * `none`, dove il disegno del poster vale quanto dice `sizes`. Stesso
     * rapporto sorgente (1280×720, e così le varianti 640 e 960), stesso
     * ritaglio: combaciano al pixel e nell'istante in cui parte la
     * riproduzione l'immagine non salta.
     *
     * Deve stare DOPO il blocco `max-width: 1099.98px`: stessa specificità,
     * vince la regola che viene dopo. Spostarlo più in su rimette `none`.
     */
    .video-poster,
    .video-el {
      object-fit: cover;
      object-position: 37% 50%;
    }
  }


  /* ═══════════════════════════════════════════════════════════════════════
     LA SCENA (pin nativo + scrub CSS) — da 1100px in su

     Il contenitore alto è la durata della scena, il palco sticky è
     l'inquadratura, la timeline `--cine` è la traversata del contenitore
     (view-timeline): lo scrub lo fa il browser, sul compositore.

     La FLUIDITÀ arriva da fuori: Lenis, montato a livello di sito in
     Base.astro, ammorbidisce lo scroll di tutta la pagina, e la scena —
     che lo insegue — diventa burrosa senza sapere niente di lui.

     STORIA, per chi ci rimette mano: qui prima c'erano uno snap CSS e poi
     un "volo a colpo unico" (lock della rotella alla revolut.com, portato
     da BVEX/HeroRevolut). Lo snap era interrompibile a metà; il lock
     reggeva ogni stress test ma alla mano dava comando strappato — ogni
     cambio di direzione era un dirottamento di un secondo. La lezione:
     su una sezione a metà pagina l'intercetto della rotella non perdona;
     lo scroll resta dell'utente, la morbidezza si mette SOTTO (Lenis),
     non sopra.

     Le fette della corsa (percentuali della fase `contain`):

       0%  → ~60% .... il video cresce dalla miniatura alla misura piena
       45% → ~76% .... i tre cartellini si posano uno alla volta
       68% → ~82% .... la didascalia e il collegamento chiudono la scena

     Il titolo non si anima: parte composto, la scena è leggibile in ogni
     stato intermedio — che ora è un posto legittimo dove fermarsi.
     ═══════════════════════════════════════════════════════════════════════ */
  /* Il video non è mai fermo: cresce veloce fino alla sua misura (60% della
     corsa), poi continua ad avvicinarsi piano — fino a 1.1 — salendo di un
     soffio. Il respiro sotto lo garantisce la misura di partenza ridotta
     del riquadro (50rem, vedi sotto): a crescita finita occupa MENO di
     quanto occupava il riquadro pieno da fermo, e la didascalia non viene
     mai raggiunta. */
  @keyframes cine-video {
    0%   { transform: scale(0.55) translate3d(0, 9svh, 0); }
    60%  { transform: scale(1) translate3d(0, 0, 0); }
    100% { transform: scale(1.1) translate3d(0, -1svh, 0); }
  }
  @keyframes cine-volante {
    from { opacity: 0; transform: translate3d(0, 28px, 0) scale(0.92); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes cine-piede {
    from { opacity: 0; transform: translate3d(0, 16px, 0); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: no-preference) and (min-width: 1100px) {
    @supports (animation-timeline: view()) {
      .video-sezione {
        /* Il respiro blu DOPO la scena: la fascia continua sotto il palco
           prima di passare al bianco del metodo. */
        padding-bottom: clamp(4rem, 12svh, 9rem);
      }

      /*
       * Il contenitore alto è la durata della scena.
       *
       * Era 300svh (tre schermi di corsa agganciata). Sceso a 220 per una
       * ragione che non è di animazione ma di PAGINA: con 300 questa fascia
       * blu pesava 3594px, cioè il 37% dell'intera home — e i fondi della
       * home dovrebbero leggersi come un'onda bianco → azzurro → blu ripetuta
       * due volte, mentre così era un blocco enorme e poi un'eco (il blu
       * della chiusura è 616px). Non era il colore a essere sbagliato, erano
       * le proporzioni.
       *
       * Cosa si perde: la corsa a mano è più rapida di un terzo. Il "volo"
       * (l'intercettazione della rotella, in fondo al file) la completa in un
       * gesto solo comunque, quindi la lunghezza serve solo allo scrub
       * manuale. Sotto i ~180svh la corsa comincia davvero a saltare.
       */
      .cine-alt {
        height: 220svh;
        view-timeline: --cine block;
        /* Il nome della timeline passa da una variabile, e non è un vezzo:
           il minificatore di produzione accorpa `animation-timeline` dentro
           la scorciatoia `animation`, che non la ammette, e il browser
           scarta la dichiarazione INTERA — in dev tutto si muoveva, in
           produzione la scena era un fermo immagine. Stesso inciampo già
           annotato su .read-progress in global.css. La variabile eredita:
           tutti i discendenti la usano senza ridichiararla. */
        --ctl: --cine;
      }

      .cine-stage {
        position: sticky;
        top: var(--nav-h);
        height: calc(100svh - var(--nav-h));
        overflow: clip;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: 1.5rem;
      }

      /* Il fondale segue la scena, non la propria traversata. */
      .fx-fondo, .fx-lento, .fx-medio, .fx-veloce {
        animation-timeline: var(--ctl);
        animation-range: normal;
      }

      /* Il numero del riferimento: il prodotto parte miniatura e CRESCE
         fino a riempire la sua misura mentre si scorre. Solo transform,
         quindi la crescita gira sul compositore. */
      .video-scena {
        transform-origin: 50% 42%;
        animation: cine-video linear both;
        animation-timeline: var(--ctl);
        animation-range: contain 0% contain 90%;
        will-change: transform;
      }

      /* Dentro la scena il riquadro parte più contenuto: 50rem × 1.1 di
         crescita finale = 55rem, cioè il video finisce grande quanto era
         prima DA FERMO — tutta la crescita resta dentro lo spazio che il
         riquadro pieno già occupava, senza schiacciarsi sulla didascalia. */
      .video-frame {
        max-width: 50rem;
      }

      /* I cartellini si posano quando il video ha finito di crescere.
         La scorciatoia `animation` qui SOSTITUISCE anche l'oscillazione
         float-y del blocco più su: dentro una scena comandata dallo
         scroll, un moto a tempo remerebbe contro. */
      .volante {
        animation: cine-volante linear both;
        animation-timeline: var(--ctl);
      }
      .volante-1 { animation-range: contain 45% contain 58%; }
      .volante-2 { animation-range: contain 54% contain 67%; }
      .volante-3 { animation-range: contain 63% contain 76%; }

      .video-piede {
        animation: cine-piede linear both;
        animation-timeline: var(--ctl);
        animation-range: contain 68% contain 82%;
      }
    }
  }
</style>

<script>
  const frames = document.querySelectorAll<HTMLElement>(".video-stage");

  for (const stage of frames) {
    const video = stage.querySelector<HTMLVideoElement>("[data-loop]");
    const poster = stage.querySelector<HTMLElement>("[data-poster]");
    if (!video) continue;

    // Chi ha chiesto meno movimento resta sul fotogramma fermo: è comunque
    // una schermata leggibile del prodotto, non si perde informazione.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) continue;

    let started = false;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (!started) {
              started = true;
              video.preload = "auto";
            }
            /* `play()` restituisce una promise che il browser rifiuta se
               nega la riproduzione automatica: in quel caso resta il poster,
               che è già un'immagine sensata. Non c'è niente da recuperare,
               ma va intercettata o finisce in console come errore. */
            video.play().then(
              () => poster?.setAttribute("hidden", ""),
              () => {},
            );
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: "200px 0px", threshold: 0.15 },
    );

    observer.observe(stage);
  }
</script>

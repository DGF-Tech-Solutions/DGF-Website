---
/*
 * Intestazione di sezione: indice numerico + etichetta + titolo.
 * È la firma ricorrente della direzione Swiss — la struttura si dichiara.
 */
interface Props {
  /** Indice della sezione: "001", "002"… */
  index?: string;
  /** Etichetta mono sopra il titolo. */
  label?: string;
  title: string;
  /** Sottotitolo/occhiello descrittivo. */
  lead?: string;
  /** Livello dell'intestazione: h2 di default. */
  as?: "h1" | "h2" | "h3";
  align?: "start" | "center";
  class?: string;
}

const {
  index,
  label,
  title,
  lead,
  as: Tag = "h2",
  align = "start",
  class: className = "",
} = Astro.props;

const sizeClass = Tag === "h1" ? "t-h1" : "t-h2";
---

<div
  class:list={[
    "section-heading",
    className,
    align === "center" && "text-center",
  ]}
>
  {
    (index || label) && (
      <div
        class:list={[
          "flex items-baseline gap-3 pb-4",
          align === "center" && "justify-center",
        ]}
      >
        {index && <span class="t-index">{index}</span>}
        {label && <span class="t-label">{label}</span>}
      </div>
    )
  }

  <Tag class={sizeClass} set:html={title} />

  {lead && <p class:list={["t-lead mt-5 max-w-2xl", align === "center" && "mx-auto"]}>{lead}</p>}
</div>

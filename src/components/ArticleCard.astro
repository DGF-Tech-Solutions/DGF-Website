---
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/Icon.astro";
import { formatDate, isoDate } from "@/lib/format";

interface Props {
  entry: CollectionEntry<"blog">;
  /** Livello del titolo: h2 dopo un h1, h3 dentro una sezione con h2. */
  as?: "h2" | "h3";
}

const { entry, as: Heading = "h3" } = Astro.props;
const d = entry.data;

/* Testo su cui lavora la ricerca: accenti rimossi e tutto in minuscolo, così
   il confronto lato client è una semplice `includes`. */
const haystack = `${d.title} ${d.excerpt} ${d.category} ${d.author}`
  .toLowerCase()
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "");
---

<a
  href={`/blog/${entry.id}`}
  class="card group flex flex-col p-6"
  data-search={haystack}
  data-cat={d.category}
>
  <div class="flex flex-wrap items-center gap-3">
    <span class="chip">{d.category}</span>
    <time datetime={isoDate(d.date)} class="t-small">{formatDate(d.date)}</time>
  </div>

  <Heading class="t-h3 mt-4 transition-colors group-hover:text-[var(--color-navy)]">
    {d.title}
  </Heading>

  <p class="t-body mt-2 flex-1 text-[0.875rem]">{d.excerpt}</p>

  <span class="mt-5 flex items-center justify-between gap-3">
    <span class="t-small">
      {d.readingTime ? `${d.readingTime} min di lettura` : "Leggi l'articolo"}
    </span>
    <Icon
      name="arrow-right"
      size={17}
      class="text-[var(--color-navy)] transition-transform group-hover:translate-x-1"
    />
  </span>
</a>

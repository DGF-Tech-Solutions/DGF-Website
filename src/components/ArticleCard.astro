---
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/Icon.astro";
import { readingMinutes } from "@/lib/format";

/*
 * Scheda articolo, ricalcata su quelle di /guide di Nexia:
 * riga superiore con la categoria a sinistra e il tempo di lettura a destra,
 * titolo su due righe, riassunto, e in fondo l'invito a leggere.
 *
 * Niente data in evidenza: su un blog con pochi pezzi la data invecchia il
 * contenuto invece di qualificarlo. Resta nel markup (e nei dati
 * strutturati) ma non occupa la riga migliore della scheda.
 */
interface Props {
  entry: CollectionEntry<"blog">;
  /** Livello del titolo: h2 dopo un h1, h3 dentro una sezione con h2. */
  as?: "h2" | "h3";
}

const { entry, as: Heading = "h3" } = Astro.props;
const d = entry.data;
const minutes = d.readingTime ?? readingMinutes(entry.body ?? "");

const haystack = `${d.title} ${d.excerpt} ${d.category} ${d.author}`
  .toLowerCase()
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "");
---

<a
  href={`/blog/${entry.id}`}
  class="card group flex flex-col p-6"
  data-search={haystack}
  data-cat={d.category}
>
  <div class="flex items-center justify-between gap-3">
    <span class="tag">{d.category}</span>
    <span class="meta">
      <Icon name="clock" size={13} />
      {minutes} min
    </span>
  </div>

  <Heading class="t-h3 mt-4 transition-colors group-hover:text-[var(--color-navy)]">
    {d.title}
  </Heading>

  <p class="t-body mt-3 flex-1 text-[0.875rem]">{d.excerpt}</p>

  <span class="read-more">
    Leggi l'articolo
    <Icon name="arrow-right" size={15} />
  </span>
</a>

<style>
  /* Chip di categoria: maiuscoletto piccolo su fondo azzurro. */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.625rem;
    border-radius: var(--radius-sm);
    background: var(--color-soft);
    color: var(--color-navy);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    white-space: nowrap;
  }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink-3);
    white-space: nowrap;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .read-more :global(svg) {
    transition: transform var(--dur) var(--ease-out-quart);
  }
  @media (hover: hover) {
    .group:hover .read-more :global(svg) { transform: translateX(3px); }
  }
</style>

---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/Icon.astro";
import { kindLabel } from "@/lib/project";

/*
 * Scheda progetto, sorella di ArticleCard: stessa impaginazione interna
 * (riga categoria + metadato, titolo, riassunto, invito in fondo) e stesso
 * ingombro nella griglia, con in più l'anteprima del lavoro e i tag.
 *
 * La misura è quella della scheda articolo di proposito: progetti e blog sono
 * due elenchi paralleli, e schede di larghezza diversa li farebbero sembrare
 * due sezioni di siti diversi.
 *
 * In fondo, a sinistra, l'etichetta sulla natura del progetto: dichiarare che
 * un lavoro è dimostrativo, o che è il nostro prodotto e non una commessa,
 * costa poco e vale molto, e va detto sulla scheda, non solo dentro al caso.
 */
interface Props {
  entry: CollectionEntry<"portfolio">;
  /** Carica l'immagine subito. Solo se la scheda è sopra la piega. */
  eager?: boolean;
  /**
   * Livello del titolo: dopo un h1 (pagine hub) serve h2, dentro una sezione
   * che ha già il suo h2 serve h3. Saltare un livello è un errore di
   * accessibilità: chi usa lo screen reader naviga per titoli.
   */
  as?: "h2" | "h3";
}

const { entry, eager = false, as: Heading = "h3" } = Astro.props;
const d = entry.data;

/* Testo su cui lavora la ricerca dell'Explorer. Comprende anche servizi e
   tecnologie: chi cerca "Stripe" o "SEO" si aspetta di trovare il progetto
   che li usa, non solo quello che li ha nel titolo. */
const haystack = `${d.client} ${d.title} ${d.summary} ${d.category} ${d.services.join(" ")} ${d.stack.join(" ")}`
  .toLowerCase()
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "");

/* Due tag più il contatore: è quanto entra in una riga sola alla larghezza
   della scheda. Il CSS impedisce comunque l'andata a capo, ma tenere basso il
   numero evita che debba troncare. L'elenco completo sta nella scheda tecnica
   del progetto. */
const TAG_LIMIT = 2;
const allTags = [...d.services, ...d.stack];
const shownTags = allTags.slice(0, TAG_LIMIT);
const hiddenTags = allTags.length - shownTags.length;
---

<a
  href={`/portfolio/${entry.id}`}
  class="card group flex flex-col overflow-hidden"
  data-search={haystack}
  data-cat={[d.category, ...d.services].join("|")}
>
  <!-- 16:9 e non 16:10: l'anteprima serve a far capire di che tipo di
       software si tratta, e per quello bastano meno pixel di quanti ne
       servano a renderla il pezzo più alto della scheda. -->
  <div class="cover overflow-hidden border-b border-[var(--color-line)] bg-[var(--color-paper-2)]">
    <Image
      src={d.cover}
      alt={`Anteprima del progetto ${d.client}`}
      widths={[340, 460, 620, 780]}
      sizes="(min-width: 1024px) 32vw, (min-width: 640px) 48vw, 90vw"
      quality={74}
      loading={eager ? "eager" : "lazy"}
      class="h-full w-full object-cover object-top transition-transform duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:scale-[1.04]"
    />
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-center justify-between gap-3">
      <span class="tag">{d.category}</span>
      <span class="meta tabular">{d.year}</span>
    </div>

    <Heading class="t-h3 mt-4 transition-colors group-hover:text-[var(--color-navy)]">
      {d.title}
    </Heading>

    <p class="summary t-body mt-3 flex-1 text-[0.875rem]">{d.summary}</p>

    <!-- Servizi e tecnologie: i primi pieni, le seconde a filo. Sono due tipi
         di informazione diversi e distinguerli evita di leggerli come un
         elenco unico e indistinto. -->
    <ul class="tag-row mt-5">
      {shownTags.map((t, i) => (
        <li class:list={["tag-sm", i >= d.services.length && "tag-line"]}>{t}</li>
      ))}
      {hiddenTags > 0 && <li class="tag-sm tag-more">+{hiddenTags}</li>}
    </ul>

    <div class="mt-6 flex items-center justify-between gap-3">
      <span class="meta">{kindLabel(d.kind, d.client)}</span>
      <span class="read-more">
        Vedi il progetto
        <Icon name="arrow-right" size={15} />
      </span>
    </div>
  </div>
</a>

<style>
  .cover { aspect-ratio: 16 / 9; }

  /*
   * Il riassunto si ferma a due righe. Chi scorre l'elenco confronta i
   * progetti, non li legge: due righe bastano a capire di cosa si tratta, e
   * il testo per intero sta nella pagina del caso.
   */
  .summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* `.tag` sta in global.css, condivisa con ArticleCard. */

  /*
   * Una riga, sempre. Andando a capo i tag spingono giù il piede della scheda
   * e due schede affiancate finiscono con i pulsanti disallineati, che è
   * proprio il disordine che questa griglia deve evitare.
   *
   * Se un nome è troppo lungo si accorcia con i puntini invece di mandare a
   * capo: il contatore in fondo dice comunque quanti altri ce ne sono, quindi
   * non si perde informazione.
   */
  .tag-row {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .tag-sm {
    display: inline-block;
    min-width: 0;
    padding: 0.25rem 0.5625rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: var(--color-soft);
    color: var(--color-navy);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Le tecnologie: stesso ingombro, peso visivo minore. */
  .tag-line {
    background: transparent;
    border-color: var(--color-line);
    color: var(--color-ink-3);
    font-weight: 500;
  }

  /* Il contatore non si accorcia mai: è l'unico pezzo che non si può perdere. */
  .tag-more {
    flex: 0 0 auto;
    background: transparent;
    border-color: var(--color-line);
    color: var(--color-ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* `.meta` e `.read-more` stanno in global.css. Qui il richiamo non prende
     margine sopra: divide la riga con l'etichetta di natura del progetto, e
     la spaziatura la dà il contenitore. Il valore predefinito è già zero,
     quindi non serve scrivere niente. */
</style>

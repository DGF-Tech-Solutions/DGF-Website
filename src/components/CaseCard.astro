---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/Icon.astro";

interface Props {
  entry: CollectionEntry<"portfolio">;
  /** Carica l'immagine subito. Solo se la scheda è sopra la piega. */
  eager?: boolean;
  /**
   * Livello del titolo: dopo un h1 (pagine hub) serve h2, dentro una sezione
   * che ha già il suo h2 serve h3. Saltare un livello è un errore di
   * accessibilità — chi usa lo screen reader naviga per titoli.
   */
  as?: "h2" | "h3";
}

const { entry, eager = false, as: Heading = "h3" } = Astro.props;
const d = entry.data;
---

<a href={`/portfolio/${entry.id}`} class="card group flex flex-col overflow-hidden">
  <div class="ratio-16-10 overflow-hidden border-b border-[var(--color-line)] bg-[var(--color-paper-2)]">
    <Image
      src={d.cover}
      alt={`Anteprima del progetto ${d.client}`}
      widths={[340, 460, 620, 780]}
      sizes="(min-width: 1024px) 32vw, (min-width: 640px) 48vw, 90vw"
      quality={74}
      loading={eager ? "eager" : "lazy"}
      class="h-full w-full object-cover object-top transition-transform duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:scale-[1.04]"
    />
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2">
      <span class="chip">{d.category}</span>
      <span class="t-small tabular ml-auto">{d.year}</span>
    </div>

    <Heading class="t-h3 mt-3">{d.client}</Heading>
    <p class="t-body mt-2 flex-1 text-[0.875rem]">{d.summary}</p>

    <div class="mt-5 flex items-center justify-between gap-3">
      {/*
        Etichetta di natura del progetto, sempre presente: dichiarare che un
        lavoro è dimostrativo costa poco e vale molto.
      */}
      <span class="t-small">
        {d.kind === "dimostrativo" ? "Progetto dimostrativo" : "Progetto cliente"}
      </span>
      <Icon
        name="arrow-right"
        size={17}
        class="text-[var(--color-navy)] transition-transform group-hover:translate-x-1"
      />
    </div>
  </div>
</a>

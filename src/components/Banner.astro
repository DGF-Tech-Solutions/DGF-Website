---
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/components/Icon.astro";

/*
 * Banner informativo a tutta larghezza.
 *
 * Nasce per una ragione precisa: dichiarare che i progetti mostrati sono
 * studi interni e non lavori su commessa. Una nota in corpo piccolo in fondo
 * alla pagina non è trasparenza, è una postilla. Se una cosa va detta, va
 * detta dove si guarda.
 */
interface Props {
  icon?: IconName;
  title: string;
  /** Tono: `info` azzurro (default), `plain` grigio più discreto. */
  tone?: "info" | "plain";
  class?: string;
}

const { icon = "shield", title, tone = "info", class: className = "" } = Astro.props;
---

<div class:list={["banner", `banner-${tone}`, className]}>
  <span class="banner-icon">
    <Icon name={icon} size={20} />
  </span>
  <div>
    <p class="banner-title">{title}</p>
    <div class="banner-body"><slot /></div>
  </div>
</div>

<style>
  .banner {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 1.375rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
  }
  .banner-info {
    background: var(--color-soft);
    border-color: color-mix(in srgb, var(--color-navy) 18%, transparent);
  }
  .banner-plain { background: var(--color-paper-2); }

  .banner-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-paper);
    color: var(--color-navy);
    box-shadow: var(--shadow-xs);
  }

  .banner-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  .banner-body {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-ink-3);
  }
  .banner-body :global(strong) { color: var(--color-ink); font-weight: 600; }
  .banner-body :global(a) {
    color: var(--color-navy);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

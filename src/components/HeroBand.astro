---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/components/Icon.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

/*
 * Testata a fascia blu piena, ricalcata sugli hero interni di Nexia
 * (/guide, /blog): fondo navy a tutta larghezza, badge in pillola, titolo
 * bianco grande, occhiello, due CTA e l'illustrazione a destra.
 *
 * Sostituisce la testata chiara nelle pagine indice. Il motivo è di ritmo:
 * una fascia colorata in cima separa nettamente "dove sono" da "cosa c'è",
 * e fa risaltare la barra di ricerca che arriva subito sotto, su bianco.
 *
 * Il titolo NON si anima in opacità: è l'elemento LCP di queste pagine.
 */
interface Props {
  badge: string;
  badgeIcon?: IconName;
  /** Ammette HTML: serve per lo <span class="t-dim"> nella seconda metà. */
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
  illustration?: ImageMetadata;
  illustrationAlt?: string;
  /** Azione principale. */
  cta?: { label: string; href: string };
  /** Azione secondaria. */
  ctaAlt?: { label: string; href: string };
}

const {
  badge,
  badgeIcon,
  title,
  lead,
  crumbs,
  illustration,
  illustrationAlt = "",
  cta,
  ctaAlt,
} = Astro.props;
---

<section class="hero-band band-brand">
  <div class="wrap relative z-10">
    <Breadcrumbs items={crumbs} class="pt-5 pb-8 sm:pt-6" />

    <div
      class:list={[
        "grid items-center gap-10 pb-14 sm:pb-16",
        illustration && "lg:grid-cols-[1.05fr_0.95fr] lg:gap-12 lg:pb-20",
      ]}
    >
      <div>
        <span class="badge-brand">
          {badgeIcon && <Icon name={badgeIcon} size={13} />}
          {badge}
        </span>

        <h1 class="t-h1 mt-6 max-w-3xl anim-rise" set:html={title} />

        {lead && <p class="hero-lead mt-6 max-w-xl anim-fade-rise delay-2">{lead}</p>}

        {
          (cta || ctaAlt) && (
            <div class="mt-8 flex flex-wrap gap-3 anim-fade-rise delay-3">
              {cta && (
                <a href={cta.href} class="btn btn-on-dark btn-lg">
                  {cta.label}
                  <Icon name="arrow-right" size={17} />
                </a>
              )}
              {ctaAlt && (
                <a href={ctaAlt.href} class="btn hero-btn-ghost btn-lg">
                  {ctaAlt.label}
                </a>
              )}
            </div>
          )
        }
      </div>

      <!--
        L'illustrazione usa `anim-rise` (solo transform) e NON una dissolvenza:
        sta sopra la piega, e un'opacità che riparte la lascia invisibile —
        in sviluppo l'HMR riavvia le animazioni a ogni modifica del CSS.
      -->
      {
        illustration && (
          <div class="anim-rise mx-auto w-full max-w-[20rem] lg:max-w-[28rem]">
            <Image
              src={illustration}
              alt={illustrationAlt}
              widths={[320, 460, 620]}
              sizes="(min-width: 1024px) 448px, 300px"
              loading="eager"
              fetchpriority="high"
              class="w-full"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Il fondo blu, i token bianchi, i cerchi e le briciole di pane stanno in
     `.band-brand` (global.css), condivisa con la testata delle pagine di
     progetto. Qui restano solo le parti proprie di questo componente. */

  .hero-lead {
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.125rem);
    line-height: 1.65;
    color: rgb(255 255 255 / 0.82);
  }

  .hero-btn-ghost {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    border-color: rgb(255 255 255 / 0.28);
  }
  @media (hover: hover) {
    .hero-btn-ghost:hover {
      background: rgb(255 255 255 / 0.2);
      border-color: rgb(255 255 255 / 0.45);
      transform: translateY(-1px);
    }
  }
</style>

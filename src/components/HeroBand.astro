---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/components/Icon.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

/*
 * Testata a fascia blu piena, ricalcata sugli hero interni di Nexia
 * (/guide, /blog): fondo navy a tutta larghezza, badge in pillola, titolo
 * bianco grande, occhiello, due CTA e l'illustrazione a destra.
 *
 * Sostituisce la testata chiara nelle pagine indice. Il motivo è di ritmo:
 * una fascia colorata in cima separa nettamente "dove sono" da "cosa c'è",
 * e fa risaltare la barra di ricerca che arriva subito sotto, su bianco.
 *
 * Il titolo NON si anima in opacità: è l'elemento LCP di queste pagine.
 */
interface Props {
  badge: string;
  badgeIcon?: IconName;
  /** Ammette HTML: serve per lo <span class="t-dim"> nella seconda metà. */
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
  illustration?: ImageMetadata;
  illustrationAlt?: string;
  /** Azione principale. */
  cta?: { label: string; href: string };
  /** Azione secondaria. */
  ctaAlt?: { label: string; href: string };
}

const {
  badge,
  badgeIcon,
  title,
  lead,
  crumbs,
  illustration,
  illustrationAlt = "",
  cta,
  ctaAlt,
} = Astro.props;
---

{/* `under-nav`: la fascia blu arriva fino al bordo della finestra e la barra
    ci galleggia sopra. Senza, fra il bordo e l'inizio del blu resterebbe una
    striscia bianca alta quanto la barra. Le pagine che usano questa testata
    non devono più fare niente per la barra: è opaca sempre. Su fondo blu una trasparente
    lascerebbe logo e voci, che sono blu scuro, illeggibili. */}
<section class="hero-band band-brand under-nav">
  <div class="wrap relative z-10">
    <Breadcrumbs items={crumbs} class="pt-5 pb-8 sm:pt-6" />

    <div
      class:list={[
        "grid items-center gap-10 pb-14 sm:pb-16",
        illustration && "lg:pb-20",
      ]}
    >
      <div>
        <span class="badge-brand">
          {badgeIcon && <Icon name={badgeIcon} size={13} />}
          {badge}
        </span>

        <h1 class="t-h1 mt-6 max-w-3xl anim-rise" set:html={title} />

        {lead && <p class="hero-lead mt-6 max-w-xl anim-fade-rise delay-2">{lead}</p>}

        {
          (cta || ctaAlt) && (
            <div class="mt-8 flex flex-wrap gap-3 anim-fade-rise delay-3">
              {cta && (
                <a href={cta.href} class="btn btn-on-dark btn-lg">
                  {cta.label}
                  <Icon name="arrow-right" size={17} />
                </a>
              )}
              {ctaAlt && (
                <a href={ctaAlt.href} class="btn hero-btn-ghost btn-lg">
                  {ctaAlt.label}
                </a>
              )}
            </div>
          )
        }
      </div>

      <!--
        L'illustrazione usa `anim-rise` (solo transform) e NON una dissolvenza:
        sta sopra la piega, e un'opacità che riparte la lascia invisibile —
        in sviluppo l'HMR riavvia le animazioni a ogni modifica del CSS.
      -->
    </div>
  </div>

  {/* Fuori dalla griglia e dopo il `wrap`: da 1024 px in su è appoggiata al
      bordo destro della finestra e si dissolve verso sinistra; sotto torna
      nel flusso, a tutta larghezza, dove deve stare DOPO il testo. */}
  {
    illustration && (
      <div class="hb-foto">
        <Image
          src={illustration}
          alt={illustrationAlt}
          widths={[520, 780, 1100]}
          sizes="(min-width: 1024px) 56vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
</section>


<style>
  /* Il testo resta sopra la parte piena della fascia. */
  .hero-band .wrap { position: relative; z-index: 1; }

  @media (min-width: 1024px) {
    .hero-band :global(.hero-lead),
    .hero-band :global(h1) { max-width: 34rem; }
  }

  /* Stessa ricetta di PageHeader: dissolvenza orizzontale sull'immagine,
     verticale sul contenitore. Due maschere sullo stesso elemento il browser
     le somma invece di intersecarle, e il taglio netto ricompare. */
  .hb-foto {
    margin: 0 auto;
    width: min(100%, 32rem);
    padding: 0 1.25rem 3rem;
  }
  .hb-foto :global(img) { width: 100%; border-radius: var(--radius-lg); }

  @media (min-width: 1024px) {
    .hb-foto {
      position: absolute;
      inset: 0 0 0 auto;
      z-index: 0;
      width: 56%;
      padding: 0;
      pointer-events: none;
      opacity: 0.85;
      /* La maschera sta QUI, sul contenitore, e non sull'immagine.
         Sull'immagine mascherava solo la fotografia: il velo blu sopra
         restava un rettangolo pieno, e il suo bordo sinistro era la riga
         dritta che si vedeva in pagina. Sul contenitore, foto e velo si
         dissolvono insieme. */
      -webkit-mask-image: radial-gradient(155% 195% at 100% 50%, #000 0%, #000 20%, rgb(0 0 0 / 0.3) 58%, transparent 100%);
      mask-image: radial-gradient(155% 195% at 100% 50%, #000 0%, #000 20%, rgb(0 0 0 / 0.3) 58%, transparent 100%);
    }

    /* Il velo che tinge la fotografia del blu della fascia.
       Prima avevo provato `mix-blend-mode: luminosity`: sulla carta è la
       soluzione elegante, in pagina faceva sparire l'immagine — la fusione
       non regge bene insieme alla maschera. Un velo vero, sopra la foto e
       dentro la stessa maschera, fa lo stesso lavoro e si comporta sempre
       allo stesso modo.

       Con la foto desaturata sotto, il risultato è un'immagine monocroma nel
       blu del marchio: non è più una fotografia appoggiata sopra la fascia,
       è la fascia che prende rilievo. */
    .hb-foto::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--gradient-brand);
      opacity: 0.38;
      pointer-events: none;
    }
    .hb-foto :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center right;
      border-radius: 0;
      filter: grayscale(1) contrast(1.3) brightness(0.82);
    }
  }
  /* Il fondo blu, i token bianchi, i cerchi e le briciole di pane stanno in
     `.band-brand` (global.css), condivisa con la testata delle pagine di
     progetto. Qui restano solo le parti proprie di questo componente. */

  .hero-lead {
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.125rem);
    line-height: 1.65;
    color: rgb(255 255 255 / 0.82);
  }

  .hero-btn-ghost {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    border-color: rgb(255 255 255 / 0.28);
  }
  @media (hover: hover) {
    .hero-btn-ghost:hover {
      background: rgb(255 255 255 / 0.2);
      border-color: rgb(255 255 255 / 0.45);
      transform: translateY(-1px);
    }
  }
</style>

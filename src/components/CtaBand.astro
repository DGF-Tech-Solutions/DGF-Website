---
import Icon from "@/components/Icon.astro";
import BandPhoto from "@/components/BandPhoto.astro";
import AiCredit from "@/components/AiCredit.astro";
import foto from "@/assets/foto/parliamone.webp";

/*
 * Fascia di chiusura blu, ricalcata su quella in fondo alle pagine di Nexia:
 * badge in pillola, titolo bianco, occhiello, due bottoni e una riga di
 * rassicurazioni con le spunte.
 *
 * La fotografia è un taglio, non un riquadro: se ne occupa BandPhoto, la
 * stessa componente delle due testate. Il testo, che passa da centrato ad
 * allineato a sinistra, resta sempre sopra la parte piena.
 *
 * Sotto i 1024 px la foto sparisce e il testo torna centrato: su una colonna
 * stretta non c'è spazio per due cose affiancate.
 *
 * Va in fondo a ogni pagina di CONTENUTO: è l'unico punto in cui il sito
 * chiede qualcosa, e ripeterlo sempre nello stesso posto è ciò che lo rende
 * efficace. Le tre eccezioni sono volute e vanno lasciate tali:
 *
 *   /contatti          — la richiesta è già il modulo che sta in pagina;
 *   /contatti/inviato  — la richiesta è appena stata accolta;
 *   /404               — chi ci finisce cerca una pagina, non un preventivo.
 *
 * Prima qui c'era scritto "OGNI pagina secondaria", e il codice diceva altro
 * da sempre. Fra una regola assoluta smentita dai fatti e una regola con tre
 * eccezioni dichiarate, la seconda è quella vera.
 *
 * Il titolo non si anima in opacità (regola LCP), anche se qui è quasi sempre
 * sotto la piega: la regola vale per tutto il sito, senza eccezioni da
 * ricordare a memoria.
 */
interface Props {
  /** Testo del badge in cima. */
  badge?: string;
  /** Ammette HTML per lo <span class="t-dim"> nella seconda metà. */
  title?: string;
  lead?: string;
  /** Rassicurazioni con la spunta. */
  facts?: string[];
}

const {
  badge = "Parliamone",
  title = 'Hai un progetto, <span class="t-dim">o solo un dubbio?</span>',
  lead = "Scrivici cosa ti serve. Se possiamo aiutarti te lo diciamo, e se non possiamo ti indirizziamo altrove, senza farti perdere tempo.",
  facts = [
    "Preventivo scritto prima",
    "Il codice resta tuo",
    "Risposta in 1 giorno lavorativo",
    "Nessun vincolo",
  ],
} = Astro.props;
---

<section class="cta-band">
  {/* Fuori dal `wrap`: deve arrivare al bordo della finestra, non fermarsi
      alla colonna di testo. */}
  <BandPhoto src={foto} mobile="hidden" />

  <div class="wrap relative z-10">
    <div class="cta-testo py-16 sm:py-20">
      <span class="badge-brand cta-badge">{badge}</span>

      <h2 class="t-h2 mt-6" set:html={title} />

      <p class="cta-lead mt-5">{lead}</p>

      <div class="cta-azioni mt-9 flex flex-wrap gap-3">
        <a href="/contatti" class="btn btn-on-dark btn-lg">
          Parliamo del tuo progetto
          <Icon name="arrow-right" size={17} />
        </a>
        <a href="/servizi" class="btn btn-ghost btn-lg">Guarda i servizi</a>
      </div>

      <ul class="cta-fatti mt-8 flex flex-wrap gap-x-6 gap-y-2">
        {
          facts.map((f) => (
            <li class="cta-fact">
              <Icon name="check" size={15} />
              {f}
            </li>
          ))
        }
      </ul>

      {/* La componente, non una copia: la dichiarazione dell'art. 50 è una
          stringa di conformità e non deve esistere in due posti. */}
      <AiCredit label="Fotografia generata con IA" class="mt-8" />
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Lo stesso blu della testata delle pagine di progetto, preso dal token
       condiviso: qui c'era una sfumatura diversa — più piatta e più scura,
       inclinata a 145° invece che a 160° — e nella stessa pagina i due blu
       non combaciavano. */
    background: var(--gradient-brand);

    /* Come su HeroBand: si ridefiniscono i token invece di applicare
       `text-white` sui singoli elementi. Le classi tipografiche del sito
       stanno fuori da @layer e batterebbero le utility di Tailwind. */
    --color-ink: #ffffff;
    --color-ink-2: rgb(255 255 255 / 0.82);
    /* 0.8 e non 0.7, come `.band-brand` in global.css: è lo STESSO gradiente,
       e lì la misura dice che a 0,7 il testo minuto sta a 3,9:1 contro i 4,5
       richiesti. La correzione era stata applicata solo a una delle due
       fasce. Oggi qui dentro nessun elemento legge `--color-ink-3`, quindi
       non fallisce niente: sarebbe fallito al primo `.t-small` messo qui. */
    --color-ink-3: rgb(255 255 255 / 0.8);
    --color-line: rgb(255 255 255 / 0.18);
    /* Le stesse superfici di `.band-brand` (global.css), che è lo stesso
       gradiente: senza, `.btn-ghost` qui dentro sarebbe bianco su bianco. È
       per questo che esisteva un `.cta-btn-ghost` scritto a mano. */
    --color-paper: rgb(255 255 255 / 0.10);
    --color-paper-2: rgb(255 255 255 / 0.06);
    --color-soft: rgb(255 255 255 / 0.16);
    --color-soft-2: rgb(255 255 255 / 0.22);
    color: var(--color-ink-2);
  }

  /*
   * LA DISCESA NEL FOOTER.
   *
   * Il gradiente del marchio scende verso il ciano, quindi il fondo di questa
   * fascia è il suo punto più CHIARO — e subito sotto attacca il footer, che
   * è navy quasi nero. Ne veniva il salto più brusco della pagina, per giunta
   * fra due blu di famiglie diverse: sembrava un quarto colore che partiva di
   * colpo. Con questo velo il blu del marchio atterra sul navy del footer, e
   * il footer diventa la continuazione della fascia invece che un blocco
   * appiccicato sotto.
   *
   * Sta in un `::after` e non nel `background` perché deve passare SOPRA la
   * fotografia (che è un elemento figlio, a z-index 0) e sotto al testo (che
   * sta a 10): messo nel fondo, la metà destra della fascia sarebbe rimasta
   * chiara e il salto sarebbe sopravvissuto proprio dove si vede di più.
   */
  .cta-band::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 45%,
      var(--color-navy-deep) 100%
    );
  }

  /* Alone appena accennato dietro il titolo. */
  .cta-band::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: -30%;
    left: 50%;
    width: 42rem;
    height: 42rem;
    max-width: 120vw;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(255 255 255 / 0.07) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  /* La superficie (pillola, bianco traslucido, anello interno, testo pieno)
     arriva da `.badge-brand` in global.css. Qui resta solo ciò che è di
     questa fascia: un filo di respiro in più e una spaziatura più larga. */
  .cta-badge {
    padding: 0.375rem 0.9375rem;
    letter-spacing: 0.16em;
  }

  /*
   * Il titolo su questa fascia.
   *
   * `.t-dim` nasce per il fondo chiaro ed è grigio ardesia: qui sopra usciva
   * spento, più scuro del blu invece che più chiaro, e la seconda metà della
   * frase sembrava disattivata. Le altre fasce scure del sito lo correggono
   * (`.on-dark`, `.band-brand`); questa no, e nessuno se n'era accorto.
   *
   * La correzione usa il ciano del progetto, lo stesso accento già impiegato
   * qui sotto nelle spunte e nelle frecce dei collegamenti su fondo scuro:
   * così la frase resta a due voci senza spegnersi.
   */
  @media (min-width: 1024px) {
    /* La foto sta sotto al testo: `z-index` 0 dentro BandPhoto contro l'1 del
       `wrap`. Il testo lascia libera la metà destra e si allinea a sinistra —
       centrato finirebbe sopra la fotografia. */
    .cta-testo { max-width: 34rem; text-align: left; }
  }

  /* Sotto i 1024 px la fascia resta quella di prima, centrata. */
  @media (max-width: 1023.98px) {
    .cta-testo { max-width: 48rem; margin-inline: auto; text-align: center; }
    .cta-azioni, .cta-fatti { justify-content: center; }
  }

  /* `.cta-credito` stava qui: una copia in prosa e in stile di AiCredit, per
     la stessa dichiarazione dell'art. 50. Adesso la fascia usa la componente,
     e il colore glielo dà `--color-ink-3` rimappato qui sopra — che è tarato
     con la misura in mano (a bianco/0,45 stava a 2,39:1, contro i 4,5 che
     servono a 11px). */

  /* La regola per `.t-dim` sul gradiente sta in global.css, condivisa con la
     fascia di Nexia: qui era scritta identica, spiegazione compresa. */

  .cta-band :global(h2) { color: #fff; }

  /* Dal token, come il sommario di HeroBand: erano 0,80 qui e 0,82 là, per
     lo stesso ruolo sullo stesso gradiente. */
  .cta-lead {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.0625rem);
    line-height: 1.7;
    color: var(--color-ink-2);
  }

  /* `.cta-btn-ghost` stava qui: quattro dichiarazioni per riottenere quello
     che `.btn-ghost` fa da solo, ora che questa fascia rimappa anche i token
     di superficie. Copia identica ne esisteva una in HeroBand. */

  .cta-fact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    /* 0.78 di bianco su questo fondo dà oltre 7:1: sopra soglia anche a 13px. */
    color: rgb(255 255 255 / 0.78);
  }
  .cta-fact :global(svg) { color: var(--color-cyan); flex-shrink: 0; }

</style>

---
import Icon from "@/components/Icon.astro";

/*
 * Fascia di chiusura blu, ricalcata su quella in fondo alle pagine di Nexia:
 * badge in pillola, titolo bianco centrato, occhiello, due bottoni e una riga
 * di rassicurazioni con le spunte.
 *
 * Senza immagine, di proposito: questa fascia si ripete in fondo a ogni
 * pagina, e una fotografia decorativa da 180 px qui vorrebbe accanto la
 * dichiarazione di origine artificiale su tutte le pagine del sito. Molto
 * ingombro per una decorazione. La fascia regge da sola, con il testo.
 *
 * Va in fondo a OGNI pagina secondaria: è l'unico punto in cui il sito chiede
 * qualcosa, e ripeterlo sempre nello stesso posto è ciò che lo rende efficace.
 *
 * Il titolo non si anima in opacità (regola LCP), anche se qui è quasi sempre
 * sotto la piega: la regola vale per tutto il sito, senza eccezioni da
 * ricordare a memoria.
 */
interface Props {
  /** Testo del badge in cima. */
  badge?: string;
  /** Ammette HTML per lo <span class="t-dim"> nella seconda metà. */
  title?: string;
  lead?: string;
  /** Rassicurazioni con la spunta. */
  facts?: string[];
}

const {
  badge = "Parliamone",
  title = 'Hai un progetto, <span class="t-dim">o solo un dubbio?</span>',
  lead = "Scrivici cosa ti serve. Se possiamo aiutarti te lo diciamo, e se non possiamo ti indirizziamo altrove, senza farti perdere tempo.",
  facts = [
    "Preventivo scritto prima",
    "Il codice resta tuo",
    "Risposta in 1 giorno lavorativo",
    "Nessun vincolo",
  ],
} = Astro.props;
---

<section class="cta-band">
  <div class="wrap relative z-10">
    <div class="mx-auto max-w-3xl py-16 text-center sm:py-20">
      <span class="cta-badge">{badge}</span>

      <h2 class="t-h2 mt-6" set:html={title} />

      <p class="cta-lead mx-auto mt-5 max-w-2xl">{lead}</p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/contatti" class="btn btn-on-dark btn-lg">
          Parliamo del tuo progetto
          <Icon name="arrow-right" size={17} />
        </a>
        <a href="/servizi" class="btn cta-btn-ghost btn-lg">Guarda i servizi</a>
      </div>

      <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2">
        {
          facts.map((f) => (
            <li class="cta-fact">
              <Icon name="check" size={15} />
              {f}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(
      145deg,
      var(--color-navy) 0%,
      color-mix(in oklab, var(--color-navy) 82%, var(--color-blue)) 100%
    );

    /* Come su HeroBand: si ridefiniscono i token invece di applicare
       `text-white` sui singoli elementi. Le classi tipografiche del sito
       stanno fuori da @layer e batterebbero le utility di Tailwind. */
    --color-ink: #ffffff;
    --color-ink-2: rgb(255 255 255 / 0.82);
    --color-ink-3: rgb(255 255 255 / 0.7);
    color: var(--color-ink-2);
  }

  /* Alone appena accennato dietro il titolo. */
  .cta-band::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: -30%;
    left: 50%;
    width: 42rem;
    height: 42rem;
    max-width: 120vw;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(255 255 255 / 0.07) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.9375rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.14);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .cta-lead {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.0625rem);
    line-height: 1.7;
    color: rgb(255 255 255 / 0.8);
  }

  .cta-btn-ghost {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    border-color: rgb(255 255 255 / 0.3);
  }
  @media (hover: hover) {
    .cta-btn-ghost:hover {
      background: rgb(255 255 255 / 0.2);
      border-color: rgb(255 255 255 / 0.5);
      transform: translateY(-1px);
    }
  }

  .cta-fact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    /* 0.78 di bianco su questo fondo dà oltre 7:1: sopra soglia anche a 13px. */
    color: rgb(255 255 255 / 0.78);
  }
  .cta-fact :global(svg) { color: var(--color-cyan); flex-shrink: 0; }

</style>

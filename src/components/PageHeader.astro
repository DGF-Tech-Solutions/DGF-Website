---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

/*
 * Testata delle pagine interne, sul modello degli hero interni di Nexia:
 * testo a sinistra, illustrazione a destra, alone azzurro dietro.
 * La ripetizione della struttura è una virtù — chi naviga impara dove
 * guardare.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
  /** Illustrazione a destra. Se manca, il testo occupa tutta la larghezza. */
  illustration?: ImageMetadata;
  illustrationAlt?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  lead,
  crumbs,
  illustration,
  illustrationAlt = "",
  class: className = "",
} = Astro.props;
---

<section class:list={["glow-bg overflow-hidden border-b border-[var(--color-line)]", className]}>
  <div class="wrap pt-6 pb-12 sm:pt-8 sm:pb-16">
    <Breadcrumbs items={crumbs} class="mb-8" />

    <div
      class:list={[
        "grid items-center gap-10",
        illustration && "lg:grid-cols-[1.1fr_0.9fr] lg:gap-12",
      ]}
    >
      <div>
        {eyebrow && <span class="t-eyebrow">{eyebrow}</span>}
        <h1 class:list={["t-h1 anim-rise", eyebrow && "mt-3"]} set:html={title} />
        {lead && <p class="t-lead mt-5 max-w-2xl anim-fade-rise delay-2">{lead}</p>}
        <slot />
      </div>

      {
        illustration && (
          /* Le scene sono orizzontali (1152×896): vogliono più larghezza
             degli omini verticali, altrimenti restano minuscole. */
          <div class="anim-fade delay-2 parallax-slow mx-auto w-full max-w-[22rem] lg:max-w-[30rem]">
            <Image
              src={illustration}
              alt={illustrationAlt}
              widths={[360, 520, 720]}
              sizes="(min-width: 1024px) 480px, 340px"
              loading="eager"
              class="w-full"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

---
import type { ImageMetadata } from "astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AiCredit from "@/components/AiCredit.astro";
import BandPhoto from "@/components/BandPhoto.astro";

/*
 * Testata delle pagine interne.
 *
 * La fotografia è un taglio, non un riquadro: se ne occupa BandPhoto, che fa
 * lo stesso lavoro qui, su HeroBand e sulla fascia di chiusura. Il perché
 * della dissolvenza sta scritto lì.
 *
 * Prima era un'immagine dentro una colonna della griglia: funzionava con i
 * disegni piatti su fondo bianco, che si fondevano con la carta da soli. Una
 * fotografia in quella stessa posizione resta un rettangolo appoggiato sopra
 * la pagina, e si vede.
 */
interface Props {
  eyebrow?: string;
  title: string;
  /**
   * Scala del titolo.
   *   "hero" — quella di sistema (fino a 56px), giusta per i titoli brevi
   *            delle pagine ("Chi siamo", "Servizi");
   *   "long" — più contenuta, per i titoli che sono frasi intere. A 56px,
   *            nella colonna stretta che lascia libera la fotografia, un
   *            titolo di articolo va su quattro righe e riempie da solo il
   *            primo schermo. È la stessa scala della pagina di progetto,
   *            adottata lì per la stessa ragione.
   */
  titleScale?: "hero" | "long";
  lead?: string;
  crumbs: { label: string; href?: string }[];
  /** Illustrazione a destra. Se manca, il testo occupa tutta la larghezza. */
  illustration?: ImageMetadata;
  illustrationAlt?: string;
  /**
   * Da attivare quando l'immagine è una fotografia generata con IA: stampa
   * sotto la dichiarazione richiesta dall'art. 50 dell'AI Act. Vedi
   * AiCredit.astro per il perché della forma.
   */
  illustrationAi?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  titleScale = "hero",
  lead,
  crumbs,
  illustration,
  illustrationAlt = "",
  illustrationAi = false,
  class: className = "",
} = Astro.props;
---

{/* Niente `overflow-hidden` nella lista: `.band-brand` lo imposta già. Era
    l'unico dei tre punti che usano questa fascia a ripeterlo. */}
<section class:list={["band-brand under-nav", className]}>
  <div class="wrap pt-6 pb-12 sm:pt-8 sm:pb-16">
    <Breadcrumbs items={crumbs} class="mb-8" />

    <div class:list={["ph-testo", illustration && "ph-testo-con-foto"]}>
      {eyebrow && <span class="t-eyebrow">{eyebrow}</span>}
      <h1
        class:list={[
          "t-h1 anim-rise",
          eyebrow && "mt-3",
          titleScale === "long" && "ph-titolo-lungo",
        ]}
        set:html={title}
      />
      {lead && <p class="t-lead mt-5 anim-fade-rise delay-2">{lead}</p>}
      <slot />
      {illustrationAi && <AiCredit />}
    </div>
  </div>

  {/* Dopo il `wrap` di proposito: su schermo stretto la fotografia esce dal
      posizionamento assoluto e torna nel flusso, quindi deve stare sotto al
      testo e non sopra. */}
  {
    illustration && (
      <BandPhoto
        src={illustration}
        alt={illustrationAlt}
        eager
        class="anim-fade delay-2"
      />
    )
  }
</section>

<style>
  /* Il testo sta sopra la parte piena e lascia libera la metà destra:
     centrato o a tutta larghezza finirebbe sopra la fotografia. */
  .ph-testo { position: relative; z-index: 1; }
  .ph-testo :global(.t-lead) { max-width: 42rem; }

  /* Titolo che è una frase intera. Stessa scala del titolo di progetto: due
     righe invece di quattro, e sotto ci restano il sommario e i metadati. */
  .ph-titolo-lungo {
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.5rem);
    line-height: 1.14;
    letter-spacing: -0.028em;
  }

  @media (min-width: 1024px) {
    .ph-testo-con-foto { max-width: 36rem; }
    .ph-testo-con-foto :global(.t-lead) { max-width: 34rem; }
  }
</style>

---
/*
 * I servizi, a schede, con l'illustrazione che si ridisegna a ogni cambio.
 *
 * ─────────────────────────────────────────────────────────────────────────
 * SENZA JAVASCRIPT, E SENZA TRUCCHI SCOMODI
 *
 * Le schede sono un gruppo di `radio` nascosti alla vista ma non alla
 * tastiera, più le `label` che li accendono. Da qui arrivano gratis tre cose
 * che di solito costano codice: lo stato attivo, la navigazione con le frecce
 * (è il comportamento nativo di un gruppo di radio, lo stesso che le linee
 * guida ARIA chiedono per le schede) e il fatto che senza JS funzioni uguale.
 *
 * L'animazione riparte da sola a ogni cambio perché il pannello spento è
 * `display: none`: quando rientra nel documento, le sue animazioni CSS
 * ripartono dall'inizio. Nessun timer, nessun osservatore, nessun evento.
 *
 * ─────────────────────────────────────────────────────────────────────────
 * COME SI CAMBIA
 *
 * Testi, elenchi e tecnologie vengono da `src/data/services.ts`: si modifica
 * lì e cambiano insieme scheda e pagina del servizio, che restano allineate.
 * Il disegno di ogni servizio è un file suo in `src/components/servizi/`:
 * dentro c'è solo markup SVG, dove ogni pezzo porta un `data-p` con il suo
 * posto nella sequenza. Il ritardo e il tipo di animazione li mette il foglio
 * di stile qui sotto — quindi per aggiungere un elemento basta disegnarlo e
 * dargli un numero.
 */

import { SERVICES } from "@/data/services";
import Icon, { type IconName } from "@/components/Icon.astro";
import VizSito from "@/components/servizi/VizSito.astro";
import VizEcommerce from "@/components/servizi/VizEcommerce.astro";
import VizApp from "@/components/servizi/VizApp.astro";
import VizSoftware from "@/components/servizi/VizSoftware.astro";
import VizAi from "@/components/servizi/VizAi.astro";

/** Un disegno per servizio, nello stesso ordine di SERVICES. */
const DISEGNI = [VizSito, VizEcommerce, VizApp, VizSoftware, VizAi];
const ICONE: IconName[] = ["globe", "bag", "phone", "dashboard", "sparkles"];
---

<div class="schede">
  {/*
    I radio vengono prima di tutto il resto perché le regole che accendono
    scheda e pannello usano il combinatore "fratello successivo" (`~`).
  */}
  {
    SERVICES.map((s, i) => (
      <input
        class="schede-radio"
        type="radio"
        name="servizio"
        id={`sv-${s.slug}`}
        checked={i === 0}
      />
    ))
  }

  <div class="schede-barra">
    {
      SERVICES.map((s, i) => (
        <label class="schede-tab" for={`sv-${s.slug}`}>
          <Icon name={ICONE[i]} size={15} />
          <span>{s.title}</span>
        </label>
      ))
    }
  </div>

  <div class="schede-corpo">
    {
      SERVICES.map((s, i) => {
        const Disegno = DISEGNI[i];
        return (
          <section class="pannello">
            <div class="viz">
              <Disegno />
            </div>

            <div class="pannello-testo">
              <span class="pannello-indice tabular">{s.index}</span>
              <h3 class="pannello-titolo">{s.title}</h3>
              <p class="pannello-riga">{s.headline}</p>
              <p class="pannello-intro">{s.summary}</p>

              <ul class="pannello-elenco">
                {s.includes.slice(0, 4).map((x) => (
                  <li>{x.title}</li>
                ))}
              </ul>

              <p class="pannello-stack">
                {s.stack.slice(0, 4).map((t) => (
                  <span class="stack-voce">{t}</span>
                ))}
              </p>

              <a href={`/servizi/${s.slug}`} class="link-arrow pannello-vai">
                Vedi il servizio
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<style>
  /* ══════════════════════════════════════════════════════════════════════
     LA BARRA DELLE SCHEDE
     ══════════════════════════════════════════════════════════════════════ */

  .schede {
    margin-top: 2.5rem;
  }

  /* Nascosti alla vista ma non alla tastiera: niente `display:none`, che li
     toglierebbe dal giro del Tab e ucciderebbe le frecce. */
  .schede-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .schede-barra {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--color-line);
  }

  .schede-barra::-webkit-scrollbar {
    display: none;
  }

  .schede-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.75rem 0.9rem 0.9rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-3);
    cursor: pointer;
    white-space: nowrap;
    transition:
      color var(--dur) var(--ease-out-quart),
      border-color var(--dur) var(--ease-out-quart);
  }

  .schede-tab :global(svg) {
    opacity: 0.55;
    transition: opacity var(--dur) var(--ease-out-quart);
  }

  @media (hover: hover) {
    .schede-tab:hover {
      color: var(--color-ink);
    }
    .schede-tab:hover :global(svg) {
      opacity: 0.9;
    }
  }

  /* ── Stato attivo ─────────────────────────────────────────────────────
   * Cinque coppie di regole scritte una volta con `nth-of-type`: il radio in
   * posizione N accende la label in posizione N e il pannello in posizione N.
   * Se un domani i servizi diventano sei, basta aggiungere una coppia. */
  .schede-radio:nth-of-type(1):checked ~ .schede-barra .schede-tab:nth-of-type(1),
  .schede-radio:nth-of-type(2):checked ~ .schede-barra .schede-tab:nth-of-type(2),
  .schede-radio:nth-of-type(3):checked ~ .schede-barra .schede-tab:nth-of-type(3),
  .schede-radio:nth-of-type(4):checked ~ .schede-barra .schede-tab:nth-of-type(4),
  .schede-radio:nth-of-type(5):checked ~ .schede-barra .schede-tab:nth-of-type(5) {
    color: var(--color-navy);
    border-bottom-color: var(--color-navy);
  }

  .schede-radio:nth-of-type(1):checked ~ .schede-barra .schede-tab:nth-of-type(1) :global(svg),
  .schede-radio:nth-of-type(2):checked ~ .schede-barra .schede-tab:nth-of-type(2) :global(svg),
  .schede-radio:nth-of-type(3):checked ~ .schede-barra .schede-tab:nth-of-type(3) :global(svg),
  .schede-radio:nth-of-type(4):checked ~ .schede-barra .schede-tab:nth-of-type(4) :global(svg),
  .schede-radio:nth-of-type(5):checked ~ .schede-barra .schede-tab:nth-of-type(5) :global(svg) {
    opacity: 1;
  }

  .schede-radio:nth-of-type(1):focus-visible ~ .schede-barra .schede-tab:nth-of-type(1),
  .schede-radio:nth-of-type(2):focus-visible ~ .schede-barra .schede-tab:nth-of-type(2),
  .schede-radio:nth-of-type(3):focus-visible ~ .schede-barra .schede-tab:nth-of-type(3),
  .schede-radio:nth-of-type(4):focus-visible ~ .schede-barra .schede-tab:nth-of-type(4),
  .schede-radio:nth-of-type(5):focus-visible ~ .schede-barra .schede-tab:nth-of-type(5) {
    outline: 2px solid var(--color-blue);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  /* ══════════════════════════════════════════════════════════════════════
     IL PANNELLO
     ══════════════════════════════════════════════════════════════════════ */

  .pannello {
    display: none;
  }

  .schede-radio:nth-of-type(1):checked ~ .schede-corpo .pannello:nth-of-type(1),
  .schede-radio:nth-of-type(2):checked ~ .schede-corpo .pannello:nth-of-type(2),
  .schede-radio:nth-of-type(3):checked ~ .schede-corpo .pannello:nth-of-type(3),
  .schede-radio:nth-of-type(4):checked ~ .schede-corpo .pannello:nth-of-type(4),
  .schede-radio:nth-of-type(5):checked ~ .schede-corpo .pannello:nth-of-type(5) {
    display: grid;
  }

  .pannello {
    gap: 2rem;
    align-items: center;
    padding-top: 2.5rem;
  }

  @media (min-width: 900px) {
    .pannello {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
      padding-top: 3rem;
    }
  }

  /* Il testo entra con un filo di ritardo sul disegno: prima si guarda la
     figura, poi si legge. */
  .pannello-testo > * {
    animation: sc-testo 0.55s var(--ease-out-quart) both;
  }

  .pannello-indice {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-3);
    animation-delay: 0.05s;
  }

  .pannello-titolo {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-ink);
    animation-delay: 0.1s;
  }

  .pannello-riga {
    margin-top: 0.5rem;
    font-size: 1rem;
    font-style: italic;
    color: var(--color-blue);
    animation-delay: 0.16s;
  }

  .pannello-intro {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-3);
    animation-delay: 0.22s;
  }

  /* L'elenco: un filetto al posto del pallino, come nelle didascalie tecniche
     del resto del sito. */
  .pannello-elenco {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
    animation-delay: 0.28s;
  }

  .pannello-elenco li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .pannello-elenco li::before {
    content: "";
    height: 1px;
    background: var(--color-cyan);
  }

  .pannello-stack {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    animation-delay: 0.34s;
  }

  /* Le tecnologie: monospazio e bordo capello, come i dati tecnici del resto
     del sito. Erano definite nella griglia che questa sezione ha sostituito. */
  .stack-voce {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
  }

  .pannello-vai {
    margin-top: 1.75rem;
    animation-delay: 0.4s;
  }

  @keyframes sc-testo {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════
     LA CORNICE DEL DISEGNO
     ══════════════════════════════════════════════════════════════════════ */

  .viz {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-soft) 45%, var(--color-paper)),
        var(--color-paper)
      );
    overflow: hidden;
  }

  /* La quadrettatura tecnica sotto al disegno: si vede appena, ma è ciò che
     fa leggere la figura come un progetto invece che come un'illustrazione. */
  .viz::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--color-cyan) 12%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-cyan) 12%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(closest-side ellipse at 50% 50%, #000 30%, transparent 92%);
  }

  .viz-svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  /* ══════════════════════════════════════════════════════════════════════
     LA REGIA DELLE ANIMAZIONI
     ═══════════════════════════════════════════════════════════════════════

     Tutto quello che sta dentro ai disegni è marcato con `data-p` (il posto
     nella sequenza) e, se serve, con un secondo attributo che dice COME
     entrare. I disegni non contengono una riga di CSS: così aggiungerne uno
     nuovo è solo disegnare, e le cinque animazioni restano coerenti fra loro.

     `:global()` perché Astro non applica il proprio attributo di scope agli
     elementi SVG: la parte a sinistra (`.viz`) resta scopata, quindi le regole
     non escono da qui. */

  .viz :global([data-p]) {
    --ritardo: 0s;
    opacity: 0;
    animation: viz-entra 0.5s var(--ease-out-quart) var(--ritardo) both;
  }

  .viz :global([data-p="1"]) { --ritardo: 0.02s; }
  .viz :global([data-p="2"]) { --ritardo: 0.11s; }
  .viz :global([data-p="3"]) { --ritardo: 0.2s; }
  .viz :global([data-p="4"]) { --ritardo: 0.29s; }
  .viz :global([data-p="5"]) { --ritardo: 0.38s; }
  .viz :global([data-p="6"]) { --ritardo: 0.47s; }
  .viz :global([data-p="7"]) { --ritardo: 0.56s; }
  .viz :global([data-p="8"]) { --ritardo: 0.65s; }
  .viz :global([data-p="9"]) { --ritardo: 0.74s; }
  .viz :global([data-p="10"]) { --ritardo: 0.83s; }
  .viz :global([data-p="11"]) { --ritardo: 0.92s; }
  .viz :global([data-p="12"]) { --ritardo: 1.01s; }
  .viz :global([data-p="13"]) { --ritardo: 1.1s; }

  @keyframes viz-entra {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Le linee si disegnano invece di comparire: `pathLength="1"` normalizza la
     lunghezza del tracciato, così un solo valore di tratteggio vale per tutti
     i percorsi, corti o lunghi che siano. */
  .viz :global([data-traccia]) {
    stroke-dasharray: 1;
    animation: viz-traccia 0.8s var(--ease-out-quart) var(--ritardo) both;
  }

  @keyframes viz-traccia {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  /* Le colonne del grafico crescono da terra. `transform-box: fill-box` fa sì
     che l'origine sia il riquadro dell'elemento e non l'angolo dell'SVG. */
  .viz :global([data-cresce]) {
    transform-box: fill-box;
    transform-origin: bottom center;
    animation: viz-cresce 0.6s var(--ease-out-quart) var(--ritardo) both;
  }

  @keyframes viz-cresce {
    from {
      opacity: 0;
      transform: scaleY(0.05);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .viz :global([data-cresce-x]) {
    transform-box: fill-box;
    transform-origin: left center;
    animation: viz-cresce-x 1.5s var(--ease-out-quart) var(--ritardo) both;
  }

  @keyframes viz-cresce-x {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
    15% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .viz :global([data-scende]) {
    animation: viz-scende 0.65s var(--ease-out-quart) var(--ritardo) both;
  }

  @keyframes viz-scende {
    from {
      opacity: 0;
      transform: translateY(-26px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Il cursore che lampeggia: l'unica cosa che continua a muoversi. */
  .viz :global([data-lampeggia]) {
    animation:
      viz-entra 0.3s var(--ease-out-quart) var(--ritardo) both,
      viz-lampeggia 1.1s steps(1) 0.9s infinite;
  }

  @keyframes viz-lampeggia {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  /* Il contatore del carrello: tre cifre sovrapposte, ognuna accesa nella sua
     finestra di tempo. Un contatore che sale senza contare niente. */
  .viz :global(.v-conta-1) { animation: viz-conta-1 2.6s 0.7s both; }
  .viz :global(.v-conta-2) { animation: viz-conta-2 2.6s 0.7s both; }
  .viz :global(.v-conta-3) { animation: viz-conta-3 2.6s 0.7s both; }

  @keyframes viz-conta-1 {
    0%, 6% { opacity: 0; }
    8%, 38% { opacity: 1; }
    40%, 100% { opacity: 0; }
  }
  @keyframes viz-conta-2 {
    0%, 40% { opacity: 0; }
    42%, 70% { opacity: 1; }
    72%, 100% { opacity: 0; }
  }
  @keyframes viz-conta-3 {
    0%, 72% { opacity: 0; }
    74%, 100% { opacity: 1; }
  }

  /* Chi ha chiesto meno movimento vede il disegno già finito. */
  @media (prefers-reduced-motion: reduce) {
    .pannello-testo > *,
    .viz :global([data-p]),
    .viz :global([data-traccia]),
    .viz :global([data-cresce]),
    .viz :global([data-cresce-x]),
    .viz :global([data-scende]),
    .viz :global([data-lampeggia]) {
      animation: none;
      opacity: 1;
      transform: none;
      stroke-dashoffset: 0;
    }
    .viz :global(.v-conta-1),
    .viz :global(.v-conta-2) {
      opacity: 0;
    }
    .viz :global(.v-conta-3) {
      animation: none;
      opacity: 1;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════
     I COLORI DEL DISEGNO
     Una sola tavolozza per tutti e cinque, così sembrano fatti dalla stessa
     mano. Sono classi sugli elementi SVG, quindi anche queste `:global`.
     ══════════════════════════════════════════════════════════════════════ */

  .viz :global(.v-schermo) {
    fill: var(--color-paper);
    stroke: var(--color-line);
  }
  .viz :global(.v-scocca) {
    fill: none;
    stroke: color-mix(in srgb, var(--color-navy) 35%, transparent);
    stroke-width: 1.5;
  }
  .viz :global(.v-base) {
    fill: color-mix(in srgb, var(--color-navy) 8%, transparent);
    stroke: color-mix(in srgb, var(--color-navy) 30%, transparent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .viz :global(.v-tacca) {
    stroke: color-mix(in srgb, var(--color-navy) 30%, transparent);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .viz :global(.v-tacca-pieno) {
    fill: color-mix(in srgb, var(--color-navy) 25%, transparent);
  }
  .viz :global(.v-filo) {
    stroke: var(--color-line);
  }
  .viz :global(.v-pallino) {
    fill: var(--color-soft-2);
  }
  .viz :global(.v-url) {
    fill: var(--color-soft);
  }
  .viz :global(.v-accento) {
    fill: var(--color-cyan);
  }
  .viz :global(.v-titolo) {
    fill: color-mix(in srgb, var(--color-navy) 85%, transparent);
  }
  .viz :global(.v-titolo-mini) {
    fill: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }
  .viz :global(.v-riga) {
    fill: var(--color-soft-2);
  }
  .viz :global(.v-riga-tenue) {
    fill: var(--color-soft);
  }
  .viz :global(.v-bottone) {
    fill: color-mix(in srgb, var(--color-navy) 88%, transparent);
  }
  .viz :global(.v-bottone-pieno) {
    fill: var(--color-navy);
  }
  .viz :global(.v-bottone-testo) {
    fill: #fff;
    font-size: 9px;
    font-weight: 600;
    font-family: var(--font-sans);
  }
  .viz :global(.v-spunta) {
    stroke: #fff;
    stroke-width: 2;
    fill: none;
  }
  .viz :global(.v-scheda) {
    fill: var(--color-paper);
    stroke: var(--color-line);
  }
  .viz :global(.v-scheda-piena) {
    fill: color-mix(in srgb, var(--color-soft) 70%, var(--color-paper));
    stroke: color-mix(in srgb, var(--color-cyan) 25%, transparent);
  }
  .viz :global(.v-superficie) {
    fill: var(--color-soft);
  }
  .viz :global(.v-prezzo) {
    fill: color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  .viz :global(.v-bollo) {
    fill: var(--color-navy);
  }
  .viz :global(.v-bollo-num) {
    fill: #fff;
    font-size: 9px;
    font-weight: 700;
    font-family: var(--font-mono);
  }
  .viz :global(.v-tratto) {
    stroke: var(--color-blue);
    stroke-width: 1.6;
    fill: none;
  }
  .viz :global(.v-pieno) {
    fill: var(--color-blue);
  }
  .viz :global(.v-pieno-chiaro) {
    fill: color-mix(in srgb, var(--color-cyan) 60%, transparent);
  }
  .viz :global(.v-cerchio-pieno) {
    fill: var(--color-soft);
    stroke: var(--color-line);
  }
  .viz :global(.v-cerchio-tenue) {

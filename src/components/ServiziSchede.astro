---
/*
 * I servizi, a schede, con l'illustrazione che si ridisegna a ogni cambio.
 *
 * ─────────────────────────────────────────────────────────────────────────
 * SENZA JAVASCRIPT, E SENZA TRUCCHI SCOMODI
 *
 * Le schede sono un gruppo di `radio` nascosti alla vista ma non alla
 * tastiera, più le `label` che li accendono. Da qui arrivano gratis tre cose
 * che di solito costano codice: lo stato attivo, la navigazione con le frecce
 * (è il comportamento nativo di un gruppo di radio, lo stesso che le linee
 * guida ARIA chiedono per le schede) e il fatto che senza JS funzioni uguale.
 *
 * L'animazione riparte da sola a ogni cambio perché il pannello spento è
 * `display: none`: quando rientra nel documento, le sue animazioni CSS
 * ripartono dall'inizio. Nessun timer, nessun osservatore, nessun evento.
 *
 * ─────────────────────────────────────────────────────────────────────────
 * COME SI CAMBIA
 *
 * Testi, elenchi e tecnologie vengono da `src/data/services.ts`: si modifica
 * lì e cambiano insieme scheda e pagina del servizio, che restano allineate.
 * Il disegno di ogni servizio è un file suo in `src/components/servizi/`:
 * dentro c'è solo markup SVG, dove ogni pezzo porta un `data-p` con il suo
 * posto nella sequenza. Il ritardo e il tipo di animazione li mette il foglio
 * di stile qui sotto — quindi per aggiungere un elemento basta disegnarlo e
 * dargli un numero.
 */

import { SERVICES } from "@/data/services";
import Icon, { type IconName } from "@/components/Icon.astro";
import VizSito from "@/components/servizi/VizSito.astro";
import VizEcommerce from "@/components/servizi/VizEcommerce.astro";
import VizApp from "@/components/servizi/VizApp.astro";
import VizSoftware from "@/components/servizi/VizSoftware.astro";
import VizAi from "@/components/servizi/VizAi.astro";

/** Un disegno per servizio, nello stesso ordine di SERVICES. */
const DISEGNI = [VizSito, VizEcommerce, VizApp, VizSoftware, VizAi];
const ICONE: IconName[] = ["globe", "bag", "phone", "dashboard", "sparkles"];
---

<div class="schede">
  {/*
    I RADIO NON STANNO PIÙ QUI IN CIMA, E IL MOTIVO È UN DIFETTO VERO.

    Stavano prima di tutto il resto perché le regole di stato usavano il
    combinatore "fratello successivo" (`~`), che accende solo ciò che viene
    DOPO. Quel vincolo li teneva a forza in cima alla sezione — cioè lontani
    dal punto che si tocca — e al tocco il browser, dopo aver dato il fuoco al
    radio, lo porta in vista: da quassù significava risalire fino alla barra
    (più i 5.5rem di `scroll-padding-top` di global.css), e il disegno appena
    scelto usciva dallo schermo proprio mentre lo si stava guardando.

    Adesso ogni radio vive dentro la propria linguetta, cioè esattamente dove
    è appena arrivato il dito: non c'è più niente da portare in vista. Ad
    accoppiare radio, disegno e testo è `:has()` sul contenitore, con `data-i`
    (1…5) scritto in chiaro su entrambe le parti.
  */}

  {/*
    ── LA RIGA DEI COMANDI ────────────────────────────────────────────────
    Sopra a tutto, in orizzontale: i cinque servizi a sinistra e la vista a
    destra. In colonna, il menu spingeva il testo del servizio sotto la piega
    e costringeva a scorrere per leggere quello che si era appena scelto.
  */}
  <div class="schede-barra">
    <div class="schede-tabs">
      {
        SERVICES.map((s, i) => (
          <label class="schede-tab">
            {/* Il radio dentro la sua linguetta. Da tocco e da mouse è già in
                vista per costruzione, quindi il "porta in vista" del fuoco non
                ha niente da fare. Da tastiera vale il contrario ed è giusto
                così: le frecce spostano il fuoco sul radio della linguetta
                successiva, e se quella fosse fuori schermo il browser la porta
                in vista — che è esattamente il comportamento che serve.
                Niente `for`: l'etichetta contiene il proprio controllo, quindi
                l'associazione è implicita. L'`id` resta perché è un aggancio
                stabile se un domani servisse collegarci qualcosa. */}
            <input
              class="schede-radio"
              type="radio"
              name="servizio"
              id={`sv-${s.slug}`}
              data-i={i + 1}
              checked={i === 0}
            />
            <Icon name={ICONE[i]} size={15} />
            <span>{s.title}</span>
          </label>
        ))
      }
    </div>

  </div>

  <div class="schede-corpo">
    {/* ── IL PALCO ──────────────────────────────────────────────────────── */}
    <div class="palco">
      {
        SERVICES.map((s, i) => {
          const Disegno = DISEGNI[i];
          return (
            <div class="viz" data-i={i + 1} data-scena={s.slug}>
              <div class="viz-orbita">
                  <div class="viz-strato viz-reticolo" aria-hidden="true" />

                  {/* Il disegno, diviso in livelli sovrapposti che combaciano
                      al pixel: uno per ogni parte, comodo da modificare. */}
                  <div class="viz-strato viz-pila">
                    <Disegno />
                  </div>

                  {/* Note tecniche: squadre agli angoli, quota in basso e
                      cerchio di centratura. Stanno dietro al disegno, non
                      sopra: passate davanti cadevano in mezzo allo schermo e
                      sembravano sporco sulla figura. */}
                  <div class="viz-strato viz-note" aria-hidden="true">
                    <svg viewBox="0 0 400 300" fill="none">
                      <path d="M18 42V18h24M358 18h24v24M382 258v24h-24M42 282H18v-24" class="v-squadra" />
                      <path d="M18 292h364" class="v-quota" />
                      <path d="M18 288v8M382 288v8M200 289v6" class="v-quota" />
                      <circle cx="200" cy="140" r="128" class="v-mirino" />
                      <path d="M200 2v22M60 140H38M362 140h-22" class="v-mirino" />
                    </svg>
                  </div>

                  <div class="viz-strato viz-hud" aria-hidden="true">
                    <span class="viz-gettone viz-gettone-icona">
                      <Icon name={ICONE[i]} size={17} />
                    </span>
                    <span class="viz-gettone viz-gettone-indice">{s.index}</span>
                  </div>
              </div>
            </div>
          );
        })
      }

    </div>

    {/* ── LA COLONNA DI DESTRA ──────────────────────────────────────────── */}
    <div class="lato">
      {
        SERVICES.map((s, i) => (
          <section class="testo" data-i={i + 1}>
            <span class="pannello-indice tabular">{s.index}</span>
            <h3 class="pannello-titolo">{s.title}</h3>
            <p class="pannello-riga">{s.headline}</p>
            <p class="pannello-intro">{s.summary}</p>

            <ul class="pannello-elenco">
              {s.includes.slice(0, 4).map((x) => (
                <li>{x.title}</li>
              ))}
            </ul>

            <p class="pannello-stack">
              {s.stack.slice(0, 4).map((t) => (
                <span class="stack-voce">{t}</span>
              ))}
            </p>

            <a href={`/servizi/${s.slug}`} class="link-arrow pannello-vai">
              Vedi il servizio
              <Icon name="arrow-right" size={16} />
            </a>
          </section>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* ══════════════════════════════════════════════════════════════════════
     IMPIANTO
     ══════════════════════════════════════════════════════════════════════ */

  .schede {
    margin-top: 2.5rem;
  }

  /* Nascosti alla vista ma non alla tastiera: niente `display:none`, che li
     toglierebbe dal giro del Tab e ucciderebbe le frecce.

     `position: absolute` senza `top`/`left` li lascia nella posizione statica,
     che adesso è DENTRO la linguetta: un punto largo un pixel sopra
     l'etichetta che si è appena toccata. È tutto quello che serve perché il
     browser non debba scorrere per portare in vista il campo che riceve il
     fuoco — prima quel punto stava in cima alla sezione, e la pagina risaliva.

     `pointer-events: none` non impedisce di accenderli: il tocco lo prende
     l'etichetta, che attiva il proprio controllo comunque. */
  .schede-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .schede-corpo {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
  }

  /* Il disegno prende la parte larga: è il pezzo che si guarda per primo, e in
     tre dimensioni gli serve spazio per girare. Le due colonne sono allineate
     IN ALTO, non al centro: il testo deve cominciare dove comincia la scena,
     altrimenti chi legge deve scendere a cercarlo. */
  @media (min-width: 900px) {
    .schede-corpo {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
      align-items: start;
      padding-top: 2.5rem;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════
     LA RIGA DEI COMANDI
     ══════════════════════════════════════════════════════════════════════ */

  .schede-barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .schede-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .schede-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-3);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background var(--dur) var(--ease-out-quart),
      border-color var(--dur) var(--ease-out-quart),
      color var(--dur) var(--ease-out-quart);
  }

  .schede-tab :global(svg) {
    opacity: 0.55;
    transition: opacity var(--dur) var(--ease-out-quart);
  }

  @media (hover: hover) {
    .schede-tab:hover {
      background: color-mix(in srgb, var(--color-paper) 60%, transparent);
      color: var(--color-ink);
    }
    .schede-tab:hover :global(svg) { opacity: 0.9; }
  }

  /* ── Stato attivo ─────────────────────────────────────────────────────
   * Una regola sola, valida per tutte e cinque: la linguetta contiene il
   * proprio radio, quindi non c'è più niente da accoppiare per posizione. Le
   * cinque coppie con `nth-of-type` non erano solo prolisse: erano il VINCOLO
   * che obbligava i radio a stare in cima alla sezione, ed è quel vincolo che
   * faceva risalire la pagina a ogni cambio di servizio.
   *
   * Il conto della specificità è la cosa da non sbagliare qui: questa regola
   * vale (0,4,0) — classe, attributo di scope Astro e il `:checked` dentro
   * `:has()`, che porta con sé il peso del proprio argomento — contro (0,3,0)
   * del `:hover` qui sopra. Il pulsante scelto quindi resta navy anche con il
   * mouse sopra, come prima. */
  .schede-tab:has(.schede-radio:checked) {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: #fff;
  }

  .schede-tab:has(.schede-radio:checked) :global(svg) {
    opacity: 1;
  }

  /* Il fuoco si vede sulla LINGUETTA, non sul radio: il radio sta a opacità
     zero e con lui sparirebbe anche il suo anello — chi naviga da tastiera non
     aveva alcun segno di dove si trovasse. Solo `:focus-visible`, così resta
     un fatto della tastiera e non compare a ogni tocco. Colore e spessore sono
     quelli di `:focus-visible` in global.css: l'anello segue il raggio a
     pillola del pulsante da solo. */
  .schede-tab:has(.schede-radio:focus-visible) {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  /* E l'anello del radio va spento, o se ne vedono DUE. `:focus-visible` in
     global.css (riga 222) è globale e senza eccezioni: disegna 2px con 2px di
     stacco attorno a un elemento di un pixel per un pixel. Finché quel pixel
     stava in cima alla sezione non se ne accorgeva nessuno; adesso cade sul
     bordo interno della pillola, sopra l'icona. */
  .schede-radio:focus-visible {
    outline: none;
  }

  @media (hover: hover) {
  }

  /* ══════════════════════════════════════════════════════════════════════
     IL TESTO DEL SERVIZIO
     ══════════════════════════════════════════════════════════════════════ */

  .testo { display: none; }

  /* Radio e testo non sono più fratelli: a tenerli insieme è `:has()` sul
     contenitore. Il numero d'ordine è SCRITTO, in `data-i`, invece di essere
     contato dal browser: un servizio in più domani è una riga qui e un
     `data-i` nel markup, e se i due numeri non combaciano si vede subito —
     mentre un `nth-of-type` fuori conto sbaglia in silenzio. */
  .schede:has(.schede-radio[data-i="1"]:checked) .testo[data-i="1"],
  .schede:has(.schede-radio[data-i="2"]:checked) .testo[data-i="2"],
  .schede:has(.schede-radio[data-i="3"]:checked) .testo[data-i="3"],
  .schede:has(.schede-radio[data-i="4"]:checked) .testo[data-i="4"],
  .schede:has(.schede-radio[data-i="5"]:checked) .testo[data-i="5"] {
    display: block;
  }

  /* Il testo entra con un filo di ritardo sul disegno: prima si guarda la
     figura, poi si legge. */
  .testo > * {
    animation: sc-testo 0.55s var(--ease-out-quart) both;
  }

  .pannello-indice {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-3);
    animation-delay: 0.05s;
  }

  .pannello-titolo {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-ink);
    animation-delay: 0.1s;
  }

  /* Navy e non `--color-blue`: questa riga sta sull'azzurro della fascia, e
     su quel fondo il blu era a 4,56:1 — dentro la soglia per un pelo, ma solo
     finché la fascia restava quasi bianca. Con l'azzurro portato al valore
     che si vede davvero (vedi `--color-band`) il blu scendeva a 4,2; il navy
     sta a 7,5 e regge qualunque ritocco futuro del fondo. */
  .pannello-riga {
    margin-top: 0.5rem;
    font-size: 1rem;
    font-style: italic;
    color: var(--color-navy);
    animation-delay: 0.16s;
  }

  .pannello-intro {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-3);
    animation-delay: 0.22s;
  }

  /* L'elenco: un filetto al posto del pallino, come nelle didascalie tecniche
     del resto del sito. */
  .pannello-elenco {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
    animation-delay: 0.28s;
  }

  .pannello-elenco li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .pannello-elenco li::before {
    content: "";
    height: 1px;
    background: var(--color-cyan);
  }

  .pannello-stack {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    animation-delay: 0.34s;
  }

  /* Le tecnologie: monospazio e bordo capello, come i dati tecnici del resto
     del sito. Erano definite nella griglia che questa sezione ha sostituito. */
  .stack-voce {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
  }

  .pannello-vai {
    margin-top: 1.75rem;
    animation-delay: 0.4s;
  }

  @keyframes sc-testo {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════
     IL PALCO
     ═══════════════════════════════════════════════════════════════════════

     Cinque scene sovrapposte: solo quella scelta è accesa. Le altre sono
     `display: none`, che è anche il motore delle animazioni — un elemento che
     rientra nel documento fa ripartire le proprie animazioni CSS dall'inizio.

     DUE REGOLE PER TUTTO CIÒ CHE SEGUE:

       1. la catena `perspective` → `preserve-3d` non si interrompe mai. Basta
          un anello in mezzo senza `transform-style: preserve-3d` e i piani si
          schiacciano su uno solo: il 3D sparisce senza dare alcun errore.
       2. niente `overflow` diverso da `visible` sugli anelli di quella catena:
          schiaccia esattamente come il punto 1. È il motivo per cui in tre
          dimensioni la cornice sparisce invece di limitarsi ad allargarsi.
     ══════════════════════════════════════════════════════════════════════ */

  /* Altezza bloccata: la scena si centra dentro, in piano come in profondità.
     Prima la sezione cresceva quando si passava alle tre dimensioni — la scena
     si portava dietro la propria spaziatura — e la pagina saltava sotto le
     mani di chi aveva appena premuto il pulsante. */
  /* UN'ALTEZZA SOLA PER LE DUE VISTE.
   *
   * Ne aveva due, una per la vista piana e una più alta per l'esploso: premere
   * «3D» allungava il palco e faceva saltare in giù tutta la pagina, proprio
   * mentre chi guarda aveva gli occhi sul disegno. Adesso lo spazio è
   * riservato una volta e le due viste ci vivono dentro. */
  .palco {
    position: relative;
    display: grid;
    align-content: center;
    /* Contenitore di query: da qui `cqw` vale «per cento della larghezza della
       scena». Serve perché lo stacco fra i pezzi sia una FRAZIONE della scena
       e non una misura fissa — in pixel, restringendo la finestra i pezzi si
       riavvicinavano fino a chiudersi. `inline-size` non ritaglia niente e il
       palco non fa parte della catena prospettica, che comincia su `.viz`. */
    container-type: inline-size;
    min-height: clamp(360px, 40vw, 560px);
  }

  .viz { display: none; }

  .schede:has(.schede-radio[data-i="1"]:checked) .viz[data-i="1"],
  .schede:has(.schede-radio[data-i="2"]:checked) .viz[data-i="2"],
  .schede:has(.schede-radio[data-i="3"]:checked) .viz[data-i="3"],
  .schede:has(.schede-radio[data-i="4"]:checked) .viz[data-i="4"],
  .schede:has(.schede-radio[data-i="5"]:checked) .viz[data-i="5"] {
    display: block;
  }

  /* Rete di sicurezza per i browser senza `:has()` (roba anteriore al 2023).
     Là i selettori qui sopra vengono scartati INTERI, e siccome disegno e
     testo partono da `display: none` la sezione resterebbe vuota: il modo
     peggiore di degradare. Con questo resta acceso il primo servizio — si
     perde il cambio, non il contenuto.

     Va bene che stia QUI e non altrove: più in basso `.viz` viene ripreso per
     bordo, fondo e prospettiva, ma quel blocco non ridichiara `display`,
     quindi non se lo rimangia. */
  @supports not selector(:has(*)) {
    .viz[data-i="1"],
    .testo[data-i="1"] { display: block; }
  }

  .viz {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-soft) 45%, var(--color-paper)),
        var(--color-paper)
      );
    overflow: hidden;

    perspective: 1100px;

    /* ── I NUMERI DELLA SCENA ────────────────────────────────────────────
     * Sono tutti qui, e valgono la vista piana. La modalità a tre dimensioni
     * non riscrive nessuna regola: cambia solo questi numeri, e tutto il
     * resto del foglio li segue. È anche il motivo per cui il passaggio fra
     * le due viste è una transizione e non un salto. */
    
    /* Posizione del puntatore, da -1 a 1, e il punto di luce in percentuale.
       Le scrive lo script in fondo al file; se non parte restano questi
       valori e la scena sta ferma. */
    --mx: 0;
    --my: 0;
    --lx: 50%;
    --ly: 0%;

    /* Quanto ha girato la scena chi la sta trascinando. Restano dove le
       lascia: è la differenza fra guardare e maneggiare. */

    transition:
      border-color 500ms var(--ease-out-quart),
      background 500ms var(--ease-out-quart),
      padding 500ms var(--ease-out-quart);
  }

  /* LA SALITA DELLA PILA, CALCOLATA E NON INDOVINATA.
   *
   * Ogni pezzo sale di `stacco` in profondità; inclinato di `incl`, sullo
   * schermo quella profondità diventa altezza per sin(incl), e la scala la
   * riduce ancora. Il primo pezzo non sale, quindi i salti sono `livelli - 1`:
   *
   *     salita = (livelli - 1) · stacco · sin(incl) · zoom
   *
   * Serve perché la pila cresce TUTTA verso l'alto: senza compensazione usciva
   * dal palco di centinaia di pixel e finiva sopra ai pulsanti dei servizi.
   * Spostandola giù di metà salita, la pila resta centrata nel proprio spazio
   * qualunque siano i numeri della posa — e il giorno che si cambia
   * inclinazione o si aggiunge un pezzo, si aggiusta da sola. */
  .viz {
  }

  /* In piano il disegno non si prende: nessun cursore che lo prometta e
     nessun gesto rubato al browser. */
  .viz { cursor: default; touch-action: auto; }

  
  

  /* Il respiro a riposo, su un anello suo: così non litiga con la rotazione
     del puntatore, che sta sul genitore. Le due trasformazioni si sommano. */
  .viz-orbita {
    position: relative;
    transform-style: preserve-3d;
    animation: viz-fluttua 12s ease-in-out infinite;
  }

  /* Mentre la mano guida, il respiro si ferma: due movimenti insieme sono
     rumore. */
  @media (hover: hover) {
    .viz:hover .viz-orbita { animation-play-state: paused; }
  }

  @keyframes viz-fluttua {
    0%, 100% { transform: translate3d(0, 0, 0) rotateY(-1.2deg) rotateX(0.6deg); }
    50%      { transform: translate3d(0, -7px, 0) rotateY(1.2deg) rotateX(-0.6deg); }
  }

  /* Tutti i piani si sovrappongono; solo la pila sta nel flusso, ed è lei a
     dare l'altezza alla scena. */
  .viz-strato { position: absolute; inset: 0; }

  /* L'ALTEZZA VIENE DALLA PROPORZIONE, NON DAL CONTENUTO.
   *
   * Tutte le tavole hanno viewBox 400x300: la pila e' alta quanto quel
   * rapporto, sempre, e non dipende da quale livello sia visibile.
   *
   * Prima l'altezza la dava il livello 0, l'unico lasciato nel flusso. Poi il
   * livello 0 dell'app e' diventato `solo3d` — visibile solo da smontato — e
   * in vista piana non restava piu' niente in flusso: la pila si chiudeva a
   * zero e il disegno spariva. Non un errore di quel disegno: un modo di
   * misurare che si appoggiava su chi c'era, invece che su quanto e' grande. */
  .viz-pila {
    position: relative;
    aspect-ratio: 400 / 300;
  }

  /* ══════════════════════════════════════════════════════════════════════
     LA PILA DEI PIANI
     ═══════════════════════════════════════════════════════════════════════

     Ogni disegno è diviso in più SVG con lo stesso `viewBox`, sovrapposti:
     combaciano al pixel e si leggono come un disegno solo. La divisione resta
     perché è il modo in cui i cinque disegni sono scritti — un livello per
     ogni parte, comodo da modificare — e perché l'altezza la dichiara il
     contenitore, non i livelli.

     Le classi `.pila-piano` le scrive Piano.astro, quindi servono `:global()`:
     l'attributo di scope di Astro non arriva agli elementi di un componente
     figlio. Il contenimento resta, perché la parte a sinistra (`.viz`) è
     scopata.
     ══════════════════════════════════════════════════════════════════════ */

  .viz :global(.pila-piano) {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  

  

  

  /* Il livello più alto ha il bordo del marchio: è la cosa che conta, e in una
     pila di piani chiari serve un segno che dica quale guardare. */ {
    border-color: color-mix(in srgb, var(--color-cyan) 85%, transparent);
  }

  /* La base è il pavimento: più fredda e più piatta delle lastre che regge, e
     con la quadrettatura addosso. Bianca come le altre sembrava un quarto
     livello per sbaglio invece che il piano su cui poggia tutto. */
  .viz :global(.pila-piano[data-piano="0"])::before {
    background:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-cyan) 14%, transparent) 1px,
        transparent 1px
      ) 0 0 / 26px 26px,
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-cyan) 14%, transparent) 1px,
        transparent 1px
      ) 0 0 / 26px 26px,
      color-mix(in srgb, var(--color-soft) 75%, #fff);
    border-color: color-mix(in srgb, var(--color-navy) 20%, transparent);
  }

  

  /* Il livello di fondo non getta ombra su niente: sotto non c'è nulla. */

  

  

  

  /* Il piano di fondo non ha niente sotto a cui aggrapparsi. */

  /* La quadrettatura tecnica: si vede appena, ma è ciò che fa leggere la
     figura come un progetto invece che come un'illustrazione. Adesso sta 80px
     dietro, quindi alla rotazione scorre sotto al disegno. */
  .viz-reticolo {
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--color-cyan) 12%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-cyan) 12%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(closest-side ellipse at 50% 50%, #000 30%, transparent 92%);
    animation: viz-piano-fondo 0.9s var(--ease-out-quart) both;
  }

  .viz-pila {
    animation: viz-piano-figura 0.75s var(--ease-out-quart) both;
  }

  .viz-note {
    animation: viz-piano-note 0.8s var(--ease-out-quart) 0.2s both;
  }

  .viz-note svg { width: 100%; height: 100%; display: block; }

  .viz-note :global(.v-squadra) {
    stroke: color-mix(in srgb, var(--color-navy) 26%, transparent);
    stroke-width: 1.2;
  }
  .viz-note :global(.v-quota) {
    stroke: color-mix(in srgb, var(--color-navy) 18%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .viz-note :global(.v-mirino) {
    stroke: color-mix(in srgb, var(--color-cyan) 30%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .viz-hud {
    animation: viz-piano-hud 0.85s var(--ease-out-quart) 0.3s both;
  }

  /* ── I piani entrano dalla profondità ─────────────────────────────────
   * Il valore finale di `translateZ` sta nel fotogramma finale e non in una
   * regola a parte: `both` lo tiene, e così ogni piano ha la sua quota
   * scritta in un posto solo. */
  @keyframes viz-piano-fondo {
    from { opacity: 0; transform: translateZ(-300px) scale(1.08); }
    to   { opacity: 1; transform: translateZ(-80px) scale(1.08); }
  }
  /* NIENTE `opacity` IN QUESTI FOTOGRAMMI.
   *
   * È l'errore che teneva piatta la pila: `.viz-pila` è l'anello `preserve-3d`
   * che regge i quattro pezzi, e un'opacità diversa da 1 — anche solo per i
   * 750 ms dell'ingresso — lo raggruppa e butta i figli fuori dallo spazio 3D
   * comune. Risultato: i pezzi si sovrapponevano tutti sulla stessa riga, e
   * sembrava un oggetto spesso invece che un oggetto aperto.
   *
   * Misurato: con l'opacità in questi fotogrammi le quattro cime stavano a
   * 1647/1647/1647/1647; togliendola, a 1553/1444/1332/1218.
   *
   * La dissolvenza d'ingresso non manca a nessuno: ogni pezzo del disegno ha
   * già la propria, dentro l'SVG, dove non fa danni. */
  @keyframes viz-piano-figura {
    from { transform: translateZ(-70px) rotateX(9deg); }
    to   { transform: translateZ(0) rotateX(0deg); }
  }
  @keyframes viz-piano-note {
    from { opacity: 0; transform: translateZ(-160px); }
    to   { opacity: 1; transform: translateZ(-34px); }
  }
  /* Arriva addosso a chi guarda e poi si posa: è l'unico piano che entra
     dal davanti, e serve a far capire che lo spazio ha due direzioni. */
  @keyframes viz-piano-hud {
    from { opacity: 0; transform: translateZ(210px); }
    to   { opacity: 1; transform: translateZ(72px); }
  }

  /* ── Gli strumenti che galleggiano ────────────────────────────────────
   * Stanno dentro ai margini della cornice di proposito: sporgendo verrebbero
   * tagliati dall'`overflow: hidden` che tiene insieme la finestra. */
  .viz-gettone {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md, 0.75rem);
    background: rgb(255 255 255 / 0.82);
    box-shadow: 0 10px 22px rgb(15 42 72 / 0.14);
    color: var(--color-navy);
    backdrop-filter: blur(6px);
  }

  .viz-gettone-icona {
    top: 1.1rem;
    left: 1.1rem;
    width: 2.25rem;
    height: 2.25rem;
  }

  .viz-gettone-indice {
    right: 1.1rem;
    bottom: 1.1rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
  }

  @media (hover: hover) {
  }

  /* `:global()` perché l'SVG lo scrive Piano.astro: l'attributo di scope di
     Astro non entra in un componente figlio, e questa regola non agganciava
     niente. */
  .viz :global(.viz-svg) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  /* ══════════════════════════════════════════════════════════════════════
     LA REGIA DELLE ANIMAZIONI
     ═══════════════════════════════════════════════════════════════════════

     Tutto quello che sta dentro ai disegni è marcato con `data-p` (il posto
     nella sequenza) e, se serve, con un secondo attributo che dice COME
     entrare. I disegni non contengono una riga di CSS: così aggiungerne uno
     nuovo è solo disegnare, e le cinque animazioni restano coerenti fra loro.

     `:global()` perché Astro non applica il proprio attributo di scope agli
     elementi SVG: la parte a sinistra (`.viz`) resta scopata, quindi le regole
     non escono da qui. */

  .viz :global([data-p]) {
    --ritardo: 0s;
    opacity: 0;
    animation: viz-entra 0.5s var(--ease-out-quart) var(--ritardo) both;
  }

  .viz :global([data-p="1"]) { --ritardo: 0.02s; }
  .viz :global([data-p="2"]) { --ritardo: 0.11s; }
  .viz :global([data-p="3"]) { --ritardo: 0.2s; }
  .viz :global([data-p="4"]) { --ritardo: 0.29s; }
  .viz :global([data-p="5"]) { --ritardo: 0.38s; }
  .viz :global([data-p="6"]) { --ritardo: 0.47s; }
  .viz :global([data-p="7"]) { --ritardo: 0.56s; }
  .viz :global([data-p="8"]) { --ritardo: 0.65s; }
  .viz :global([data-p="9"]) { --ritardo: 0.74s; }
  .viz :global([data-p="10"]) { --ritardo: 0.83s; }
  .viz :global([data-p="11"]) { --ritardo: 0.92s; }
  .viz :global([data-p="12"]) { --ritardo: 1.01s; }
  .viz :global([data-p="13"]) { --ritardo: 1.1s; }

  @keyframes viz-entra {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Le linee si disegnano invece di comparire: `pathLength="1"` normalizza la
     lunghezza del tracciato, così un solo valore di tratteggio vale per tutti
     i percorsi, corti o lunghi che siano. */
  .viz :global([data-traccia]) {
    stroke-dasharray: 1;
    animation: viz-traccia 0.8s var(--ease-out-quart) var(--ritardo) both;
  }

  @keyframes viz-traccia {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  /* Le colonne del grafico crescono da terra. `transform-box: fill-box` fa sì
     che l'origine sia il riquadro dell'elemento e non l'angolo dell'SVG. */
  .viz :global([data-cresce]) {
    transform-box: fill-box;
    transform-origin: bottom center;
    animation: viz-cresce 0.6s var(--ease-out-quart) var(--ritardo) both;
  }

  @keyframes viz-cresce {
    from {
      opacity: 0;
      transform: scaleY(0.05);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .viz :global([data-cresce-x]) {
    transform-box: fill-box;
    transform-origin: left center;
    animation: viz-cresce-x 1.5s var(--ease-out-quart) var(--ritardo) both;
  }

  @keyframes viz-cresce-x {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
    15% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .viz :global([data-scende]) {
    animation: viz-scende 0.65s var(--ease-out-quart) var(--ritardo) both;
  }

  @keyframes viz-scende {
    from {
      opacity: 0;
      transform: translateY(-26px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Il cursore che lampeggia: l'unica cosa che continua a muoversi. */
  .viz :global([data-lampeggia]) {
    animation:
      viz-entra 0.3s var(--ease-out-quart) var(--ritardo) both,
      viz-lampeggia 1.1s steps(1) 0.9s infinite;
  }

  @keyframes viz-lampeggia {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  /* Il contatore del carrello: tre cifre sovrapposte, ognuna accesa nella sua
     finestra di tempo. Un contatore che sale senza contare niente. */
  .viz :global(.v-conta-1) { animation: viz-conta-1 2.6s 0.7s both; }
  .viz :global(.v-conta-2) { animation: viz-conta-2 2.6s 0.7s both; }
  .viz :global(.v-conta-3) { animation: viz-conta-3 2.6s 0.7s both; }

  @keyframes viz-conta-1 {
    0%, 6% { opacity: 0; }
    8%, 38% { opacity: 1; }
    40%, 100% { opacity: 0; }
  }
  @keyframes viz-conta-2 {
    0%, 40% { opacity: 0; }
    42%, 70% { opacity: 1; }
    72%, 100% { opacity: 0; }
  }
  @keyframes viz-conta-3 {
    0%, 72% { opacity: 0; }
    74%, 100% { opacity: 1; }
  }

  /* Chi ha chiesto meno movimento vede il disegno già finito. */
  @media (prefers-reduced-motion: reduce) {
    /* La scena si appiattisce: niente rotazione, niente respiro, niente
       ingressi dalla profondità. I piani restano alle loro quote perché la
       sovrapposizione è il disegno, non l'effetto. Lo script non parte
       nemmeno: la condizione è scritta anche là. */
    .viz-orbita { animation: none; }
    /* La posa resta — è la forma della cosa, non un movimento: chi sceglie le
       tre dimensioni le vede, ferme. Sparisce solo ciò che si muove. */
    .viz-reticolo { animation: none; opacity: 1; transform: translateZ(-80px) scale(1.08); }
    .viz-pila { animation: none; opacity: 1; transform: none; }
    .viz :global(.pila-piano) { transition: none; }
    .viz-note { animation: none; opacity: 1; transform: translateZ(-34px); }
    .viz-hud { animation: none; opacity: 1; transform: translateZ(72px); }

    .testo > *,
    .viz :global([data-p]),
    .viz :global([data-traccia]),
    .viz :global([data-cresce]),
    .viz :global([data-cresce-x]),
    .viz :global([data-scende]),
    .viz :global([data-lampeggia]) {
      animation: none;
      opacity: 1;
      transform: none;
      stroke-dashoffset: 0;
    }
    .viz :global(.v-conta-1),
    .viz :global(.v-conta-2) {
      opacity: 0;
    }
    .viz :global(.v-conta-3) {
      animation: none;
      opacity: 1;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════
     I COLORI DEL DISEGNO
     Una sola tavolozza per tutti e cinque, così sembrano fatti dalla stessa

---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/*
 * LA FOTOGRAFIA DENTRO UNA FASCIA BLU È UN TAGLIO, NON UN RIQUADRO.
 *
 * Una foto messa in una cornice dentro una fascia piena sembra sempre
 * appiccicata: due rettangoli uno dentro l'altro, con un bordo a dividerli.
 * Qui la foto occupa la metà destra fino al bordo della finestra e si dissolve
 * verso sinistra con una maschera sfumata, così il blu e la fotografia
 * diventano la stessa superficie e il taglio non esiste come linea.
 *
 * Questo file nasce da tre copie della stessa ricetta — la testata delle
 * pagine interne, quella delle pagine indice e la fascia di chiusura — che
 * avevano preso strade diverse una modifica alla volta: maschere identiche
 * ricopiate a mano, larghezze 56% contro 58%, e il trattamento monocromo
 * arrivato solo in due su tre. Il difetto della maschera (vedi sotto) andava
 * corretto in tre punti, e correggerne due su tre è esattamente com'era
 * ridotto il sito. Ora la ricetta sta scritta una volta sola.
 *
 * Il contenitore che ospita questa componente deve essere `position:
 * relative` e `overflow: hidden` — lo sono già `.band-brand` e `.cta-band`.
 */
interface Props {
  src: ImageMetadata;
  /** Vuoto quando la foto è decorativa: la toglie dalla lettura assistita. */
  alt?: string;
  /** Da attivare sopra la piega: carica subito e con priorità. */
  eager?: boolean;
  /**
   * Sotto i 1024 px, dove non c'è spazio per due cose affiancate e la
   * dissolvenza mangerebbe metà soggetto:
   *   "flow"   — blocco normale a tutta larghezza, sotto al testo;
   *   "hidden" — sparisce, e il testo torna a occupare la fascia da solo.
   */
  mobile?: "flow" | "hidden";
  class?: string;
}

const {
  src,
  alt = "",
  eager = false,
  mobile = "flow",
  class: className = "",
} = Astro.props;
---

<div
  class:list={["band-foto", `is-${mobile}`, className]}
  aria-hidden={alt === "" ? "true" : undefined}
>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes={`(min-width: 1024px) 56vw, ${mobile === "hidden" ? "0px" : "100vw"}`}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
</div>

<style>
  /* ── Sotto i 1024 px ──────────────────────────────────────────────────── */
  .is-flow {
    margin: 0 auto;
    width: min(100%, 32rem);
    padding: 0 1.25rem 3rem;
  }
  .is-flow :global(img) {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .is-hidden {
    display: none;
  }

  /* ── Da 1024 px in su: il taglio ──────────────────────────────────────── */
  @media (min-width: 1024px) {
    .band-foto {
      display: block;
      position: absolute;
      inset: 0 0 0 auto;
      z-index: 0;
      width: 56%;
      margin: 0;
      padding: 0;
      pointer-events: none;
      opacity: 0.85;

      /* La maschera sta QUI, sul contenitore, e non sull'immagine.
         Sull'immagine mascherava solo la fotografia: il velo blu qui sotto
         restava un rettangolo pieno, e il suo bordo sinistro era una riga
         dritta in mezzo alla pagina. Sul contenitore, foto e velo si
         dissolvono insieme.

         Il numero che conta è l'ULTIMO stop, 76%. Il raggio orizzontale è il
         130% della larghezza del riquadro, quindi il bordo sinistro cade al
         100/130 = 77% del raggio: appena oltre il punto in cui la maschera è
         già a zero. Prima erano 155% di raggio con il trasparente al 100%, e
         il conto tornava male — sul bordo sinistro restava ancora un 25% di
         opacità, tagliato di netto dal bordo del riquadro. Quella era la riga
         verticale che si vedeva in pagina: non la foto che finisce, ma la
         sfumatura interrotta a metà. La dissolvenza deve finire DENTRO il
         riquadro, non sul suo bordo. */
      /* Scritta una volta in una variabile, come fa Globe con la sua: qui il
         gradiente era ripetuto identico per le due grafie della proprietà, e
         correggerne una sola sarebbe stato un difetto invisibile su Safari. */
      --maschera: radial-gradient(
        130% 190% at 100% 50%,
        #000 0%,
        #000 30%,
        rgb(0 0 0 / 0.45) 56%,
        rgb(0 0 0 / 0.12) 68%,
        transparent 76%
      );
      -webkit-mask-image: var(--maschera);
      mask-image: var(--maschera);
    }

    /* Il velo che tinge la fotografia del blu del marchio.
       Prima avevo provato `mix-blend-mode: luminosity`: sulla carta è la
       soluzione elegante, in pagina faceva sparire l'immagine — la fusione
       non regge bene insieme alla maschera. Un velo vero, sopra la foto e
       dentro la stessa maschera, fa lo stesso lavoro e si comporta sempre
       allo stesso modo.

       Con la foto desaturata sotto, il risultato è un'immagine monocroma nel
       blu del marchio: non è più una fotografia appoggiata sopra la fascia,
       è la fascia che prende rilievo. */
    .band-foto::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--gradient-brand);
      opacity: 0.38;
      pointer-events: none;
    }

    .band-foto :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center right;
      border-radius: 0;
      filter: grayscale(1) contrast(1.3) brightness(0.82);
    }
  }
</style>

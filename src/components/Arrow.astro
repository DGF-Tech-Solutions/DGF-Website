---
/*
 * Freccia disegnata, non il carattere "→".
 *
 * Due ragioni. La prima è tecnica: U+2192 non rientra nel sottoinsieme
 * `latin` dei font, quindi il browser lo pesca da un font di sistema —
 * spessore e allineamento cambiano da piattaforma a piattaforma.
 * La seconda è di disegno: a 11px il carattere si legge come un trattino,
 * mentre una linea con la punta resta chiara a qualsiasi dimensione ed è
 * più coerente con il linguaggio da disegno tecnico del sito.
 */
interface Props {
  /** Lunghezza del tratto. */
  size?: "sm" | "md";
  class?: string;
}
const { size = "md", class: className = "" } = Astro.props;

const w = size === "sm" ? 18 : 24;
---

<svg
  class:list={["arrow-mark", className]}
  width={w}
  height="9"
  viewBox={`0 0 ${w} 9`}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d={`M0 4.5h${w - 1.5}M${w - 5} 1l3.5 3.5L${w - 5} 8`}
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="square"
  />
</svg>

<style>
  .arrow-mark {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    transition: transform var(--dur) var(--ease-out-quart);
  }
  /* Avanza quando il contenitore è in hover: conferma che è un'azione. */
  @media (hover: hover) {
    :global(.group:hover) .arrow-mark,
    :global(.btn:hover) .arrow-mark {
      transform: translateX(4px);
    }
  }
</style>

---
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { SITE, NAV, NAV_CTA } from "@/data/site";
import { SERVICES } from "@/data/services";
import logo from "@/assets/logo-dgf.png";

/*
 * Barra di navigazione con mega-menu sui Servizi, ricalcato su quello
 * "Prodotto" di Nexia: colonna panoramica tinta a sinistra, griglia dei
 * servizi a destra, striscia di scorciatoie in fondo a tutta larghezza.
 *
 * IL BUG CHE RISOLVE. La prima versione era CSS puro (`:hover` sul
 * contenitore). Problema: fra la voce di menu e il pannello c'è uno stacco
 * visivo, e attraversandolo col mouse il `:hover` si perdeva → il pannello
 * si chiudeva mentre ci si stava andando.
 *
 * La soluzione è quella di Nexia: un RITARDO di 160 ms alla chiusura, che
 * copre il tragitto, più i gestori del mouse anche sul pannello. In più qui
 * il varco è coperto da un ponte invisibile, così nella maggior parte dei
 * casi il ritardo non serve nemmeno.
 *
 * Il pannello resta utilizzabile senza JavaScript: `:focus-within` lo apre
 * da tastiera, e se lo script non parte la voce "Servizi" è comunque un link
 * alla pagina indice.
 */

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");

const SERVICE_ICONS = ["globe", "bag", "phone", "dashboard", "sparkles"] as const;
---

<header class="site-nav">
  <div class="wrap flex h-14 items-center justify-between gap-4 lg:h-16">
    <a href="/" aria-label={`${SITE.name}, home`} class="shrink-0">
      <Image
        src={logo}
        alt={SITE.name}
        width={82}
        height={40}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="h-7 w-auto"
      />
    </a>

    <!-- ─── Navigazione desktop ─────────────────────────────────────────── -->
    <nav aria-label="Navigazione principale" class="hidden items-center gap-0.5 xl:flex">
      <div class="mega" data-mega>
        <a
          href="/servizi"
          class="nav-link"
          data-mega-trigger
          aria-expanded="false"
          aria-controls="mega-servizi"
          aria-current={isActive("/servizi") ? "page" : undefined}
        >
          Servizi
          <Icon name="chevron-down" size={14} class="mega-caret" />
        </a>

        <!-- Ponte invisibile: copre lo stacco fra voce e pannello, così il
             mouse non esce mai dall'area sensibile. -->
        <span class="mega-bridge" aria-hidden="true"></span>

        <div class="mega-panel" id="mega-servizi" data-mega-panel>
          <div class="mega-inner">
            <a href="/servizi" class="mega-lead group">
              <span>
                <span class="t-eyebrow">I servizi</span>
                <span class="mt-2 block text-[0.9375rem] font-extrabold text-[var(--color-ink)]">
                  Panoramica
                </span>
                <span class="mt-1.5 block text-[0.75rem] leading-relaxed text-[var(--color-ink-3)]">
                  Tutti e cinque in una pagina, con i criteri per capire quale ti
                  serve davvero.
                </span>
              </span>
              <span class="mt-5 inline-flex items-center gap-1.5 text-[0.75rem] font-bold text-[var(--color-navy)]">
                Vedi tutti i servizi
                <Icon name="arrow-right" size={14} class="mega-lead-arrow" />
              </span>
            </a>

            <div class="mega-grid">
              {
                SERVICES.map((s, i) => (
                  <a
                    href={`/servizi/${s.slug}`}
                    class="mega-item group"
                    aria-current={isActive(`/servizi/${s.slug}`) ? "page" : undefined}
                  >
                    <span class="icon-tile icon-tile-sm">
                      <Icon name={SERVICE_ICONS[i]} size={17} />
                    </span>
                    <span class="mega-item-title">{s.title}</span>
                    <span class="mega-item-desc">{s.summary}</span>
                  </a>
                ))
              }
            </div>
          </div>

          <div class="mega-foot">
            <span class="mega-fact">
              <Icon name="shield" size={14} /> Il progetto resta tuo
            </span>
            <span class="mega-fact">
              <Icon name="file" size={14} /> Preventivo scritto prima
            </span>
            <a href="/contatti" class="mega-cta">
              Parliamo del tuo progetto
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </div>

      {
        NAV.filter((l) => l.href !== "/servizi").map((link) => (
          <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center xl:flex">
      <a href={NAV_CTA.href} class="btn btn-primary !px-4 !py-2 !text-[0.8125rem]">
        {NAV_CTA.label}
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <!-- ─── Navigazione mobile ──────────────────────────────────────────── -->
    <details class="mobile xl:hidden">
      <summary aria-label="Apri il menu di navigazione">
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
      </summary>

      <nav aria-label="Navigazione principale" class="mobile-panel">
        <div class="wrap flex flex-col gap-1 py-2">
          {/*
            I cinque servizi stavano aperti in elenco: sei righe da 56px, cioè
            336px, il 68% dell'altezza utile di un iPhone SE consumata prima
            ancora di arrivare a Progetti, Blog e Chi siamo. Ecco perché
            "Contatti" finiva sotto la piega.

            Adesso sono un gruppo richiudibile: un details annidato, quindi
            apertura e chiusura le fa il browser e non serve una riga di
            JavaScript. Chiuso di default, ma GIÀ APERTO quando sei su una
            pagina di servizio — è l'unico momento in cui i fratelli servono
            davvero, e `isActive` si risolve a build time.
          */}
          <details class="mobile-group" open={isActive("/servizi")}>
            <summary class="mobile-summary">
              Servizi
              <Icon name="chevron-down" size={16} />
            </summary>

            <div class="mobile-group-body">
              {
                SERVICES.map((s, i) => (
                  <a
                    href={`/servizi/${s.slug}`}
                    class="mobile-service"
                    aria-current={isActive(`/servizi/${s.slug}`) ? "page" : undefined}
                  >
                    <span class="icon-tile icon-tile-sm">
                      <Icon name={SERVICE_ICONS[i]} size={17} />
                    </span>
                    <span class="font-semibold text-[var(--color-ink)]">{s.title}</span>
                  </a>
                ))
              }
              <a href="/servizi" class="mobile-service">
                <span class="icon-tile icon-tile-sm"><Icon name="layers" size={17} /></span>
                <span class="font-semibold text-[var(--color-navy)]">Tutti i servizi</span>
              </a>
            </div>
          </details>

          <hr class="my-2 h-px border-0 bg-[var(--color-line)]" />

          {
            NAV.filter((l) => l.href !== "/servizi").map((link) => (
              <a href={link.href} class="mobile-link" aria-current={isActive(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>

        {/*
          "Contatti" è l'azione principale del sito: non può stare sotto la
          piega del pannello. Sta fuori dalla colonna che scorre e si ancora in
          fondo con `position: sticky`.

          Sticky e non fixed: sticky OCCUPA il suo spazio nel flusso, quindi
          quando si è in fondo all'elenco non copre nulla, e non provoca
          spostamenti di layout — il CLS resta 0. Fuori da `.wrap` perché la
          barretta deve essere a tutta larghezza: se fosse dentro, il contenuto
          scorrerebbe visibile nei due margini laterali.
        */}
        <div class="mobile-cta">
          <div class="wrap">
            <a href={NAV_CTA.href} class="btn btn-primary w-full">
              {NAV_CTA.label}
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  /*
   * Barra fissa e OPACA.
   *
   * Prima era `sticky` con un fondo all'88% e una sfocatura dietro: il testo
   * della pagina si vedeva passare sotto le voci del menu, e nei punti densi
   * diventava illeggibile. Il fondo pieno è la versione che si legge sempre.
   *
   * `fixed` invece di `sticky` perché la barra deve poter galleggiare sopra
   * la prima sezione (vedi `.under-nav` in global.css): da sticky occuperebbe
   * comunque una riga sua, e sopra la fascia colorata resterebbe una striscia
   * bianca. Lo spazio glielo lascia `main`.
   */
  .site-nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }

  /*
   * La barra è opaca da subito, anche in cima alla pagina.
   *
   * Prima non lo era: un'animazione guidata dallo scorrimento faceva comparire
   * fondo e filetto solo dopo 5rem, così sopra la piega restavano logo e voci
   * appoggiati sulla sezione. Sembrava elegante, ma sulla hero chiara la barra
   * non si distingueva più dalla pagina — non si capiva che quello fosse il
   * menu. Con un fondo pieno si vede sempre dov'è, che è l'unica cosa che una
   * barra di navigazione deve fare.
   */


  /* Proporzioni prese da Nexia: 13px medium, spaziature strette. A 15px
     semigrassetto la barra sembrava il menu di un blog, non di un'azienda. */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4375rem 0.6875rem;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--color-ink-2);
    white-space: nowrap;
    transition: color var(--dur) var(--ease-out-quart);
  }
  @media (hover: hover) {
    .nav-link:hover { color: var(--color-ink); }
  }
  .nav-link[aria-current="page"] { color: var(--color-ink); font-weight: 600; }

  /* Sottolineatura sulla voce attiva, come su Nexia: due pixel di navy che
     segnano dove sei senza colorare tutta la voce. */
  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0.6875rem;
    bottom: -0.375rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-navy);
  }

  /* ─── Mega-menu ───────────────────────────────────────────────────── */
  .mega { position: static; }

  /* Ponte invisibile che copre lo stacco fra voce e pannello. */
  .mega-bridge {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% - 1px);
    height: 1rem;
    display: none;
  }
  .mega[data-open] .mega-bridge { display: block; }

  .mega-panel {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.625rem);
    transform: translateX(-50%) translateY(-8px);
    /* Pannello volutamente più compatto che largo: con cinque voci su una
       riga sola diventava una striscia da 960px, sproporzionata rispetto
       alla barra. Su quattro colonne il blocco è quasi quadrato, come su
       Nexia. */
    width: 47rem;
    max-width: calc(100vw - 2.5rem);
    background: var(--color-paper);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    outline: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 180ms var(--ease-out-quart),
      transform 180ms var(--ease-out-quart),
      visibility 0s linear 180ms;
  }

  /* Aperto: da script (data-open) oppure da tastiera (:focus-within), così
     il pannello resta usabile anche se lo script non parte. */
  .mega[data-open] .mega-panel,
  .mega:focus-within .mega-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
    transition-delay: 0s;
  }

  .mega-caret { transition: transform var(--dur) var(--ease-out-quart); }
  .mega[data-open] .mega-caret,
  .mega:focus-within .mega-caret { transform: rotate(180deg); }

  .mega-inner {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0.75rem;
    padding: 0.75rem;
  }

  .mega-lead {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-soft);
    transition: background-color var(--dur) var(--ease-out-quart);
  }
  @media (hover: hover) {
    /*
     * soft-3 e non soft-2: il passaggio a soft-2 valeva 1,14:1, meno di
     * quanto stacca un bordo capello.
     *
     * Con il fondo più deciso però il testo secondario scendeva a 3,98:1,
     * cioè sotto soglia PROPRIO NELLO STATO ATTIVO — il difetto che sfugge
     * sempre, perché nessuno misura i contrasti col mouse sopra. Si
     * ridefinisce il token invece di aggiungere una classe: il testo scende
     * di un gradino insieme al fondo e torna a 6,44:1. Come effetto
     * collaterale l'hover si legge meglio, perché a muoversi sono due cose
     * invece di una.
     */
    .mega-lead:hover {
      background: var(--color-soft-3);
      --color-ink-3: var(--color-ink-2);
    }
    .mega-lead:hover .mega-lead-arrow { transform: translateX(3px); }
  }
  .mega-lead-arrow { transition: transform var(--dur) var(--ease-out-quart); }

  /* Griglia dei servizi: quattro per riga, come gli otto moduli di Nexia.
     Con cinque voci la seconda riga ne ospita una: il blocco resta compatto
     invece di allungarsi in orizzontale. */
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.25rem;
    align-content: start;
  }

  .mega-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.875rem 0.75rem;
    border-radius: var(--radius-lg);
    transition: background-color var(--dur) var(--ease-out-quart);
  }
  @media (hover: hover) {
    .mega-item:hover { background: var(--color-paper-2); }
  }
  .mega-item[aria-current="page"] { background: var(--color-soft); }

  .mega-item-title {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .mega-item-desc {
    font-size: 0.6875rem;
    line-height: 1.45;
    color: var(--color-ink-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mega-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-paper-2);
  }
  .mega-fact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-3);
  }
  .mega-fact :global(svg) { color: var(--color-navy); }
  .mega-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-navy);
    transition: color var(--dur) var(--ease-out-quart);
  }
  @media (hover: hover) {
    .mega-cta:hover { color: var(--color-blue); }
  }

  /* ─── Mobile ──────────────────────────────────────────────────────── */
  /*
   * FIGLIO DIRETTO, non discendente.
   *
   * Era `.mobile summary`, cioè QUALUNQUE summary dentro il menu. Finché il
   * pannello conteneva solo link non si notava, ma dal momento in cui i
   * servizi diventano un details annidato quel selettore colpirebbe anche il
   * suo summary: 2,75rem quadrati, incolonnato e con -0.5rem di margine
   * destro. La voce "Servizi" diventerebbe un quadratino storto.
   *
   * Il `>` lo lega al solo panino, dove effettivamente serve.
   */
  .mobile > summary {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    cursor: pointer;
    list-style: none;
  }
  .mobile > summary::-webkit-details-marker { display: none; }

  .mobile .bar {
    display: block;
    width: 1.25rem;
    height: 2px;
    margin-inline: auto;
    border-radius: 2px;
    background: var(--color-ink);
    transition: transform var(--dur) var(--ease-out-quart);
  }
  .mobile[open] .bar:first-of-type { transform: translateY(3.5px) rotate(45deg); }
  .mobile[open] .bar:last-of-type { transform: translateY(-3.5px) rotate(-45deg); }

  .mobile-panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    /*
     * `svh` e non `dvh`, `--nav-h` e non 4rem.
     *
     * Due errori nella stessa riga. Il primo: 4rem è l'altezza della barra da
     * 1024px in su, ma il menu a panino si vede fino a 1280px e sotto i
     * 1024px la barra è alta 3,5rem — si sottraevano 8px inesistenti.
     * `--nav-h` è lo stesso token che usa `main`, quindi il conto torna a
     * tutte le larghezze invece che a una sola.
     *
     * Il secondo, più fastidioso: `dvh` cambia valore mentre le barre del
     * browser entrano ed escono, quindi il pannello si ridimensionava sotto
     * il dito durante lo scorrimento — e sotto di lui la barretta ancorata.
     * `svh` è il viewport con le barre VISIBILI, cioè il caso peggiore: un
     * numero solo, che non si muove mai.
     *
     * La riga `vh` sopra è il ripiego per i browser precedenti al 2022, dove
     * `svh` non esiste.
     */
    /*
     * ALTEZZA PIENA, non «al massimo».
     *
     * Con `max-height` il pannello si fermava dove finiva l'elenco: una
     * scatoletta bianca a metà schermo, con la pagina che continuava sotto e
     * il pulsante «Contatti» sospeso in mezzo al nulla. Un menu che si apre
     * su un telefono prende lo schermo: è una schermata, non una tendina.
     *
     * `height` fissa lo prende tutto, e la colonna qui sotto distribuisce:
     * l'elenco in alto, «Contatti» appoggiato al fondo dello schermo —
     * l'ultima cosa che si vede, a qualunque altezza di telefono.
     */
    height: calc(100vh - var(--nav-h));
    height: calc(100svh - var(--nav-h));
    display: flex;
    flex-direction: column;
    /* Lo scorrimento appartiene alla colonna dell'elenco, non al pannello:
       se restasse qui, scorrendo si porterebbe via anche «Contatti». */
    overflow: hidden;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    box-shadow: var(--shadow-lg);
  }

  /*
   * La colonna che scorre. `min-height: 0` non è pignoleria: un elemento
   * flessibile ha per impostazione `min-height: auto`, cioè «non rimpicciolire
   * sotto il tuo contenuto» — con quello l'elenco spingerebbe «Contatti» fuori
   * dallo schermo invece di scorrere al proprio interno, che è esattamente il
   * difetto da cui siamo partiti.
   */
  .mobile-panel > .wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    /* Arrivati in fondo all'elenco, lo scorrimento non prosegue sulla pagina
       sotto: il menu è un contesto chiuso finché è aperto. */
    overscroll-behavior: contain;
  }

  /*
   * Righe da 44px NETTI: 4 + piastrella `icon-tile-sm` 2,25rem (36) + 4.
   *
   * Erano 56 (10+36+10). Il taglio si ferma esattamente a 44 e non un pixel
   * sotto, perché 44x44 è il bersaglio minimo per il dito: comprimere
   * ulteriormente farebbe risparmiare pochi pixel e romperebbe l'unica cosa
   * che su telefono conta più della compattezza.
   */
  .mobile-service {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
  }
  /* Il servizio su cui sei già: stesso segno del mega-menu da desktop.
     Senza questa riga `aria-current` lo sentirebbe solo lo screen reader e
     il `border-radius` qui sopra non servirebbe a niente. */
  .mobile-service[aria-current="page"] { background: var(--color-soft); }

  /* 16px x 1,6 = 25,6 di riga + 10 + 10 = 45,6px: sopra i 44 richiesti.
     La voce "Servizi" usa le stesse misure delle altre, così l'elenco resta
     una colonna sola e non sembra che il gruppo sia di rango diverso. */
  .mobile-link,
  .mobile-summary {
    padding: 0.625rem 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .mobile-link[aria-current="page"] { color: var(--color-navy); }

  /* ─── Gruppo Servizi richiudibile ─────────────────────────────────── */
  .mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }
  .mobile-summary::-webkit-details-marker { display: none; }

  /*
   * Il chevron si punta DAL GENITORE, non con una classe sua.
   *
   * `<Icon>` non inoltra all'SVG l'attributo di scope che Astro mette sugli
   * elementi del template: una regola `.mobile-caret { … }` verrebbe
   * compilata in `.mobile-caret[data-astro-cid-…]` e non troverebbe mai
   * niente — CSS morto che sembra funzionare finché non si guarda il menu.
   * (È esattamente ciò che succede a `.mega-caret` qui sopra: da desktop la
   * freccetta non ruota, e nessuno se n'era accorto.)
   *
   * `.mega-fact :global(svg)` è il modo già usato in questo file e compila in
   * `.mega-fact[cid] svg`: il genitore porta lo scope, il figlio no.
   */
  .mobile-summary :global(svg) {
    flex: none;
    color: var(--color-ink-3);
    transition: transform var(--dur) var(--ease-out-quart);
  }
  .mobile-group[open] .mobile-summary :global(svg) { transform: rotate(180deg); }

  .mobile-group-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.25rem;
  }

  /*
   * La barretta di "Contatti".
   *
   * `sticky` + `bottom: 0` dentro `.mobile-panel`, che è il contenitore di
   * scorrimento: quando l'elenco è più alto del pannello la barretta si
   * ferma al bordo inferiore invece di scorrere via. Quando l'elenco ci sta
   * tutto, sta semplicemente in fondo — nessun caso particolare da gestire.
   *
   * Il fondo pieno e il filetto non sono decorazione: senza, le voci
   * passerebbero VISIBILI dietro al pulsante mentre si scorre.
   */
  .mobile-cta {
    position: sticky;
    bottom: 0;
    z-index: 1;
    padding-block: 0.625rem;
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-panel { animation: fade-rise 220ms var(--ease-out-quart) both; }
  }
</style>

<script>
  /*
   * Apertura/chiusura del mega-menu.
   *
   * Il punto delicato è la CHIUSURA RITARDATA (160 ms): senza, spostando il
   * mouse dalla voce verso il pannello si attraversa uno spazio in cui né
   * l'una né l'altro sono in hover, e il pannello sparisce sotto il cursore.
   * È esattamente il difetto che aveva la versione precedente.
   */
  const CLOSE_DELAY = 160;

  document.querySelectorAll<HTMLElement>("[data-mega]").forEach((mega) => {
    const trigger = mega.querySelector<HTMLElement>("[data-mega-trigger]");
    const panel = mega.querySelector<HTMLElement>("[data-mega-panel]");
    if (!trigger || !panel) return;

    let timer: number | undefined;

    const open = () => {
      window.clearTimeout(timer);
      mega.setAttribute("data-open", "");
      trigger.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      mega.removeAttribute("data-open");
      trigger.setAttribute("aria-expanded", "false");
    };
    const scheduleClose = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(close, CLOSE_DELAY);
    };

    // Il contenitore copre voce + ponte; il pannello ha i suoi gestori
    // perché, essendo posizionato in assoluto, esce dal flusso del genitore.
    mega.addEventListener("mouseenter", open);
    mega.addEventListener("mouseleave", scheduleClose);
    panel.addEventListener("mouseenter", open);
    panel.addEventListener("mouseleave", scheduleClose);

    // Tastiera: si apre al focus sulla voce, si chiude uscendo dal gruppo.
    trigger.addEventListener("focus", open);
    mega.addEventListener("focusout", (event) => {
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (!next || !mega.contains(next)) close();
    });

    // Esc chiude e riporta il focus sulla voce, così non si perde il segno.
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (!mega.hasAttribute("data-open")) return;
      close();
      trigger.focus();
    });

    // Click fuori: chiude.
    document.addEventListener("pointerdown", (event) => {
      if (!mega.contains(event.target as Node)) close();
    });
  });
</script>

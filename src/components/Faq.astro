---
/*
 * Domande frequenti — accordion senza una riga di JavaScript.
 *
 * <details>/<summary> danno gratis: apertura, chiusura, navigazione da
 * tastiera, annuncio corretto agli screen reader e funzionamento anche se
 * lo script fallisce. Riscriverlo in React sarebbe stato peggio sotto ogni
 * aspetto misurabile.
 *
 * Emette anche i dati strutturati FAQPage, che Google usa per i rich result.
 */
interface Props {
  items: { q: string; a: string }[];
  /** Emette il JSON-LD FAQPage. Una pagina sola per sito dovrebbe farlo. */
  schema?: boolean;
}

const { items, schema = false } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>
          <span class="t-h3 pr-6">{item.q}</span>
          <span class="faq-icon" aria-hidden="true" />
        </summary>
        <div class="faq-answer">
          <p class="t-body prose-measure">{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}

<style>
  .faq-item {
    border-top: 1px solid var(--color-hairline);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .faq-item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
    transition: color var(--dur) var(--ease-out-quart);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  @media (hover: hover) {
    .faq-item summary:hover { color: var(--color-navy); }
  }

  /* Icona "+" che diventa "−" all'apertura. Due pseudo-elementi, zero SVG. */
  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.375rem;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-blue);
  }
  .faq-icon::before { width: 100%; height: 1.5px; }
  .faq-icon::after {
    width: 1.5px;
    height: 100%;
    transition: transform var(--dur) var(--ease-out-quart);
  }
  .faq-item[open] .faq-icon::after { transform: scaleY(0); }

  .faq-answer {
    padding-bottom: 1.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item[open] .faq-answer {
      animation: fade-rise 300ms var(--ease-out-quart) both;
    }
  }
</style>

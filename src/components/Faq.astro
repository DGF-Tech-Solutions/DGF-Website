---
/*
 * Domande frequenti — accordion senza una riga di JavaScript.
 *
 * <details>/<summary> danno gratis apertura, chiusura, navigazione da
 * tastiera e annuncio corretto agli screen reader. Riscriverlo in React
 * sarebbe peggio sotto ogni aspetto misurabile.
 */
import Icon from "@/components/Icon.astro";

interface Props {
  items: { q: string; a: string }[];
  /** Emette il JSON-LD FAQPage (una sola pagina per sito dovrebbe farlo). */
  schema?: boolean;
}

const { items, schema = false } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<div class="space-y-3">
  {
    items.map((item) => (
      <details class="faq-item card">
        <summary>
          <span class="t-h3 pr-4">{item.q}</span>
          <span class="faq-icon">
            <Icon name="chevron-down" size={18} />
          </span>
        </summary>
        <div class="faq-answer">
          <p class="t-body">{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}

<style>
  .faq-item { overflow: hidden; }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 1.375rem;
    cursor: pointer;
    list-style: none;
    transition: color var(--dur) var(--ease-out-quart);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  @media (hover: hover) {
    .faq-item summary:hover { color: var(--color-navy); }
  }

  .faq-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-soft);
    color: var(--color-navy);
    transition: transform var(--dur) var(--ease-out-quart),
                background-color var(--dur) var(--ease-out-quart);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    background: var(--color-navy);
    color: #fff;
  }

  .faq-answer { padding: 0 1.375rem 1.375rem; }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item[open] .faq-answer {
      animation: fade-rise 260ms var(--ease-out-quart) both;
    }
  }
</style>

---
import Icon from "@/components/Icon.astro";

/*
 * Ricerca + filtri per gli elenchi (blog, servizi), sul modello degli
 * "explorer" di Nexia.
 *
 * Come funziona: gli elementi da filtrare stanno nello slot e portano due
 * attributi: `data-search` (testo in cui cercare, già in minuscolo) e
 * `data-cat` (le etichette sotto cui l'elemento ricade, separate da `|`).
 * Lo script nasconde e mostra, non ricostruisce niente: il contenuto è tutto
 * nell'HTML, quindi resta indicizzabile da Google e leggibile anche se lo
 * script non parte.
 *
 * Le etichette sono più d'una perché non ogni elenco si filtra per categoria:
 * un progetto ha una categoria sola ma tre o quattro servizi, e filtrare per
 * servizio è l'unica cosa che l'utente voglia davvero fare lì.
 *
 * Costo: poco più di un kB, ed è il prezzo giusto per una funzione che
 * l'utente usa davvero.
 */
interface Props {
  /** Testo dentro la barra di ricerca. */
  placeholder: string;
  /** Etichetta accessibile del campo. */
  label: string;
  /**
   * Categorie con il rispettivo conteggio. Se sono meno di due i chip non
   * compaiono: un filtro con una sola voce non filtra niente, occupa spazio
   * e confonde.
   */
  categories?: { label: string; count: number }[];
  /**
   * Numero mostrato sul chip "Tutti". Va passato quando un elemento ricade
   * sotto più etichette (i progetti, che hanno più servizi): lì la somma dei
   * conteggi è maggiore del numero di elementi e direbbe una cosa falsa.
   */
  total?: number;
  /** Parola per il messaggio di elenco vuoto ("articoli", "servizi"…). */
  noun: string;
}

const { placeholder, label, categories = [], total, noun } = Astro.props;
const allCount = total ?? categories.reduce((n, c) => n + c.count, 0);
const showChips = categories.length > 1;
---

<!--
  Impaginazione presa dall'explorer di Nexia (`guide-explorer.tsx`):
  barra a TUTTA LARGHEZZA del contenitore, chip allineati a sinistra sotto,
  conteggio a sinistra, griglia a tre colonne con gap 1.5rem.

  La versione precedente aveva barra e chip centrati e stretti a `max-w-2xl`:
  con le schede larghe sotto, il risultato erano due blocchi che non si
  allineavano a niente — ed è esattamente il difetto di margine segnalato.
-->
<div data-explorer>
  <!-- Barra di ricerca -->
  <div class="relative">
    <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[var(--color-ink-3)]">
      <Icon name="search" size={18} />
    </span>
    <input
      type="search"
      data-explorer-input
      placeholder={placeholder}
      aria-label={label}
      autocomplete="off"
      class="explorer-input"
    />
    <button type="button" data-explorer-clear class="explorer-clear" aria-label="Cancella ricerca" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Chip di categoria -->
  {
    showChips && (
      <div class="mt-5 flex flex-wrap gap-2">
        <button type="button" class="filter-chip" data-explorer-cat="" aria-pressed="true">
          Tutti <span class="filter-count">{allCount}</span>
        </button>
        {categories.map((c) => (
          <button type="button" class="filter-chip" data-explorer-cat={c.label} aria-pressed="false">
            {c.label} <span class="filter-count">{c.count}</span>
          </button>
        ))}
      </div>
    )
  }

  <!-- Elementi filtrabili -->
  <div class="mt-10" data-explorer-list>
    <slot />
  </div>

  <!-- Nessun risultato: riquadro tratteggiato, come su Nexia -->
  <div class="explorer-empty" data-explorer-empty hidden>
    <span class="explorer-empty-icon">
      <Icon name="search" size={22} />
    </span>
    <p class="explorer-empty-title">Nessun {noun} corrisponde ai filtri</p>
    <p class="explorer-empty-text">
      Prova con una parola diversa, oppure rimuovi i filtri attivi.
    </p>
    <button type="button" data-explorer-reset class="btn btn-primary mt-6">
      Azzera i filtri
    </button>
  </div>
</div>

<style>
  .explorer-input {
    width: 100%;
    padding: 0.875rem 2.75rem;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    outline: none;
    transition: border-color var(--dur) var(--ease-out-quart),
                box-shadow var(--dur) var(--ease-out-quart);
  }
  .explorer-input::placeholder { color: var(--color-ink-3); }
  .explorer-input:focus {
    border-color: color-mix(in srgb, var(--color-navy) 40%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-navy) 10%, transparent);
  }
  /* La "x" nativa di Safari/Chrome duplicherebbe il nostro pulsante. */
  .explorer-input::-webkit-search-cancel-button { display: none; }

  .explorer-clear {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink-3);
    cursor: pointer;
    transition: background-color var(--dur), color var(--dur);
  }
  @media (hover: hover) {
    .explorer-clear:hover { background: var(--color-soft); color: var(--color-navy); }
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink-3);
    cursor: pointer;
    transition: border-color var(--dur), color var(--dur),
                background-color var(--dur);
  }
  @media (hover: hover) {
    .filter-chip:hover {
      border-color: color-mix(in srgb, var(--color-navy) 30%, transparent);
      color: var(--color-navy);
    }
  }
  .filter-chip[aria-pressed="true"] {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }
  .filter-count { font-size: 0.6875rem; font-weight: 700; opacity: 0.55; }

  .explorer-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 2rem;
    padding: 4rem 1.5rem;
    text-align: center;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-xl);
    background: var(--color-paper-2);
  }
  .explorer-empty-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 1rem;
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    color: var(--color-ink-3);
    box-shadow: var(--shadow-sm);
  }
  .explorer-empty-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .explorer-empty-text {
    margin-top: 0.375rem;
    max-width: 24rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-3);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-explorer]").forEach((root) => {
    const input = root.querySelector<HTMLInputElement>("[data-explorer-input]");
    const clear = root.querySelector<HTMLButtonElement>("[data-explorer-clear]");
    const list = root.querySelector<HTMLElement>("[data-explorer-list]");
    const empty = root.querySelector<HTMLElement>("[data-explorer-empty]");
    const reset = root.querySelector<HTMLButtonElement>("[data-explorer-reset]");
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-explorer-cat]")];
    if (!input || !list || !empty) return;

    // Gli elementi filtrabili sono i figli dell'elenco che dichiarano
    // `data-search`; la griglia in mezzo non dà fastidio perché cerchiamo
    // in profondità.
    const items = [...list.querySelectorAll<HTMLElement>("[data-search]")];
    let query = "";
    let category = "";

    function apply() {
      let visible = 0;
      for (const el of items) {
        const haystack = el.dataset.search ?? "";
        const cats = (el.dataset.cat ?? "").split("|");
        const matches =
          (!query || haystack.includes(query)) &&
          (!category || cats.includes(category));
        el.hidden = !matches;
        if (matches) visible++;
      }
      empty!.hidden = visible > 0;
      clear!.hidden = query.length === 0;
    }

    input.addEventListener("input", () => {
      // Normalizza accenti e maiuscole: cercare "citta" trova "città".
      query = input.value
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "");
      apply();
    });

    clear?.addEventListener("click", () => {
      input.value = "";
      query = "";
      apply();
      input.focus();
    });

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        category = chip.dataset.explorerCat ?? "";
        for (const other of chips) {
          other.setAttribute("aria-pressed", String(other === chip));
        }
        apply();
      });
    }

    reset?.addEventListener("click", () => {
      input.value = "";
      query = "";
      category = "";
      for (const [i, chip] of chips.entries()) {
        chip.setAttribute("aria-pressed", String(i === 0));
      }
      apply();
    });
  });
</script>

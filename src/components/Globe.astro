---
/*
 * Globo terrestre che ruota — senza una riga di JavaScript.
 *
 * ─────────────────────────────────────────────────────────────────────────
 * LA STORIA
 *
 * Il vecchio sito aveva questo globo e piaceva, ma rallentava: React
 * ricalcolava la proiezione della mappa e ridisegnava un migliaio di nodi SVG
 * a ogni fotogramma, sessanta volte al secondo, sul thread principale.
 *
 * Qui il conto è già stato fatto: `scripts/gen-globo.mjs` ha tagliato il
 * planisfero in 51 strisce orizzontali e ha calcolato per ognuna quanto la
 * sfera la comprime. A runtime resta una sola cosa da fare — far scorrere le
 * strisce in orizzontale, tutte insieme, con la stessa animazione — e quella
 * la fa il compositore della GPU. Il thread principale non viene mai svegliato:
 * nessun ricalcolo, nessun ridisegno, nessun fotogramma perso, anche mentre si
 * scorre la pagina.
 *
 * Perché le strisce bastano: una sfera vista da lontano comprime la mappa in
 * orizzontale di cos φ e la schiaccia in verticale verso i poli. Sono due
 * deformazioni che dipendono solo dalla latitudine, cioè dalla riga dello
 * schermo, non da quanto il globo ha girato. Restano quindi vere per sempre e
 * si possono cuocere nel documento. La spiegazione lunga è nel generatore.
 *
 * ─────────────────────────────────────────────────────────────────────────
 * COSTO
 *
 * 0 kB di JavaScript. Nessuna immagine da scaricare: il disegno è SVG dentro
 * l'HTML — e sta dopo il titolo nel documento, quindi non gli contende l'LCP.
 * Le geometrie di ogni striscia sono definite una volta sola in `<defs>` e
 * richiamate con `<use>`, così una copia in più della mappa non pesa nulla.
 *
 * NOTA: le definizioni hanno id fissi (`gb0`, `gb1`, …). Il componente è
 * pensato per comparire una volta sola nella pagina; due istanze
 * duplicherebbero gli id.
 */

import globo from "@/data/globo.json";

interface Props {
  /** Classi aggiuntive sul contenitore. */
  class?: string;
}
const { class: className = "" } = Astro.props;

const { bands, messina, stripWidth, spinShift, delayFraction, viewWidth } = globo;

/*
 * ── Come si muove ────────────────────────────────────────────────────────
 *
 * "pendolo": il globo ruota avanti e indietro attorno all'Italia. Messina non
 *   esce mai dall'inquadratura e resta sempre al posto giusto sulla mappa.
 * "giro": rotazione vera, 360°. Più fedele al pianeta, ma per due terzi del
 *   tempo la Sicilia è dietro al globo e sparisce — come nella realtà.
 *
 * Si cambia scrivendo l'altra parola in `MOTO`, più sotto: durata, estremi,
 * ritardo, verso e numero di copie della mappa si adeguano da soli.
 */

/** Quanto si sposta l'oscillazione, in gradi di longitudine per lato. Sotto i
 *  57° (metà finestra visibile) Messina non arriva mai al bordo. */
const SWING = 34;

/** Posizione del nastro con Messina esattamente al centro del disco. */
const REST = -(spinShift * (1 - delayFraction)).toFixed(2);

/** Un grado di longitudine, in percentuale della larghezza del nastro. */
const PER_DEGREE = 100 / viewWidth;

/** Dove ricomincia la mappa: 360° sui `viewWidth` gradi del nastro. */
const REPEAT = (360 / viewWidth) * 100;

const MOTI = {
  /*
   * I due estremi sono simmetrici attorno a Messina, e il ritardo negativo di
   * mezzo ciclo fa partire l'animazione dal centro: chi apre la pagina trova
   * Messina lì. `alternate` fa il ritorno senza scriverlo, `ease-in-out`
   * rallenta le inversioni — un pendolo a velocità fissa sbatterebbe contro i
   * due estremi. Una copia sola della mappa: il nastro non si sposta mai
   * abbastanza da scoprire la seconda.
   */
  pendolo: {
    period: 80,
    from: `${(REST - SWING * PER_DEGREE).toFixed(3)}%`,
    to: `${(REST + SWING * PER_DEGREE).toFixed(3)}%`,
    delay: -40,
    direction: "alternate",
    easing: "ease-in-out",
    copies: [0],
  },
  /*
   * Una corsa sola che si richiude su sé stessa: si scorre esattamente una
   * mappa, quindi la fine coincide con l'inizio. Qui la seconda copia serve —
   * è quella che rientra da sinistra mentre la prima esce da destra. Il
   * ritardo mette Messina al centro al primo fotogramma.
   */
  giro: {
    period: 120,
    from: `${-spinShift}%`,
    to: "0%",
    delay: -(delayFraction * 120).toFixed(2),
    direction: "normal",
    easing: "linear",
    copies: [0, REPEAT],
  },
} as const;

const MOTO: keyof typeof MOTI = "giro";
const { period, from: from_, to, delay, direction, easing, copies } = MOTI[MOTO];

/*
 * I quattro tratti del disegno, dal più leggero al più marcato.
 *
 * Sono attributi di presentazione sul path e non regole CSS per un motivo
 * preciso: `<use>` clona l'elemento in uno shadow tree, e i selettori del
 * foglio di stile là dentro non arrivano. Con il CSS le copie perderebbero
 * `fill:none` e il colore — cioè comparirebbero come macchie nere piene
 * (verificato). Gli attributi, invece, viaggiano con il nodo clonato.
 */
const STROKES = {
  /** La rete fra i nodi: la trama di fondo. */
  mesh: { class: "gb-maglia", stroke: "#7fb2d2", width: 0.7, opacity: 0.45 },
  /** Le direttrici che partono da Messina. */
  links: { class: "gb-linea", stroke: "#1575a4", width: 0.85, opacity: 0.34 },
  /** Le coste: l'unica linea che deve leggersi come disegno. Il tratto è più
   *  spesso di un pixel perché il globo è grande il doppio del vecchio: alla
   *  stessa misura la costa si sfilaccerebbe. */
  coast: { class: "gb-costa", stroke: "#93bfdb", width: 1.15, opacity: 1 },
  /** I nodi: tratti di lunghezza zero con la punta tonda. */
  dots: { class: "gb-nodo", stroke: "#5b9fc9", width: 2.8, opacity: 0.75 },
} as const;

const LAYERS = ["mesh", "links", "coast", "dots"] as const;

/*
 * ── Le scritte sulla mappa ───────────────────────────────────────────────
 *
 * Nessuna scritta può stare dentro le strisce: là dentro verrebbe stirata
 * insieme alla mappa, e vicino ai poli diventerebbe illeggibile. Ognuna ha
 * quindi un nastro suo, largo come il parallelo della sua latitudine, che
 * scorre con la stessa identica animazione — così la scritta resta incollata
 * al suo pezzo di mondo mentre il globo gira.
 *
 * Sono i continenti e non i singoli paesi: a questa dimensione una ventina di
 * nomi di stato diventerebbe rumore sopra al titolo, e la mappa è un fondale,
 * non un atlante. Le coordinate sono il punto dove il nome sta bene, non il
 * centroide geografico.
 */
const LUOGHI = [
  { nome: "Europa", lat: 46, lon: 27, tipo: "terra" },
  { nome: "Africa", lat: 3, lon: 21, tipo: "terra" },
  { nome: "Asia", lat: 47, lon: 95, tipo: "terra" },
  { nome: "Oceania", lat: -25, lon: 134, tipo: "terra" },
  { nome: "Nord America", lat: 47, lon: -101, tipo: "terra" },
  { nome: "Sud America", lat: -13, lon: -60, tipo: "terra" },

  /* Gli oceani servono anche a un'altra cosa: in un giro completo c'è un
     tratto in cui davanti c'è solo Pacifico, e senza una scritta il disco
     resterebbe vuoto per una ventina di secondi. */
  { nome: "Oceano Pacifico", lat: 2, lon: -152, tipo: "acqua" },
  { nome: "Oceano Atlantico", lat: 8, lon: -32, tipo: "acqua" },
  { nome: "Oceano Indiano", lat: -28, lon: 80, tipo: "acqua" },

  /*
   * Le città sono riferimenti geografici, non sedi: perciò puntino minuscolo
   * e scritta tenue, mentre Messina ha il cerchio che pulsa e l'etichetta in
   * navy. La differenza deve essere evidente in un colpo d'occhio, altrimenti
   * la mappa suggerirebbe una presenza internazionale che non c'è.
   *
   * Scelte a mano perché non si accavallino a questa scala (8 px per grado):
   * niente Parigi accanto a Londra, niente Roma addosso a Messina.
   */
  { nome: "Londra", lat: 51.5, lon: -0.13, tipo: "citta" },
  { nome: "Berlino", lat: 52.5, lon: 13.4, tipo: "citta" },
  { nome: "Madrid", lat: 40.4, lon: -3.7, tipo: "citta" },
  { nome: "Il Cairo", lat: 30, lon: 31.2, tipo: "citta" },
  { nome: "Lagos", lat: 6.5, lon: 3.4, tipo: "citta" },
  { nome: "Città del Capo", lat: -33.9, lon: 18.4, tipo: "citta" },
  { nome: "Dubai", lat: 25.2, lon: 55.3, tipo: "citta" },
  { nome: "Mumbai", lat: 19.1, lon: 72.9, tipo: "citta" },
  { nome: "Pechino", lat: 39.9, lon: 116.4, tipo: "citta" },
  { nome: "Tokyo", lat: 35.7, lon: 139.7, tipo: "citta" },
  { nome: "Singapore", lat: 1.35, lon: 103.8, tipo: "citta" },
  { nome: "Sydney", lat: -33.9, lon: 151.2, tipo: "citta" },
  { nome: "New York", lat: 40.7, lon: -74, tipo: "citta" },
  { nome: "Città del Messico", lat: 19.4, lon: -99.1, tipo: "citta" },
  { nome: "San Paolo", lat: -23.5, lon: -46.6, tipo: "citta" },
  { nome: "Buenos Aires", lat: -34.6, lon: -58.4, tipo: "citta" },
] as const;

/**
 * Dalla coppia (latitudine, longitudine) alla posizione sul disco.
 *
 * `top` è la proiezione ortografica vera — la latitudine φ cade all'altezza
 * `sin φ`, non a φ. `w` è la larghezza del parallelo, cioè quanto va stretto
 * il nastro perché il punto scorra alla velocità giusta per la sua latitudine.
 */
function collocaSulGlobo(lat: number, lon: number) {
  const rad = (lat * Math.PI) / 180;
  const w = Math.cos(rad);
  return {
    top: (((1 - Math.sin(rad)) / 2) * 100).toFixed(2),
    larghezza: (w * 100).toFixed(2),
    sinistra: ((1 - w) * 50).toFixed(2),
    x: ((lon + 180) / viewWidth) * 100,
  };
}

const ETICHETTE = LUOGHI.map((l) => ({ ...l, ...collocaSulGlobo(l.lat, l.lon) }));
---

<div
  class:list={["globo", className]}
  aria-hidden="true"
  style={`--periodo:${period}s;--ritardo:${delay}s;--da:${from_};--a:${to};--fermo:${REST}%;--verso:${direction};--curva:${easing};--nastro:${stripWidth}%`}
>
  {/* Le geometrie, definite una volta. Non si disegna: serve solo da magazzino. */}
  <svg class="globo-defs" width="0" height="0" aria-hidden="true">
    <defs>
      {
        bands.map((b, i) => (
          <g id={`gb${i}`}>
            {
              LAYERS.filter((layer) => b[layer]).map((layer) => (
                <path
                  class={STROKES[layer].class}
                  d={b[layer]}
                  fill="none"
                  stroke={STROKES[layer].stroke}
                  stroke-width={STROKES[layer].width}
                  stroke-opacity={STROKES[layer].opacity}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  vector-effect="non-scaling-stroke"
                ></path>
              ))
            }
          </g>
        ))
      }
    </defs>
  </svg>

  <div class="globo-disco">
    {
      bands.map((b, i) => (
        <div
          class="gb-fascia"
          style={`top:${b.top}%;height:${b.h}%;width:${(b.w * 100).toFixed(2)}%;left:${((1 - b.w) * 50).toFixed(2)}%`}
        >
          <svg
            class="gb-nastro"
            viewBox={`0 ${b.y} ${viewWidth} ${b.dy}`}
            preserveAspectRatio="none"
          >
            {/* Chiusura esplicita: dentro un `<svg>` un tag lasciato aperto
                non viene chiuso dal parser HTML, e la seconda copia finirebbe
                annidata nella prima invece che accanto. */}
            {copies.map((_, copy) => (
              <use href={`#gb${i}`} x={copy * 360}></use>
            ))}
          </svg>
        </div>
      ))
    }

    {/*
      Messina sta fuori dalle strisce: là dentro verrebbe stirata insieme alla
      mappa, etichetta compresa. Ha un nastro suo, largo come il parallelo a
      38° N, che scorre con la stessa identica animazione — quindi il puntino
      resta incollato alla Sicilia mentre il globo gira. Le due copie sono la
      stessa cosa delle due `<use>`: quando una esce da destra, l'altra sta già
      rientrando da sinistra.
    */}
    <div
      class="gb-messina"
      style={`top:${messina.top}%;width:${(messina.w * 100).toFixed(2)}%;left:${((1 - messina.w) * 50).toFixed(2)}%`}
    >
      <div class="gb-nastro gb-messina-nastro">
        {copies.map((offset) => (
          <span class="gb-pin" style={`left:${(messina.x + offset).toFixed(2)}%`}>
            <span class="gb-onda"></span>
            <span class="gb-onda gb-onda-2"></span>
            <span class="gb-punto"></span>
            <span class="gb-targa">Messina</span>
          </span>
        ))}
      </div>
    </div>

    {/* I nomi sulla mappa: stesso meccanismo del puntino di Messina. */}
    {
      ETICHETTE.map((e) => (
        <div
          class="gb-luogo"
          style={`top:${e.top}%;width:${e.larghezza}%;left:${e.sinistra}%`}
        >
          <div class="gb-nastro gb-luogo-nastro">
            {copies.map((offset) => (
              <span
                class:list={[
                  "gb-nome",
                  { "gb-nome-acqua": e.tipo === "acqua", "gb-nome-citta": e.tipo === "citta" },
                ]}
                style={`left:${(e.x + offset).toFixed(2)}%`}
              >
                {e.nome}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  {/* Atmosfera: il bordo che si spegne, la luce in alto a sinistra, l'alone. */}
  <div class="globo-luce"></div>
</div>

<style>
  .globo {
    /* Quadrato esatto: il disco non può decidere la sua altezza da solo,
       altrimenti la pagina si ricompone mentre carica. */
    aspect-ratio: 1;
    width: 100%;
    position: relative;
    /* Isola il disegno dal resto della pagina: quello che si muove qui dentro
       non fa ricalcolare nulla là fuori. */
    contain: layout paint style;
  }

  .globo-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .globo-disco {
    position: absolute;
    inset: 0;
    /* Il ritaglio circolare è ciò che trasforma delle strisce in un pianeta:
       le strisce sbordano di proposito e il cerchio le taglia sul profilo. */
    border-radius: 50%;
    overflow: hidden;
    /*
     * Due dissolvenze, moltiplicate una per l'altra.
     *
     * La prima spegne il bordo del disco: la sfera acquista aria, e sul bordo
     * radente sparisce l'unico punto in cui l'approssimazione a strisce si
     * potrebbe notare (là la mappa vera rallenterebbe fino a fermarsi, qui no).
     *
     * La seconda spegne il fondo, e serve solo a chi mette il globo più
     * grande del suo contenitore: senza, si vedrebbe il taglio netto
     * dell'`overflow` proprio a cavallo di un cambio di sfondo. Chi non ne ha
     * bisogno la lascia com'è (100%: nessuna dissolvenza) — su mobile, dove il
     * globo ci sta tutto, sfumarlo lo farebbe sembrare storto.
     *
     * Sono maschere e non veli bianchi: funzionano su qualunque sfondo.
     *
     * I due valori predefiniti stanno nel `var(…, 100%)` e NON in una coppia
     * di dichiarazioni qui sopra, come erano prima. Una custom property
     * dichiarata sull'elemento che poi la consuma batte sempre quella che
     * arriva per eredità: `--gb-fondo-da: 100%` scritta su `.globo-disco`
     * rendeva muto il valore che la pagina metteva sull'antenato, e la
     * dissolvenza del fondo non si è mai accesa — né qui né su mobile. Il
     * modo giusto di dare un valore predefinito a una variabile che gli
     * antenati devono poter cambiare è la ricaduta di `var()`.
     */
    --gb-maschera:
      radial-gradient(
        closest-side circle at 50% 50%,
        #000 0%,
        #000 58%,
        rgb(0 0 0 / 0.55) 82%,
        rgb(0 0 0 / 0) 99%
      ),
      linear-gradient(
        to bottom,
        #000 0%,
        #000 var(--gb-fondo-da, 100%),
        rgb(0 0 0 / 0) var(--gb-fondo-a, 100%)
      );

    -webkit-mask-image: var(--gb-maschera);
    -webkit-mask-composite: source-in;
    mask-image: var(--gb-maschera);
    mask-composite: intersect;
  }

  .gb-fascia {
    position: absolute;
    overflow: hidden;
  }

  /* ── Il movimento ───────────────────────────────────────────────────────
   *
   * Una sola dichiarazione, condivisa da tutte le strisce e dal puntino di
   * Messina: essendo identica (stessa durata, stesso ritardo, stessa curva),
   * i livelli restano allineati al millesimo per sempre — il puntino non può
   * scollarsi dalla Sicilia nemmeno di un pixel.
   *
   * Gli estremi arrivano dal frontmatter, perché dipendono da come si è
   * deciso di far muovere il globo (oscillazione o giro completo). */
  .gb-nastro {
    position: absolute;
    inset: 0 auto 0 0;
    height: 100%;
    width: var(--nastro);
    /* Il reset globale dà `max-width:100%` a ogni `<svg>`: qui va tolto, o il
       nastro viene schiacciato dentro la striscia e nel disco finisce il
       mondo intero invece dei 114° che deve mostrare. */
    max-width: none;
    animation: gb-giro var(--periodo) var(--curva) var(--ritardo) infinite var(--verso);
  }

  @keyframes gb-giro {
    from {
      transform: translate3d(var(--da), 0, 0);
    }
    to {
      transform: translate3d(var(--a), 0, 0);
    }
  }

  /* I colori dei tratti stanno negli attributi dei path (vedi il commento in
     testa al file): qui resterebbero fuori dalle copie di `<use>`. */

  /* ── Messina ────────────────────────────────────────────────────────── */

  .gb-messina,
  .gb-luogo {
    position: absolute;
    height: 0;
  }

  /* Dove i nomi non si vedono, i loro nastri non devono nemmeno esistere:
     restavano 25 elementi da impaginare e 25 animazioni da far girare per
     del testo nascosto — 50 ms di lavoro in più all'apertura, su mobile. */
  .gb-luogo {
    display: none;
  }

  @media (min-width: 1024px) {
    .gb-luogo {
      display: block;
    }
  }

  .gb-messina-nastro,
  .gb-luogo-nastro {
    height: 0;
  }

  /* ── I nomi dei continenti ───────────────────────────────────────────────
   *
   * Volutamente più deboli dell'etichetta di Messina: sono riferimenti, non
   * informazione. Chi legge deve riconoscere il continente con la coda
   * dell'occhio, e vedere una cosa sola quando guarda davvero — Messina.
   *
   * Non serve nasconderle quando passano dietro al globo: la dissolvenza del
   * bordo del disco le spegne mentre si avvicinano al profilo, che è
   * esattamente ciò che fa una scritta su una sfera che ruota. */
  .gb-nome {
    position: absolute;
    top: 0;
    display: none;
    translate: -50% -50%;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #4a7fa0;
    opacity: 0.5;
  }

  /* L'acqua sta un gradino sotto la terra, come su ogni carta. */
  .gb-nome-acqua {
    letter-spacing: 0.36em;
    color: #6c9cbb;
    opacity: 0.38;
  }

  /*
   * Le città: il nome non è centrato sul punto ma appoggiato accanto, con un
   * puntino piccolissimo che segna il posto — la convenzione di qualunque
   * carta. Restano volutamente sottotono: sulla mappa deve saltare all'occhio
   * una sola città.
   */
  .gb-nome-citta {
    translate: 0 -50%;
    padding-left: 0.5rem;
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    color: #5c8caa;
    opacity: 0.62;
  }

  .gb-nome-citta::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.1875rem;
    height: 0.1875rem;
    border-radius: 50%;
    background: currentColor;
    translate: -50% -50%;
  }

  /* I nomi compaiono solo nel layout a due colonne: sotto i 1024 px il globo
     fa da fondale al testo, e una mappa annotata dietro alle parole è solo
     rumore. */
  @media (min-width: 1024px) {
    .gb-nome {
      display: block;
    }
  }

  .gb-pin {
    position: absolute;
    top: 0;
    display: block;
    width: 0;
    height: 0;
  }

  .gb-punto,
  .gb-onda {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50%;
    translate: -50% -50%;
  }

  /* Piccolo di proposito: alla dimensione del globo la Sicilia è larga una
     trentina di pixel, e un segnaposto generoso se la mangiava tutta. */
  .gb-punto {
    width: 0.375rem;
    height: 0.375rem;
    background: var(--color-navy);
    box-shadow: 0 0 0 0.15rem rgb(255 255 255 / 0.72);
  }

  .gb-onda {
    width: 0.375rem;
    height: 0.375rem;
    border: 1px solid var(--color-cyan);
    animation: gb-onda 3.6s linear infinite;
  }

  .gb-onda-2 {
    animation-delay: -1.8s;
  }

  /*
   * L'onda si spegne presto, a metà corsa.
   *
   * `transform: scale()` ingrandisce anche il bordo: a fine corsa quel filo da
   * un pixel diventa spesso quattro, e il cerchio si legge come un dischetto
   * pieno appoggiato esattamente sulla Sicilia — cioè copre l'unica cosa che
   * deve restare leggibile. Spegnendola prima, si vede il cerchio finché è
   * sottile e sparisce quando ingrossa.
   */
  @keyframes gb-onda {
    from {
      transform: scale(0.8);
      opacity: 0.7;
    }
    55% {
      opacity: 0.12;
    }
    to {
      transform: scale(4);
      opacity: 0;
    }
  }

  /* L'etichetta: la sola scritta del disegno, quindi in monospazio e spaziata,
     come le altre didascalie tecniche del sito.

     Sotto i 640 px sparisce: la scritta ha una misura fissa mentre il globo
     rimpicciolisce, e all'estremo dell'oscillazione finirebbe tagliata a metà
     dal bordo del disco. Il puntino che pulsa dice già la stessa cosa. */
  .gb-targa {
    display: none;

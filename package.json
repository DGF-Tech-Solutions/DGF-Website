{
  "name": "dgf-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sito vetrina di DGF Tech Solutions — Astro, export statico su GitHub Pages",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && docker compose up -d --wait preview && echo Anteprima pronta su http://localhost:7000",
    "preview:stop": "docker compose down",
    "verifica": "docker compose --profile verifica up --build --abort-on-container-exit verifica",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "lenis": "^1.3.26",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
